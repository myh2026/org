// ============================================================================
// org/registry/manifest.hsl — 专家库：manifest schema + 磁盘注册表 + 检索
// ============================================================================
// 库是磁盘上的资产层（不占运行时资源）：工作区 registry/ 目录即 git 注册表。
// 检索 = 能力标签交集 + 语义适配（描述相似度）—— B 路径的判定依据。
// 每个专家条目六字段：interface / capabilities / eval / version / stats / provenance。
// ============================================================================

import { ENVELOPE_SIGNATURE } from "../contracts/contract.hsl";
import { ExpertError } from "../types/errors.hsl";

/// JSON 字符串字面量转义（序列化卫生：description/trigger 等来自真实模型的
/// 文本含引号/反斜杠/换行时不再损坏注册表 JSON——静默损坏 = 注册表视为空的
/// 高危路径，parse 侧 JSON.parse 失败会让整个库“消失”）。
export fn json_escape(s: String) -> String {
    let out = native typescript {
        return s
            .replace(/\\/g, "\\\\")
            .replace(/"/g, "\\\"")
            .replace(/\n/g, "\\n")
            .replace(/\r/g, "\\r")
            .replace(/\t/g, "\\t");
    };
    out
}

/// 分词（语义粗排的词面单元）：空格词 + CJK 二元滑窗。
/// 中文任务目标无空格，纯 split(" ") 会把整句当单 token —— 词面重合几乎
/// 永远为 0（D 暖移交对中文失效的结构性原因）。二元组是保守补偿：不引入
/// 分词器依赖，重合信号从“不可能”恢复到“可用”。
export fn goal_words(goal: String) -> Vec<String> {
    let out: Vec<String> = native typescript {
        // 注意：native 块按纯 JS 解析（类型注解会报 Unexpected token ':'）
        const words = goal.split(/\s+/).filter((w) => w.length >= 2);
        const bigrams = [];
        for (let i = 0; i + 1 < goal.length; i++) {
            const a = goal.charCodeAt(i);
            const b = goal.charCodeAt(i + 1);
            if (a >= 0x4e00 && a <= 0x9fff && b >= 0x4e00 && b <= 0x9fff) bigrams.push(goal.slice(i, i + 2));
        }
        return [...words, ...bigrams];
    };
    out
}

/// D 路径词面单元：空格词 + CJK 三元滑窗（3 字连续子串）。
/// 暖移交是闸门判定（非粗排），信号强度必须与整词匹配等价 —— 二元组会
/// 被“记录”这类 2 字杂散重合误触发（实测：validate 子任务被误移交
/// notice-parser，工厂从未启动）。三元组 = 3 字连续子串重合，误触率骤降。
export fn duty_words(goal: String) -> Vec<String> {
    let out: Vec<String> = native typescript {
        const words = goal.split(/\s+/).filter((w) => w.length >= 2);
        const trigrams = [];
        for (let i = 0; i + 2 < goal.length; i++) {
            const a = goal.charCodeAt(i);
            const b = goal.charCodeAt(i + 1);
            const c = goal.charCodeAt(i + 2);
            if (a >= 0x4e00 && a <= 0x9fff && b >= 0x4e00 && b <= 0x9fff && c >= 0x4e00 && c <= 0x9fff) {
                trigrams.push(goal.slice(i, i + 3));
            }
        }
        return [...words, ...trigrams];
    };
    out
}

/// 补丁记录（provenance：每次变更的触发原因 = 对应哪次审查反馈）。
#[derive(Debug, Clone)]
export struct PatchRecord {
    from_version: String,
    to_version: String,
    /// 变更类型：knowledge（静态资源）/ flow（graph 拓扑）/ capability（注解）。
    change_kind: String,
    /// 触发原因：对应哪次审查意见（复发键）。
    trigger: String,
    /// 合入闸门：check+smoke / full-fixture / audit-only。
    gate: String,
}

/// 专家 manifest（注册表条目；磁盘形态为 registry/<name>.json）。
#[derive(Debug, Clone)]
export struct ExpertManifest {
    name: String,
    /// 语义版本（蓝绿发布：补丁合入即 bump）。
    version: String,
    /// 绑定的 BNF 版本（语言演进的漂移检测）。
    bnf: String,
    /// 职责描述（语义检索的语料）。
    description: String,
    /// 能力标签（与 #[capability] 及子任务 skills 对齐）。
    capabilities: Vec<String>,
    /// 信封签名（interface 字段；工厂产物必须与常量同构）。
    signature: String,
    /// 生成来源：factory / manual / import。
    source: String,
    /// fixture 验收记录（评测分 0..1；补丁合入不得回退）。
    eval_score: f64,
    /// 验收套件路径（相对工作区）。
    fixture_path: String,
    /// 专家源码路径（相对工作区；minted 专家的执行入口）。
    entry_path: String,
    /// 使用次数。
    uses: u32,
    /// 裁决通过率（行为证据 → 评分卡归因原料）。
    pass_rate: f64,
    /// 用户保留标记（工具库治理）：factory 产出默认为 false（候选），
    /// 用户选取保留（org keep）后转正；manual/import 默认 true。
    /// 未保留的候选不参与 B 路径自动复用（仍可显式寻址/记忆化派单）。
    retained: bool,
    /// 补丁历史。
    provenance: Vec<PatchRecord>,
}

impl ExpertManifest {
    /// 手写 / 工厂产出 / 导入共用的建档工厂。
    fn forge(name: String, version: String, description: String, capabilities: Vec<String>,
             source: String, eval_score: f64, fixture_path: String, entry_path: String) -> ExpertManifest {
        ExpertManifest {
            name: name,
            version: version,
            bnf: String::from("v1.5.0"),
            description: description,
            capabilities: capabilities,
            signature: ENVELOPE_SIGNATURE,
            source: source,
            eval_score: eval_score,
            fixture_path: fixture_path,
            entry_path: entry_path,
            uses: 0,
            pass_rate: 1.0,
            retained: source != String::from("factory"),
            provenance: Vec::new(),
        }
    }

    /// 能力交集判定（B 路径第一判据：类型兼容 = 信封同构，标签可交）。
    fn serves(self, skills: &Vec<String>) -> bool {
        let mut hits = 0;
        for s in skills.iter() {
            if self.capabilities.contains(s.clone()) {
                hits += 1;
            }
        }
        hits > 0
    }

    /// 语义适配粗排（B 路径第二判据：goal 与描述的词面重合）。
    fn affinity(self, goal: String) -> u32 {
        let words = goal_words(goal);
        let mut score: u32 = 0;
        for w in words.iter() {
            if w.len() >= 2 && self.description.contains(w.as_str()) {
                score += 1;
            }
        }
        score
    }

    /// manifest 序列化（JSON；写入注册表）。
    fn to_json(self) -> String {
        // join 序列化（无尾逗号）；字符串字段一律过 json_escape（序列化卫生）
        let cap_items: Vec<String> = Vec::new();
        let mut cap_list: Vec<String> = cap_items;
        for c in self.capabilities.iter() {
            cap_list.push(format!("\"{}\"", json_escape(c.clone())));
        }
        let caps = cap_list.join(",");
        let patch_items: Vec<String> = Vec::new();
        let mut patch_list: Vec<String> = patch_items;
        for p in self.provenance.iter() {
            patch_list.push(format!(
                "{{\"from\":\"{}\",\"to\":\"{}\",\"kind\":\"{}\",\"trigger\":\"{}\",\"gate\":\"{}\"}}",
                json_escape(p.from_version.clone()), json_escape(p.to_version.clone()),
                json_escape(p.change_kind.clone()), json_escape(p.trigger.clone()),
                json_escape(p.gate.clone())
            ));
        }
        let patches = patch_list.join(",");
        let retained_str = if self.retained { String::from("true") } else { String::from("false") };
        format!(
            "{{\"name\":\"{}\",\"version\":\"{}\",\"bnf\":\"{}\",\"description\":\"{}\",\"capabilities\":[{}],\"signature\":\"{}\",\"source\":\"{}\",\"eval_score\":{},\"fixture\":\"{}\",\"entry\":\"{}\",\"uses\":{},\"pass_rate\":{},\"retained\":{},\"provenance\":[{}]}}",
            json_escape(self.name), json_escape(self.version), json_escape(self.bnf),
            json_escape(self.description), caps, json_escape(self.signature),
            json_escape(self.source), self.eval_score, json_escape(self.fixture_path),
            json_escape(self.entry_path),
            self.uses, self.pass_rate, retained_str, patches
        )
    }

    /// 记一次在岗使用（统计随运行增长）。
    fn used(mut self) -> ExpertManifest {
        self.uses += 1;
        self
    }

    /// 补丁合入：版本 bump + provenance 追加（蓝绿：在岗会话继续旧版；
    /// retained 随既有 manifest 继承 —— 补丁不改变用户保留决策）。
    fn patched(mut self, record: PatchRecord) -> ExpertManifest {
        self.version = record.to_version.clone();
        self.provenance.push(record);
        self
    }

    /// 用户保留决策翻转（org keep / org drop 的库治理操作）。
    fn set_retained(mut self, retained: bool) -> ExpertManifest {
        self.retained = retained;
        self
    }

    /// 使用计数覆写（补丁/回滚合入时保留磁盘最新计数：patched manifest
    /// 源自主控节点的克隆快照，uses 可能滞后于磁盘的同轮增量）。
    fn set_uses(mut self, uses: u32) -> ExpertManifest {
        self.uses = uses;
        self
    }

    /// 金丝雀回滚：版本退回上一版（provenance 不删 —— 历史是资产的一部分）。
    fn revert_version(mut self, to_version: String) -> ExpertManifest {
        self.version = to_version;
        self
    }
}

/// 注册表（工作区 registry/ 的内存投影）。
#[derive(Debug, Clone)]
export struct Registry {
    experts: Vec<ExpertManifest>,
    /// 注册表根（相对工作区路径）。
    root: String,
}

impl Registry {
    fn new(root: String) -> Registry {
        Registry { experts: Vec::new(), root: root }
    }

    /// 从磁盘加载（工作区 registry/index.json）。
    fn load(root: String) -> Result<Registry, ExpertError> {
        let raw = native typescript {
            try {
                return $host.fs.read(root + "/index.json");
            } catch (e) {
                return "";
            }
        };
        if raw.len() == 0 {
            return Ok(Registry::new(root));
        }
        let parsed: Vec<HashMap<String, String>> = native typescript {
            const list = JSON.parse(raw);
            if (Array.isArray(list) === false) return [];
            return list.map((m) => {
                const out = new Map();
                for (const [k, v] of Object.entries(m)) {
                    // 类型纪律（与 $host.json.fields 同构）：对象/数组 → JSON 串，
                    // 原始值 → String —— 避免 Array.toString 把 ["parse"] 压成 "parse"
                    out.set(k, v === null || v === undefined ? "" : typeof v === "object" ? JSON.stringify(v) : String(v));
                }
                return out;
            });
        };
        let mut reg = Registry::new(root);
        for entry in parsed.iter() {
            let m = registry_entry_to_manifest(entry.clone())?;
            reg.experts.push(m);
        }
        Ok(reg)
    }

    /// 检索：能力交集 + 语义适配（B 路径判定；不筛保留 —— C 路径记忆化
    /// 与显式寻址也走这里，未保留候选必须仍可被找到）。
    fn find(self, goal: String, skills: &Vec<String>) -> Option<ExpertManifest> {
        let mut best: Option<ExpertManifest> = None;
        for m in self.experts.iter() {
            if m.clone().serves(skills) {
                let take = match best.clone() {
                    Some(b) => b.clone().affinity(goal.clone()) < m.clone().affinity(goal.clone()),
                    None => true,
                };
                if take {
                    best = Some(m.clone());
                }
            }
        }
        best
    }

    /// 可复用检索（B 路径专用：只命中用户保留的资产 —— factory 候选必须
    /// 经用户选取（org keep）转正后才参与自动复用；manual/import 例外，
    /// 它们本来就是随系统交付的存量资产）。
    fn find_reusable(self, goal: String, skills: &Vec<String>) -> Option<ExpertManifest> {
        let mut best: Option<ExpertManifest> = None;
        for m in self.experts.iter() {
            let reusable = m.source != String::from("factory") || m.retained;
            if reusable && m.clone().serves(skills) {
                let take = match best.clone() {
                    Some(b) => b.clone().affinity(goal.clone()) < m.clone().affinity(goal.clone()),
                    None => true,
                };
                if take {
                    best = Some(m.clone());
                }
            }
        }
        best
    }

    /// 按名翻转保留标记（返回更新后的注册表；找不到时 None）。
    fn with_retained(mut self, name: String, retained: bool) -> Option<Registry> {
        let mut hit = false;
        let mut kept: Vec<ExpertManifest> = Vec::new();
        for m in self.experts.iter() {
            if m.name == name {
                kept.push(m.clone().set_retained(retained));
                hit = true;
            } else {
                kept.push(m.clone());
            }
        }
        if hit == false {
            return None;
        }
        self.experts = kept;
        Some(self)
    }

    /// 记一次在岗使用（磁盘态增量）。调用方应从磁盘新鲜加载本注册表再调用 ——
    /// 进程内陈旧 manifest 直接 register 会把补丁刚写入的新版本号回退
    /// （merge_patch 经 clone 值语义写盘，主循环内存态不跟进 —— 实测陷阱）。
    fn note_use(mut self, name: String) -> Result<(), ExpertError> {
        let mut kept: Vec<ExpertManifest> = Vec::new();
        for m in self.experts.iter() {
            if m.name == name {
                kept.push(m.clone().used());
            } else {
                kept.push(m.clone());
            }
        }
        self.experts = kept;
        self.flush()
    }

    /// 登记（入库：写 manifest + 更新索引；幂等按名覆盖）。
    fn register(&mut self, manifest: ExpertManifest) -> Result<(), ExpertError> {
        let mut kept: Vec<ExpertManifest> = Vec::new();
        for m in self.experts.iter() {
            if m.name != manifest.name {
                kept.push(m.clone());
            }
        }
        kept.push(manifest.clone());
        self.experts = kept;
        self.flush()
    }

    /// 登记到内存态（不落盘）：mint 后主控节点需立即可见新专家，但磁盘已由
    /// register_expert 写入 —— 此处再 flush 会用节点上的陈旧快照覆盖磁盘
    //（同轮 note_use 增量会被回退）。
    fn upsert_memory(&mut self, manifest: ExpertManifest) {
        let mut kept: Vec<ExpertManifest> = Vec::new();
        for m in self.experts.iter() {
            if m.name != manifest.name {
                kept.push(m.clone());
            }
        }
        kept.push(manifest.clone());
        self.experts = kept;
    }

    /// 落盘（index.json + 每专家 manifest）。
    fn flush(&mut self) -> Result<(), ExpertError> {
        let mut item_list: Vec<String> = Vec::new();
        for m in self.experts.iter() {
            item_list.push(m.clone().to_json());
        }
        let index = format!("[{}]", item_list.join(","));
        let root = self.root.clone();
        let _ = native typescript {
            $host.fs.write(root + "/index.json", index);
            return true;
        };
        for m in self.experts.iter() {
            let path = format!("{}/{}.json", root, m.name);
            let body = m.clone().to_json();
            let _ = native typescript {
                $host.fs.write(path, body);
                return true;
            };
        }
        Ok(())
    }

    /// 排除某专家后的注册表投影（Reject 重派：路由重选时排除失败执行体）。
    fn without(self, name: String) -> Registry {
        let mut kept: Vec<ExpertManifest> = Vec::new();
        for m in self.experts.iter() {
            if m.name != name {
                kept.push(m.clone());
            }
        }
        Registry { experts: kept, root: self.root.clone() }
    }

    /// 实现来源多样的候选对（N 版本冗余的检索：不同 source 或不同 version）。
    fn diverse_pair(self, skills: &Vec<String>) -> Option<(ExpertManifest, ExpertManifest)> {
        let mut pool: Vec<ExpertManifest> = Vec::new();
        for m in self.experts.iter() {
            if m.clone().serves(skills) && m.entry_path.ends_with(String::from(".hsl")) {
                pool.push(m.clone());
            }
        }
        for a in pool.iter() {
            for b in pool.iter() {
                if a.name == b.name {
                    continue;
                }
                if a.source != b.source || a.version != b.version {
                    return Some((a.clone(), b.clone()));
                }
            }
        }
        None
    }

    /// 状态快照（org status 的原料；★ = 用户保留资产，○ = 待选候选）。
    fn snapshot(self) -> String {
        let mut out = format!("registry root: {} ({} experts)\n", self.root, self.experts.len());
        for m in self.experts.iter() {
            let mark = if m.retained { String::from("★") } else { String::from("○") };
            out.push_str(format!(
                "  {} {}@{} [{}] uses={} pass_rate={} eval={} {}\n",
                mark, m.name, m.version, m.source, m.uses, m.pass_rate, m.eval_score,
                if m.retained { String::from("retained") } else { String::from("candidate") }
            ).as_str());
        }
        out
    }
}

/// JSON 字段 → manifest（$host.json.fields 类型纪律通道）。
fn registry_entry_to_manifest(fields: HashMap<String, String>) -> Result<ExpertManifest, ExpertError> {
    let name = fields.get(String::from("name")).unwrap_or(String::from("?"));
    let version = fields.get(String::from("version")).unwrap_or(String::from("0.0.0"));
    let bnf = fields.get(String::from("bnf")).unwrap_or(String::from("v1.5.0"));
    let description = fields.get(String::from("description")).unwrap_or(String::from(""));
    let caps_raw = fields.get(String::from("capabilities")).unwrap_or(String::from("[]"));
    let signature = fields.get(String::from("signature")).unwrap_or(ENVELOPE_SIGNATURE);
    let source = fields.get(String::from("source")).unwrap_or(String::from("manual"));
    let eval_raw = fields.get(String::from("eval_score")).unwrap_or(String::from("1.0"));
    let fixture = fields.get(String::from("fixture")).unwrap_or(String::from(""));
    let entry = fields.get(String::from("entry")).unwrap_or(String::from(""));
    let uses_raw = fields.get(String::from("uses")).unwrap_or(String::from("0"));
    let pass_raw = fields.get(String::from("pass_rate")).unwrap_or(String::from("1.0"));
    // 旧注册表无 retained 字段 → 默认 true（向后兼容：存量资产不受新字段影响）
    let retained_raw = fields.get(String::from("retained")).unwrap_or(String::from("true"));

    let eval_score = parse_f64(eval_raw);
    let pass_rate = parse_f64(pass_raw);
    let uses = parse_u32(uses_raw);
    let retained = retained_raw == String::from("true");

    let capabilities: Vec<String> = native typescript {
        const arr = JSON.parse(caps_raw);
        if (Array.isArray(arr) === false) return [];
        return arr.map((x) => String(x));
    };

    // provenance 读回（历史是资产的一部分：加载侧不解析会在任何
    // load→flush 往返中把补丁历史静默洗掉 —— note_use 磁盘态增量实测踩中）
    let prov_raw = fields.get(String::from("provenance")).unwrap_or(String::from("[]"));
    let prov_rows: Vec<HashMap<String, String>> = native typescript {
        const arr = JSON.parse(prov_raw);
        if (Array.isArray(arr) === false) return [];
        return arr.map((p) => {
            const m = new Map();
            for (const [k, v] of Object.entries(p)) m.set(k, v === null || v === undefined ? "" : String(v));
            return m;
        });
    };
    let mut provenance: Vec<PatchRecord> = Vec::new();
    for row in prov_rows.iter() {
        provenance.push(PatchRecord {
            from_version: row.get(String::from("from")).unwrap_or(String::from("?")),
            to_version: row.get(String::from("to")).unwrap_or(String::from("?")),
            change_kind: row.get(String::from("kind")).unwrap_or(String::from("knowledge")),
            trigger: row.get(String::from("trigger")).unwrap_or(String::from("")),
            gate: row.get(String::from("gate")).unwrap_or(String::from("")),
        });
    }

    Ok(ExpertManifest {
        name: name,
        version: version,
        bnf: bnf,
        description: description,
        capabilities: capabilities,
        signature: signature,
        source: source,
        eval_score: eval_score,
        fixture_path: fixture,
        entry_path: entry,
        uses: uses,
        pass_rate: pass_rate,
        retained: retained,
        provenance: provenance,
    })
}

/// 字符串 → f64（容错解析；0.0 兜底）。
fn parse_f64(text: String) -> f64 {
    let out = native typescript {
        const n = parseFloat(text);
        return Number.isFinite(n) ? n : 0.0;
    };
    out
}

/// 字符串 → u32（容错解析；0 兜底）。
fn parse_u32(text: String) -> u32 {
    let out = native typescript {
        const n = parseInt(text, 10);
        return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
    };
    out
}
