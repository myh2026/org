            const r = plugins.pluginList(ws);
            return JSON.stringify({
                tool: "plugin_list", ok: true, dir: ".org/plugins", count: r.plugins.length,
                plugins: r.plugins.map((p) => ({
                    name: p.manifest ? p.manifest.name : pathMod.basename(p.path),
                    ...(p.manifest ? { version: p.manifest.version, description: p.manifest.description, permissions: p.manifest.permissions } : {}),
                    valid: p.valid, ...(p.problems.length > 0 ? { problems: p.problems } : {}),
                })),
            });
