                    const pathMod = await import("node:path");
                    const fsMod = await import("node:fs");
                    const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
                    const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
                    const wsReal = fsMod.realpathSync(ws);
                    const lexical = pathMod.isAbsolute(file) ? file.replace(/\\/g, "/") : pathMod.resolve(wsReal, file);
                    const jail = await import(root + "/lib/pathjail.ts"); // v0.5.16.1：win32 混合分隔符收敛（CI run 35367288947 修复）
                    const inWs = (p) => jail.inWorkspace(wsReal, p);
                    if (!inWs(lexical)) return { jail: false, error: "路径越界（须在工作区内）：" + file };
                    try {
                        const parent = fsMod.realpathSync(pathMod.dirname(lexical));
                        const resolved = pathMod.join(parent, pathMod.basename(lexical));
                        if (!inWs(resolved)) return { jail: false, error: "路径越界（符号链逃逸）：" + file };
                        return { jail: true, path: resolved };
                    } catch (e2) { return { jail: true, path: lexical }; }
                } catch (e) { return { jail: false, error: String(e && e.message || e) }; }
            })();
            if (!guard.jail) return JSON.stringify({ tool: "db_diagnose", ok: false, error: guard.error });
            const dbdiag = await import(root + "/lib/dbdiag.ts");
            const setup = a.setup != null ? String(a.setup) : undefined;
            const r = await dbdiag.dbDiagnose(guard.path, sql, setup ? { setup } : {});
            if (!r.ok) return JSON.stringify({ tool: "db_diagnose", ok: false, kind: r.kind, error: r.error });
            return JSON.stringify({
                tool: "db_diagnose", ok: true, ms: r.ms,
                plan: { steps: r.plan.steps.slice(0, 20), step_count: r.plan.steps.length, tables: r.plan.tables, full_scan: r.plan.fullScan },
                suggestions: r.suggestions,
            });
        } catch (e) {
            return JSON.stringify({ tool: "db_diagnose", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.16 merge / rebase（capabilities #80）：lib/gitmerge.ts 同源。冲突哲学
/// 绝不自动解决 —— 冲突即自动 abort + 清单（lib 内建）。Full + 审批在环。
/// repo 缺省 = 工作区根；显式 repo 须在工作区内（监狱）。
fn tool_git_merge(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const source = String(a.source || a.branch || "");
            if (!source) return JSON.stringify({ tool: "git_merge", ok: false, error: "args.source 必填（被合并的分支/提交）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "git_merge", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const repo = a.repo != null && String(a.repo) !== "" ? pathMod.resolve(ws, String(a.repo)) : ws;
            const jail = await import(root + "/lib/pathjail.ts"); // v0.5.16.1：win32 混合分隔符收敛
            if (!jail.inWorkspace(ws, repo)) return JSON.stringify({ tool: "git_merge", ok: false, error: "路径越界（repo 须在工作区内）：" + String(a.repo) });
            const gm = await import(root + "/lib/gitmerge.ts");
            const r = gm.gitMerge(repo, { source: source, ...(a.message != null ? { message: String(a.message) } : {}), noFf: a.no_ff === true || a.noFf === true });
            return JSON.stringify({
                tool: "git_merge", ok: r.ok, output: String(r.output || "").slice(0, 4096),
                conflicts: r.conflicts, aborted: r.aborted,
                ...(r.kind ? { kind: r.kind } : {}), ...(r.error ? { error: r.error } : {}),
                ...(r.kind === "conflict" ? { hint: "冲突绝不自动解决：人工处理后重试，或换 fs_read 查看文件内容" } : {}),
            });
        } catch (e) {
            return JSON.stringify({ tool: "git_merge", ok: false, error: String(e && e.message || e) });
        }
    }
}

fn tool_git_rebase(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const onto = String(a.onto || a.base || "");
            if (!onto) return JSON.stringify({ tool: "git_rebase", ok: false, error: "args.onto 必填（变基目标分支/提交）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
