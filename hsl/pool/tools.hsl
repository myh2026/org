                threads: s.threads, posts: s.posts, comments: s.comments, users: s.users,
                ...(s.lastActive ? { last_active: s.lastActive } : {}),
                collaborators: users.slice(0, 50).map((u) => ({ user: u.user, posts: u.posts, last_active: u.lastActive })),
                me: { user: who.user, source: who.source },
                ...(users.length > 50 ? { collaborators_truncated: true } : {}),
            });
        } catch (e) {
            return JSON.stringify({ tool: "collab_summary", ok: false, error: String(e && e.message || e) });
        }
    }
