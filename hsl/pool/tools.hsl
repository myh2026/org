/// v0.5.16 OpenAPI 解析（capabilities #134）：lib/openapi.ts 同源
/// （3.x/2.0 双识别 + suggestToolName 工具命名建议）。只读工具。
fn tool_openapi_parse(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const file = String(a.file || a.spec || "");
            if (!file) return JSON.stringify({ tool: "openapi_parse", ok: false, error: "args.file 必填（工作区相对路径）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "openapi_parse", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const guard = await (async () => {
                try {
                    const pathMod = await import("node:path");
                    const fsMod = await import("node:fs");
                    const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
                    const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
                    const wsReal = fsMod.realpathSync(ws);
                    const lexical = pathMod.isAbsolute(file) ? file.replace(/\\/g, "/") : pathMod.resolve(wsReal, file);
                    const jail = await import(root + "/lib/pathjail.ts"); // v0.5.16.1：win32 混合分隔符收敛（CI run 35367288947 修复）
                    const inWs = (p) => jail.inWorkspace(wsReal, p);
                    if (!inWs(lexical)) return { jail: false, error: "路径越界（须在工作区内）：" + file };
                    try {
                        const parent = fsMod.realpathSync(pathMod.dirname(lexical));
                        const resolved = pathMod.join(parent, pathMod.basename(lexical));
                        if (!inWs(resolved)) return { jail: false, error: "路径越界（符号链逃逸）：" + file };
                        return { jail: true, path: resolved };
                    } catch (e2) { return { jail: true, path: lexical }; }
                } catch (e) { return { jail: false, error: String(e && e.message || e) }; }
            })();
            if (!guard.jail) return JSON.stringify({ tool: "openapi_parse", ok: false, error: guard.error });
            const oa = await import(root + "/lib/openapi.ts");
            const r = oa.parseOpenApiFile(guard.path);
            if (!r.ok) return JSON.stringify({ tool: "openapi_parse", ok: false, kind: r.kind, error: r.error });
            return JSON.stringify({
                tool: "openapi_parse", ok: true, version: r.version, info: r.info,
                servers: r.servers, schemas: r.schemas,
                operations: r.operations.slice(0, 50).map((op) => ({
                    method: op.method, path: op.path, operation_id: op.operationId,
                    ...(op.summary ? { summary: op.summary.slice(0, 120) } : {}),
                    params: op.params, security: op.security, tool_name: oa.suggestToolName(op),
                })),
                total_operations: r.operations.length,
            });
        } catch (e) {
            return JSON.stringify({ tool: "openapi_parse", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.16 浏览器 DOM 快照 / 整页截图（capabilities #116+#30）：lib/browser.ts
/// 同源（引擎链 agent-browser → chromium → chrome）。snapshot 只读；screenshot
/// 落 PNG 进工作区（Full + 审批在环）。超时预算收敛到引擎侧既有约束：
/// timeout_ms 钳制 [1s, 60s]（对齐 $host.shell.run 的 60s 命令预算），缺省 30s。
async fn tool_browser_snapshot(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const url = String(a.url || "");
            if (!url) return JSON.stringify({ tool: "browser_snapshot", ok: false, error: "args.url 必填（http/https）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "browser_snapshot", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const timeoutMs = Math.max(1000, Math.min(60000, Math.floor(Number(a.timeout_ms || a.timeoutMs) || 30000)));
            const browser = await import(root + "/lib/browser.ts");
            const r = await browser.browserSnapshot(url, { timeoutMs });
            if (!r.ok) return JSON.stringify({ tool: "browser_snapshot", ok: false, kind: r.kind, error: r.error, ...(r.hint ? { hint: r.hint } : {}) });
            return JSON.stringify({
                tool: "browser_snapshot", ok: true, engine: r.engine, url: r.url,
                ...(r.finalUrl ? { final_url: r.finalUrl } : {}), ...(r.title ? { title: r.title } : {}),
                text: String(r.text || "").slice(0, 16384), ms: r.ms,
                links: (r.links || []).slice(0, 30), imgs: (r.imgs || []).slice(0, 10),
                ...(r.hint ? { hint: r.hint } : {}),
            });
        } catch (e) {
            return JSON.stringify({ tool: "browser_snapshot", ok: false, error: String(e && e.message || e) });
        }
    }
}

async fn tool_browser_screenshot(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const url = String(a.url || "");
            if (!url) return JSON.stringify({ tool: "browser_screenshot", ok: false, error: "args.url 必填（http/https）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "browser_screenshot", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            // out：工作区相对（监狱）；缺省 browser-<时间戳>.png 落工作区根
            const outRel = a.out != null && String(a.out) !== "" ? String(a.out) : ("browser-" + new Date().toISOString().replace(/[-:T.]/g, "").slice(0, 14) + ".png");
            const outAbs = pathMod.isAbsolute(outRel) ? outRel.replace(/\\/g, "/") : pathMod.resolve(ws, outRel);
            const jail = await import(root + "/lib/pathjail.ts"); // v0.5.16.1：win32 混合分隔符收敛
            if (!jail.inWorkspace(ws, outAbs)) return JSON.stringify({ tool: "browser_screenshot", ok: false, error: "路径越界（out 须在工作区内）：" + outRel });
            const timeoutMs = Math.max(1000, Math.min(60000, Math.floor(Number(a.timeout_ms || a.timeoutMs) || 30000)));
            const browser = await import(root + "/lib/browser.ts");
            const r = await browser.browserScreenshot(url, { out: outAbs, timeoutMs });
            if (!r.ok) return JSON.stringify({ tool: "browser_screenshot", ok: false, kind: r.kind, error: r.error, ...(r.hint ? { hint: r.hint } : {}) });
            return JSON.stringify({ tool: "browser_screenshot", ok: true, engine: r.engine, url: r.url, path: pathMod.relative(ws, r.path) || pathMod.basename(r.path), ms: r.ms });
        } catch (e) {
            return JSON.stringify({ tool: "browser_screenshot", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.16 光标处补全（capabilities #32）：lib/completion.ts 同源。
/// line_text + column（0 基偏移，缺省行尾）或 line（1 基行号 → 读盘取行）。
/// 只读工具。
async fn tool_complete_at(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const file = String(a.file || a.path || "");
            if (!file) return JSON.stringify({ tool: "complete_at", ok: false, error: "args.file 必填（工作区相对路径）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "complete_at", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const fsMod = await import("node:fs");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const abs = pathMod.isAbsolute(file) ? file.replace(/\\/g, "/") : pathMod.resolve(ws, file);
            // v0.5.16.1 CI 修复：ws 是 "/" 形而 path.resolve() 在 win32 产 "\" 形 ——
            // 混形前缀比较必然假性越界（run 35367288947 win32 实锤：src/app.hsl 被拒）。
            // 统一走 pathjail 同形比较（分隔符归一 + win32 盘符大小写折叠）。
            const jail = await import(root + "/lib/pathjail.ts");
            if (!jail.inWorkspace(ws, abs)) return JSON.stringify({ tool: "complete_at", ok: false, error: "路径越界（须在工作区内）：" + file });
            let lineText = a.line_text != null ? String(a.line_text) : null;
            let lineNo = 0;
            if (lineText === null && a.line != null) {
                const n = Math.max(1, Math.floor(Number(a.line) || 1));
                const text = fsMod.readFileSync(abs, "utf8");
                const lines = text.split("\n");
                lineText = lines[n - 1] ?? "";
                lineNo = n;
            }
            if (lineText === null) return JSON.stringify({ tool: "complete_at", ok: false, error: "args.line_text（当前行全文）或 args.line（1 基行号）必填其一" });
            const column = a.column != null && Number.isFinite(Number(a.column)) ? Math.max(0, Math.floor(Number(a.column))) : lineText.length;
            const completion = await import(root + "/lib/completion.ts");
            // dirs:[""] = 工作区根扫描（与 symbol_search v0.5.15 同口径；lib 缺省
            // 目录清单是 org 仓形态，agent 工作区按根扫）
            const r = await completion.completeAt(ws, file, lineText, column, { dirs: [""] });
            return JSON.stringify({
                tool: "complete_at", ok: true, ...(lineNo > 0 ? { line: lineNo } : {}),
                language: r.language, prefix: r.prefix, ...(r.reason ? { reason: r.reason } : {}),
                candidates: r.candidates.map((c) => ({ label: c.label, kind: c.kind, detail: c.detail, score: c.score, source: c.source })),
            });
        } catch (e) {
            return JSON.stringify({ tool: "complete_at", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.16 项目级重命名（capabilities #56）：lib/rename.ts 同源。缺省 dryRun
/// 预览（unified diff ≤5 文件）；dry_run:false 真写（失败即停诚实部分失败）。
/// Full + 审批在环（预览与真写同门 —— 与 fs_write preview 同哲学）。
async fn tool_rename_symbol(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const oldName = String(a.old || a.old_name || a.from || "");
            const newName = String(a.new || a.new_name || a.to || "");
            if (!oldName || !newName) return JSON.stringify({ tool: "rename_symbol", ok: false, error: "args.old/args.new 必填" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "rename_symbol", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const rename = await import(root + "/lib/rename.ts");
            const dryRun = a.dry_run !== false && a.dryRun !== false; // 缺省 true（安全缺省：预览不落盘）
            // dirs:[""] = 工作区根扫描（与 symbol_search/complete_at 同口径；lib 缺省
            // 目录清单是 org 仓形态，agent 工作区按根扫）
            const r = await rename.applyRename(ws, oldName, newName, { dryRun, dirs: [""] });
            if (!r.ok) return JSON.stringify({ tool: "rename_symbol", ok: false, dry_run: r.dryRun, reason: r.reason ?? "计划不可执行", ...(r.plan.definition ? { definition: { kind: r.plan.definition.kind, file: r.plan.definition.file, line: r.plan.definition.line } } : {}), warnings: r.plan.warnings });
            const files = [...new Set(r.plan.edits.map((e) => e.file))];
            return JSON.stringify({
                tool: "rename_symbol", ok: true, dry_run: r.dryRun,
                definition: { kind: r.plan.definition.kind, file: r.plan.definition.file, line: r.plan.definition.line },
                edits: r.plan.edits.length, files: files.length, warnings: r.plan.warnings,
                ...(r.dryRun
                    ? { previews: (r.previews || []).map((p) => ({ file: p.file, stats: p.stats, diff: p.diff.slice(0, 8192) })), files_total: r.filesTotal, ...(r.previewTruncated ? { preview_truncated: true } : {}) }
                    : { applied: r.applied, ...(r.failed ? { failed: r.failed } : {}) }),
            });
        } catch (e) {
            return JSON.stringify({ tool: "rename_symbol", ok: false, error: String(e && e.message || e) });
        }
    }
}

