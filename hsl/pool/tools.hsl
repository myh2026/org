// ============================================================================
// org/pool/tools.hsl — agent 工具环（v0.5.3）：模型可调用的工作区工具
// ============================================================================
// 「org agent 成为正常 agent」的执行层：direct 车道的模型回复可携带
// <tool>{"name":"...","args":{...}}</tool> 结构化调用，HSL 侧解析 → 能力
// 门 → $host 执行 → 结果回灌对话（有界循环）。
//
// 开关（多重优雅降级）：
//   ORG_TOOLS=0/未设  → 工具环关闭（纯问答，v0.5.2 行为零变化）
//   ORG_TOOLS=1       → 只读工具（fs_read / fs_list / fs_glob）—— 零风险
//   ORG_TOOLS=write   → 全量工具（写/执行）—— 写动作走能力门：
//                       ORG_APPROVAL=1 → 审批队列（人在环）；未开审批 →
//                       拒绝并告知模型原因（安全缺省，绝不静默放行）
//
// 工具集（与 $host ABI 同源，全部过路径监狱/首词白名单）：
//   fs_read   {path}                     读文件（≤32KB 截断可观测）
//   fs_list   {dir, depth?}              目录清单
//   fs_glob   {pattern}                  简单 glob（* 与 **，走 fs_list 树）
//   fs_write  {path, content}            写文件（能力门）
//   fs_edit   {path, old, new}           唯一锚点编辑（能力门）
//   shell_run {cmd}                      命令执行（能力门 + --allow 白名单）
//
// v0.5.6 新增（Full 模式）：
//   agent_spawn  {goal, mode?, expert?, reuse?}  子生孙递归派生：派生一个子
//           组织（org run 团队任务 / org ask 直连专家）。双重治理：
//           ① 深度：ORG_SPAWN_DEPTH（当前深度，派生方注入）+ ORG_SPAWN_MAX
//           （上限，缺省 2，0=关闭）；② 预算（v0.5.11）：ORG_SPAWN_BUDGET
//           份数（未设=100，0=耗尽，off=关闭治理）× ORG_SPAWN_DECAY 衰减率
//           （缺省 0.5）—— 子预算 = floor(父预算 × decay)，随深度指数衰减。
//           池化重档（v0.5.11）：<ws>/spawn/pool.json 登记每次派生；相似
//           goal（词面重合 ≥ ORG_SPAWN_REUSE_FLOOR，缺省 0.6）命中即复用
//           （reuse:false 强制新派生）。子进程继承全部车道环境；子组织
//           metrics.json 的 tokens/model_calls 用量回填到结果（观测面）。
//   audio_compose {name?, title?, tempo?, notes}  古典音乐作曲：写乐谱
//           工件 <name>.notes.json，引擎收尾自动渲染同名 .wav
//           （产物开袋即食：音频不是乐谱）。
//
// 事件（观测面，三端消费）：
//   journal tool_call   <tool> <args 摘要>
//   journal tool_result <tool> ok=<n> chars / denied=<原因>
//   journal tool_denied <tool> <原因>
//   journal rbac_denied <action> <rule> <reason>（v0.5.16，ORG_RBAC_ROLE 启用时）
//
// v0.5.16 新增（治理与扩展批 · 13 工具，native 块 await import(root+
// "/lib/x.ts") 与 lib 同源 —— 行为等价由构造保证）：
//   只读（ReadOnly 模式可用）：
//   db_diagnose  {file, sql, setup?}   SQLite EXPLAIN QUERY PLAN 诊断（#113）
//   rbac_check   {action, role?}       RBAC 判定查询（#149）
//   iac_scan     {dirs?}               容器/IaC 静态扫描（#147，16 规则）
//   openapi_parse {file}               OpenAPI 3.x/Swagger 2.0 解析（#134）
//   plugin_list  {}                    插件清单（#132）
//   browser_snapshot {url, timeout_ms?} DOM 快照（#116/#30）
//   complete_at  {file, line_text, column?} 光标补全（#32）
//   写动作（Full 模式 + 能力门/审批在环）：
//   git_merge    {repo?, source, message?, no_ff?}  merge（#80，冲突恒 abort）
//   git_rebase   {repo?, onto}                      rebase（#80，同上）
//   plugin_install {source} / plugin_remove {name}  插件事务性安装/移除（#132）
//   browser_screenshot {url, out?, timeout_ms?}     整页截图 PNG（#116）
//   rename_symbol {old, new, dry_run?}  项目级重命名（#56，缺省 dryRun 预览）
//
// v0.5.16 RBAC 可选门控（execute_tool 分发处）：ORG_RBAC_ROLE 未设 = 门控
// 完全不启用（零行为回归，单机缺省）；设了 → lib/rbac.ts loadRbac +
// rbacCheck（动作命名空间 tool:<name>），拒绝时工具错误含 rule 与 reason，
// 并落审计（journal rbac_denied 事件 + runtime/rbac.jsonl 决策账本）。
// 插件 manifest 的 permissions 字段（"tool:shell_run" 形态）与该命名空间
// 联动 —— 插件执行面是路线图（本仓库只装不执行，permissions 先行声明）。
//
// v0.5.17 新增（LSP/DAP 深度簇 · 6 工具，native 块 await import(root+
// "/lib/lsp.ts" / "/lib/debug.ts") 与 lib 同源 —— 行为等价由构造保证；
// 全部只读：符号索引查询 / 源码扫描 / 纯内存协议层）：
//   lsp_definition {name}            符号→声明位置（内置车道，#26）
//   lsp_references {name, max_hits?} 符号引用列表（call/mention）
//   lsp_hover     {name}             符号 kind + 所在文件行上下文
//   lsp_servers   {}                 外部 LSP server which 探测（缺席诚实降级）
//   debug_breakpoints {file}         断点建议（入口/分支/循环/return 前，#108）
//   debug_plan    {file}             调试计划（步骤 + DAP 协议就绪消息序列）
//
// v0.5.17 新增（云生态簇 · 6 工具，native 块 await import(root+"/lib/cloud.ts")
// 与 lib 同源 —— 行为等价由构造保证；#67/#68/#72/#74）：
//   只读（ReadOnly 模式可用）：
//   cloud_probe   {}                  全景探测（docker/ssh/k8s/tf/云CLI 五面，
//                                    工具缺席诚实降级 + 指引）
//   cloud_dockerfile {project_type}  生产级 Dockerfile 模板（node/bun/python/
//                                    rust 四型，多阶段 + 非 root + healthcheck）
//   cloud_clis    {}                 10 家云 CLI 探测表（aws/gcloud/az/gh/…）
//   执行车道（Full 模式 + process_spawn 门 + 审批在环）：
//   cloud_docker  {args:[...], context?}  docker 白名单子命令封装（16 子命令；
//                                    build 的 context/Dockerfile 过监狱）
//   cloud_ssh     {host, command} | {host, upload_local, upload_remote}
//                                    host 须在 <ws>/ssh-hosts.allow；BatchMode
//                                    +ConnectTimeout+accept-new；scp local 过监狱
//   cloud_k8s     {args:[...]}       kubectl 白名单（get/describe/apply/logs…）；
//                                    apply -f 路径过监狱，-f -（stdin）拒绝
//
// v0.5.17 新增（协作簇 · 5 工具，native 块 await import(root+"/lib/collab.ts")
// 与 lib 同源 —— 行为等价由构造保证；#87 团队共享会话/评论。append-only JSONL
// 团队线程 + 回复树 + @mention + 身份层 + 会话账本桥，诚实边界：本地文件协议，
// 多进程强并发不在面内）：
//   只读（ReadOnly 模式可用）：
//   collab_threads {}                 线程清单 + 工作区协作摘要
//   collab_feed    {thread, since_seq?} 增量读（seq > since_seq 的平铺回复树）
//   collab_summary {}                 协作总览（线程/帖/评论/用户 + 协作者 + 我是谁）
//   写动作（Full 模式 + file_write 门 + 审批在环）：
//   collab_post    {thread, text, user?}  发帖（@user mentions 自动抽取；
//                                    user 缺省取当前协作者身份）
//   collab_comment {thread, seq, text, user?} 评论指定楼层（replyTo 树）
//
// v0.5.18 新增（移动端调试簇 · 3 工具，native 块 await import(root+
// "/lib/mobile.ts") 与 lib 同源 —— 行为等价由构造保证；#117 移动端调试。
// 多重优雅降级：adb 缺席→无设备→未授权三层；logcat -d dump 五元组；
// plan 纯函数保底（零外部依赖永远可用）。执行面全只读 —— install/uninstall
// 只出现在计划器的可粘贴命令里，不在任何工具执行面）：
//   只读（ReadOnly 模式可用）：
//   mobile_devices {}                 adb devices -l 解析（多设备/未授权/
//                                    offline 诚实入列）+ iOS 面 idevice 探测
//   mobile_logcat  {lines?, tag?, level?, serial?, package?}
//                                    logcat dump 快照（-d 非尾随 · 行数铺
//                                    1..2000 · tag/级别/包名三重过滤）
//   mobile_plan    {platform, symptom} 调试计划（纯函数保底：android/ios/both ×
//                                    crash/白屏/network/性能/构建/安装/webview
//                                    症状矩阵 → 每步 命令+预期+降级指引）
// ============================================================================

import { CapabilityPolicy, AccessMode } from "../policy/capability.hsl";
import { request_approval, ApprovalOutcome } from "../policy/approval.hsl";

/// 工具调用（模型输出解析后的结构）。
#[derive(Debug, Clone)]
export struct ToolCall {
    name: String,
    args_json: String,
}

/// 工具环开关状态。
#[derive(Debug, Clone, PartialEq)]
export enum ToolMode {
    Off,
    ReadOnly,
    Full,
}

/// 解析 ORG_TOOLS 环境变量（未设/0 → Off；1/read → ReadOnly；write/full → Full）。
export fn tool_mode() -> ToolMode {
    let raw: String = native typescript {
        return String($host.env.get("ORG_TOOLS") || "").trim().toLowerCase();
    };
    if raw == String::from("1") || raw == String::from("read") || raw == String::from("readonly") {
        return ToolMode::ReadOnly;
    }
    if raw == String::from("write") || raw == String::from("full") || raw == String::from("all") {
        return ToolMode::Full;
    }
    ToolMode::Off
}

/// 工具环系统提示（注入 direct 车道的 system 尾部；Off 模式返回空串）。
export fn tools_prompt(mode: ToolMode) -> String {
    if mode == ToolMode::Off {
        return String::new();
    }
    let mut out = String::from(
        "\n\n## Tools\nYou can use workspace tools. To call one, output EXACTLY this format on its own line (you may call multiple tools in one reply, one per line):\n<tool>{\"name\":\"TOOL_NAME\",\"args\":{...}}</tool>\n",
    );
    out.push_str("- fs_read {\"path\":\"relative/path\"} — read a file (workspace-relative)\n");
    out.push_str("- fs_list {\"dir\":\"relative/dir\",\"depth\":3} — list directory\n");
    out.push_str("- fs_glob {\"pattern\":\"src/**/*.hsl\"} — glob match files\n");
    out.push_str("- semantic_search {\"query\":\"审计 制度\",\"k\":5} — BM25 semantic search over workspace corpus (raw/ registry/ work/ factory/); returns ranked hits with snippets. Prefer this over fs_glob+fs_read loops when you need relevant context by meaning.\n");
    // v0.5.15 桌面 Agent 补全：符号跳转 / 数据库只读面 / PDF 读取（全部只读，零审批门槛）
    out.push_str("- symbol_search {\"name\":\"startRun\",\"refs\":true?} — definition + reference lookup for HSL/TS/Python symbols (fn/struct/enum/graph/class/def). Returns file:line for jumps.\n");
    out.push_str("- db_schema {\"file\":\"data/app.db\"} — SQLite schema inspection (tables/columns/indexes/views; workspace-relative). Read-only.\n");
    out.push_str("- db_query {\"file\":\"data/app.db\",\"sql\":\"SELECT …\",\"limit\":200?} — SQLite read-only query (single SELECT/WITH/EXPLAIN/PRAGMA table_info only; writes go through db_migrate).\n");
    out.push_str("- read_pdf {\"file\":\"docs/spec.pdf\",\"max_pages\":50?} — extract text from a PDF (engine chain: pdftotext → uv+pypdf → honest failure).\n");
    // v0.5.16 治理与扩展批（只读工具，零审批门槛）
    out.push_str("- db_diagnose {\"file\":\"data/app.db\",\"sql\":\"SELECT …\",\"setup\":\"CREATE TABLE…\"?} — SQLite EXPLAIN QUERY PLAN diagnosis: index usage / full-table-scan detection / tables involved + tuning suggestions. setup seeds a transient :memory: db only (file dbs refuse it); single SELECT/WITH statement only.\n");
    out.push_str("- rbac_check {\"action\":\"tool:fs_write\",\"role\":\"observer\"?} — query the RBAC policy (workspace .org/rbac.json; falls back to owner-allows-all when absent). Returns allowed/denied + matched rule (deny wins over allow; unknown role or no match = deny). role defaults to ORG_RBAC_ROLE env.\n");
    out.push_str("- iac_scan {\"dirs\":[\"deploy\"]?} — static security scan of Dockerfile / docker-compose / terraform files (16 rules: root user, privileged containers, 0.0.0.0 ingress, hardcoded secrets, :latest tags …). Read-only, per-file isolation.\n");
    out.push_str("- openapi_parse {\"file\":\"api/openapi.json\"} — parse an OpenAPI 3.x / Swagger 2.0 JSON spec into an operations list (method/path/params/security) with suggested tool names (api_<operationId>). YAML must be converted to JSON first (hint in error).\n");
    out.push_str("- plugin_list {} — list installed plugins (.org/plugins; manifest name/version/entry/permissions). Installing executes nothing — plugin execution is roadmap; permissions map to RBAC actions.\n");
    out.push_str("- browser_snapshot {\"url\":\"https://example.com\",\"timeout_ms\":30000?} — fetch a page DOM snapshot (title/text/links/images) via engine chain agent-browser → chromium → chrome. timeout_ms clamped to 1-60s. Console/network panels are roadmap (honest boundary).\n");
    out.push_str("- complete_at {\"file\":\"src/app.ts\",\"line_text\":\"const va\",\"column\":7?} — code completion at cursor (HSL/TS/PY): same-file symbols > project symbols > language keywords, prefix-ranked. column is a 0-based char offset into line_text (defaults to end of line). Member completion/type inference are LSP roadmap; empty results carry an honest reason.\n");
    // v0.5.17 协作簇（#87 团队共享会话/评论 —— 只读三件，ReadOnly 模式可用）
    out.push_str("- collab_threads {} — list team threads (runtime/collab/threads/*.jsonl, append-only): id/title/participants/post counts + workspace summary. Team collaboration layer over the single-user session ledger.\n");
    out.push_str("- collab_feed {\"thread\":\"t1\",\"since_seq\":5?} — incremental thread read (posts with seq > since_seq) as a flattened reply tree with depth; efficient lane for collaboration polling.\n");
    out.push_str("- collab_summary {} — collaboration overview: threads/posts/comments/users + collaborators with post counts + who am I (identity file or ORG_COLLAB_USER).\n");
    // v0.5.17 LSP/DAP 深度簇（只读工具，零审批门槛）
    out.push_str("- lsp_definition {\"name\":\"startRun\"} — symbol → declaration sites (built-in symbol-index lane of the LSP integration; returns both LSP canonical uri/range 0-based and human file:line:column). External-server lane (spawnLspServer) available via lib/lsp.ts from CLI/tests.\n");
    out.push_str("- lsp_references {\"name\":\"startRun\",\"max_hits\":200?} — symbol references list (call vs mention, definition lines excluded); same symbol-index lane.\n");
    out.push_str("- lsp_hover {\"name\":\"startRun\"} — hover info for a symbol: kind + definition site + source line context (plain-text contents; type inference is roadmap).\n");
    out.push_str("- lsp_servers {} — probe known external language servers (typescript-language-server/pylsp/gopls/rust-analyzer/clangd…) via which; absence is an honest degrade to the built-in lane, not a failure.\n");
    out.push_str("- debug_breakpoints {\"file\":\"src/app.ts\"} — breakpoint suggestions for a source file: function/graph entry lines (symbol-level confidence) + if/else branch, loop-head and pre-return lines (heuristic confidence), each with a reason. HSL/TS/TSX/PY only.\n");
    out.push_str("- debug_plan {\"file\":\"src/app.ts\"} — a debug plan: ordered steps (attach → entry breakpoints → branch/loop → stack inspection) + protocol-ready DAP message sequence (initialize/setBreakpoints/threads/stackTrace). Real debug-adapter attach is roadmap (honest boundary).\n");
    // v0.5.17 云生态簇（#67/#68/#72/#74 —— 只读三件：探测/模板/注册表，零审批门槛）
    out.push_str("- cloud_probe {} — one-shot cloud ecosystem probe (docker CLI+daemon / ssh / kubectl+cluster / terraform / 10 cloud CLIs). Absence is an honest degrade with install hints + template-lane pointers, never a silent failure.\n");
    out.push_str("- cloud_dockerfile {\"project_type\":\"node\"|\"bun\"|\"python\"|\"rust\"} — production-grade multi-stage Dockerfile template (non-root USER + HEALTHCHECK + pinned tags). The degrade-lane deliverable when docker itself is absent.\n");
    out.push_str("- cloud_clis {} — probe the 10-CLI cloud registry (aws/gcloud/az/gh/vercel/flyctl/railway/heroku/doctl/oci): availability + version + install hint each.\n");
    // v0.5.18 移动端调试簇（#117 —— 只读三件：设备清单/logcat dump/计划，零审批门槛）
    out.push_str("- mobile_devices {} — Android device list via adb devices -l (multi-device / unauthorized / offline honestly listed with per-state guidance; usb:1-1 transport + model/product/device fields) plus the iOS face (idevice_id UDID probe, honest degrade when absent). adb absent = honest tool-absent with install hints, never a failure.\n");
    out.push_str("- mobile_logcat {\"lines\":200,\"tag\":\"chromium\",\"level\":\"E\"?,\"serial\":\"emulator-5554\"?,\"package\":\"com.example.app\"?} — logcat dump snapshot (adb logcat -d -t N, NOT a live tail): five-tuple structured entries (time/pid/level/tag/message), lines clamped 1..2000, tag (-s TAG) / level (*:E floor) / package (pidof→pid filter) lanes. No adb/no device/unauthorized = honest degrade with guidance.\n");
    out.push_str("- mobile_plan {\"platform\":\"android\"|\"ios\"|\"both\",\"symptom\":\"crash\"} — mobile debug plan (pure function, zero external deps, ALWAYS available): platform × symptom matrix (crash/white-screen/network/performance/build/install/webview, CJK keywords tolerated) → ordered steps, each with a pasteable cmd + expected observation + degrade hint. install/uninstall commands live ONLY here as pasteable text, never in any execution lane.\n");
    if mode == ToolMode::Full {
        out.push_str("- fs_write {\"path\":\"...\",\"content\":\"...\",\"preview\":true?} — write a file (may require approval). preview:true returns a unified diff WITHOUT writing (dry-run). Content is scanned for secrets: high-severity key patterns (sk-/ghp_/AKIA… ) are refused — never persist real credentials.\n");
        out.push_str("- fs_edit {\"path\":\"...\",\"old\":\"exact unique text\",\"new\":\"replacement\",\"preview\":true?} — precise edit (may require approval); preview:true returns the diff without writing.\n");
        out.push_str("- fs_move {\"from\":\"a.txt\",\"to\":\"b/c.txt\"} — move/rename files inside the workspace (may require approval).\n");
        out.push_str("- db_migrate {\"file\":\"data/app.db\",\"name\":\"add users\",\"sql\":\"CREATE TABLE …\",\"dry_run\":true?} — versioned schema migration (_org_migrations ledger + companion .migrations.json; dry_run validates then rolls back). Requires approval.\n");
        out.push_str("- audit_export {\"run\":\"out-a\"?} — export the audit trail (events/journal/approvals/llm-ledger) to a zip in the workspace (may require approval).\n");
        out.push_str("- review_suggest {\"files\":[\"lib/a.ts\",\"hsl/org.hsl\"]} — CODEOWNERS-based reviewer recommendation for changed files.\n");
        out.push_str("- git_merge {\"repo\":\".\",\"source\":\"feature-x\",\"message\":\"…\",\"no_ff\":true?} — merge a branch into the current one (repo = workspace-relative git root, default workspace). Conflicts are NEVER auto-resolved: the merge is aborted, workspace restored, conflict list returned. May require approval.\n");
        out.push_str("- git_rebase {\"repo\":\".\",\"onto\":\"main\"} — rebase the current branch onto another branch (same conflict philosophy as git_merge: auto-abort + conflict list). May require approval.\n");
        out.push_str("- plugin_install {\"source\":\"path/or/git-url\"} — transactionally install a plugin (staging → manifest validation → atomic rename; local dir or git URL source; never leaves half-installed state). May require approval.\n");
        out.push_str("- plugin_remove {\"name\":\"my-plugin\"} — remove an installed plugin directory. May require approval.\n");
        out.push_str("- browser_screenshot {\"url\":\"https://example.com\",\"out\":\"shot.png\",\"timeout_ms\":30000?} — full-page screenshot to a PNG in the workspace (out is workspace-relative, default browser-<ts>.png; engine chain as browser_snapshot; PNG magic verified on disk). May require approval.\n");
        out.push_str("- rename_symbol {\"old\":\"startRun\",\"new\":\"startRunV2\",\"dry_run\":true?} — project-wide rename (HSL/TS/PY symbol index; word-boundary line edits; definition+references+mentions). dry_run defaults to true (unified-diff preview, ≤5 files); dry_run:false writes with read→replace→verify per file, stopping at first failure. Refuses: missing definition / target-name clash / invalid identifier. May require approval.\n");
        // v0.5.17 协作簇写动作（发帖/评论 —— 线程文件追加，file_write 门 + 审批在环）
        out.push_str("- collab_post {\"thread\":\"t1\",\"text\":\"finding: … @alice\",\"user\":\"bob\"?} — post to a team thread (append-only JSONL; @user mentions auto-extracted; user defaults to the current collaborator identity). May require approval.\n");
        out.push_str("- collab_comment {\"thread\":\"t1\",\"seq\":3,\"text\":\"agree\",\"user\":\"bob\"?} — comment on a specific post (replyTo tree; same identity semantics as collab_post). May require approval.\n");
        // v0.5.17 云生态簇执行车道（#67/#68/#72 —— process_spawn 门 + 审批在环）
        out.push_str("- cloud_docker {\"args\":[\"ps\",\"-a\"],\"context\":\".\",\"dockerfile\":\"Dockerfile\"?,\"tag\":\"app:1.0.0\"?} — run a whitelisted docker subcommand (16 allowed: version/info/ps/images/build/run/create/start/stop/rm/rmi/logs/inspect/pull/tag/push; destructive ones like system prune are NEVER allowed — refusal happens before any spawn). Array args = zero shell-injection surface; 30s hard timeout. args[0]=\"build\" uses the jailed context/dockerfile/tag fields instead. May require approval.\n");
        out.push_str("- cloud_ssh {\"host\":\"deploy.example.com\",\"command\":\"systemctl status app\"} — run a remote command (host MUST be listed in the workspace ssh-hosts.allow file; absent file = refuse everything). BatchMode=yes + ConnectTimeout=10 + StrictHostKeyChecking=accept-new. Upload form: {host, upload_local, upload_remote} runs scp with the local path jailed to the workspace. May require approval.\n");
        out.push_str("- cloud_k8s {\"args\":[\"get\",\"pods\",\"-n\",\"prod\"]} — run a whitelisted kubectl subcommand (get/describe/apply/logs/rollout/top/config…; delete/edit/scale/exec are NEVER allowed). apply -f paths are jailed to the workspace; -f - (stdin) is refused. May require approval.\n");
        out.push_str("- shell_run {\"cmd\":\"git status\"} — run an allowlisted command (may require approval)\n");
        out.push_str("- agent_spawn {\"goal\":\"...\",\"mode\":\"run\"|\"ask\",\"expert\":\"name\",\"reuse\":false?} — spawn a sub-organization (team mission via org run, or direct expert via org ask). Depth+budget governed recursion (child budget halves each level); similar goals hit the spawn pool and are REUSED at zero cost (pass reuse:false to force a fresh spawn). Use it ONLY when the task genuinely needs multi-step decomposition or another expert's specialty; for trivial lookups use fs_read/fs_list first. The child inherits your model lane.\n");
        out.push_str("- audio_compose {\"timbre\":\"strings\",\"chords\":\"D3:canon:arp\",\"tempo\":90} — compose from chord progression + timbre (8 instruments: piano/strings/flute/organ/harpsichord/music-box/guitar/bell; 7 progressions: canon/pop/epic/circle/jazz/blues/romance); or explicit notes [{\"freq\":261.63,\"start_beat\":0,\"beats\":1}]. Engine renders playable .wav + .mid alongside your reply (deliverable = audio, not sheet).\n");
    }
    out.push_str("After a tool call you will receive a <tool_result> message; use it and continue. When you have the final answer, reply WITHOUT any <tool> tags.\n");
    out
}

/// 解析模型回复中的工具调用。多形态宽容（实测真实模型的标记形态多样）：
///   1. 规范形态：<tool>JSON</tool>
///   2. 混合未闭合（deepseek-flash 实测）：开标签 <tool>，闭标签吐成
///      </｜｜DSML｜｜ parameter> 之类原生标记 —— 花括号配平提取 JSON
///   3. 纯 DSML 块：<｜｜DSML｜｜ invoke> 后跟 {"name":...,"args":{...}}
/// 坏 JSON 跳过不炸整轮（模型下轮会被结果消息纠正）。
export fn parse_tool_calls(raw: String) -> Vec<ToolCall> {
    let out: Vec<ToolCall> = native typescript {
        const calls = [];
        const text = String(raw);
        const pushCall = (jsonText) => {
            try {
                const o = JSON.parse(jsonText);
                if (o && typeof o === "object") {
                    const name = String(o.name ?? o.tool ?? "");
                    if (!name) return;
                    let args = {};
                    if (o.args && typeof o.args === "object" && !Array.isArray(o.args)) {
                        args = o.args;
                    } else {
                        for (const k of Object.keys(o)) {
                            if (k === "name" || k === "tool") continue;
                            args[k] = o[k];
                        }
                    }
                    // $host.make：构造带 __struct 标记的合法 HSL 值（#L-22 官方
                    // 通道 —— clone()/方法派发在 HSL 侧可用）
                    calls.push($host.make("ToolCall", { name: name, args_json: JSON.stringify(args) }));
                }
            } catch (e) {
                // 坏 JSON：跳过（模型下轮会被结果消息纠正）
            }
        };
        // 1) 规范形态：<tool>JSON</tool>
        const re = /<tool>\s*([\s\S]*?)\s*<\/tool>/g;
        let m;
        while ((m = re.exec(text)) !== null) pushCall(m[1]);
        // 2) 混合未闭合：<tool> 开标签 + 任意闭标签（或无闭标签）—— 花括号
        //    配平提取（字符串感知：忽略引号内的花括号）
        if (calls.length === 0 && text.indexOf("<tool>") >= 0) {
            let idx = text.indexOf("<tool>");
            while (idx >= 0) {
                const start = text.indexOf("{", idx);
                if (start >= 0) {
                    let depth = 0, inStr = false, esc = false, end = -1;
                    for (let i = start; i < text.length; i++) {
                        const ch = text[i];
                        if (esc) { esc = false; continue; }
                        if (ch === "\\") { esc = true; continue; }
                        if (ch === '"') { inStr = !inStr; continue; }
                        if (inStr) continue;
                        if (ch === "{") depth++;
                        else if (ch === "}") { depth--; if (depth === 0) { end = i; break; } }
                    }
                    if (end > start) pushCall(text.slice(start, end + 1));
                }
                idx = text.indexOf("<tool>", idx + 6);
            }
        }
        // 3) 纯 DSML 块：DSML 标记后跟 {"name":...} JSON（deepseek 原生工具调用标记）
        if (calls.length === 0) {
            const re2 = /(?:<｜｜DSML｜｜|<\/｜｜DSML｜｜)[^>]*>\s*(\{[\s\S]*?\})\s*(?:<\/｜｜DSML｜｜|$)/g;
            while ((m = re2.exec(text)) !== null) pushCall(m[1]);
        }
        return calls;
    };
    out
}

/// 工具结果回灌消息（对话里的 user 消息形态）。
export fn tool_result_message(results_json: String) -> String {
    format!("<tool_result>{}</tool_result>\n继续。根据以上工具结果作答；如仍需工具，继续用 <tool> 格式调用；已有最终答案则直接回答（不要带 <tool> 标记）。", results_json)
}

/// 执行一次工具调用（能力门 + $host 执行 + 事件上总线）。
/// 返回 JSON 结果字符串（执行体与错误都以 JSON 回灌 —— 模型可自纠）。
export async fn execute_tool(policy: CapabilityPolicy, call: ToolCall) -> String {
    let args: String = call.args_json.clone();
    let name = call.name.clone();

    // v0.5.16 RBAC 可选门控（最外层治理）：ORG_RBAC_ROLE 未设 = 完全不启用
    // （零行为回归）；设了 → lib/rbac.ts 判定 tool:<name>，拒绝时返回工具错误
    // （含 rule 与 reason）并落审计（rbac_gate_tool 内部：journal rbac_denied
    // 事件 + runtime/rbac.jsonl 决策账本）。放行静默（不刷屏审计面）。
    let rbac_denied: String = rbac_gate_tool(name.clone()).await;
    if rbac_denied != String::new() {
        emit_tool(String::from("tool_denied"), format!("{} rbac", name));
        return json_ok(name.clone(), false, rbac_denied.clone());
    }

    // 能力门（读 = Auto；写/执行 = Confirm → 审批队列或明确拒绝；
    // v0.5.6：agent_spawn / audio_compose 为编排/产物增强动作，Full 模式即门）
    if name == String::from("agent_spawn") || name == String::from("audio_compose") {
        let mode = tool_mode();
        if mode != ToolMode::Full {
            emit_tool(String::from("tool_denied"), format!("{} {}", name, "tools read-only"));
            return json_ok(name.clone(), false, String::from("DENIED: 此工具需要完整工具环（ORG_TOOLS=write 开启）。"));
        }
    }
    let gate_cap = match name.as_str() {
        "fs_read" | "fs_list" | "fs_glob" | "semantic_search" => String::from("file_read"),
        "fs_write" | "fs_edit" | "fs_move" | "db_migrate" | "audit_export" => String::from("file_write"),
        "shell_run" => String::from("process_spawn"),
        "agent_spawn" | "audio_compose" => String::from("agent_spawn"),
        // v0.5.16：git/插件/截图/重命名都是工作区写动作（file_write 门 + 审批在环）
        "git_merge" | "git_rebase" | "plugin_install" | "plugin_remove" | "browser_screenshot" | "rename_symbol" => String::from("file_write"),
        // v0.5.17：协作发帖/评论是工作区写动作（线程文件追加 —— file_write 门 + 审批在环）
        "collab_post" | "collab_comment" => String::from("file_write"),
        // v0.5.17 云生态簇：docker/ssh/kubectl 执行车道（外部子进程 —— process_spawn
        // 门 + 审批在环；白名单拒绝发生在门与 spawn 之前，lib/cloud.ts 内部先判）
        "cloud_docker" | "cloud_ssh" | "cloud_k8s" => String::from("process_spawn"),
        _ => String::from("file_read"), // v0.5.15：db_schema/db_query（只读门内建）/symbol_search/read_pdf/review_suggest 均只读
    };
    // 写门例外清单（只读工具 + agent_spawn/audio_compose 自带门）：v0.5.15 新增
    // db_schema/db_query（lib/db.ts 只读门双层：词法白名单 + readonly 连接）、
    // symbol_search/read_pdf/review_suggest（纯读）；v0.5.16 新增 db_diagnose（EQP
    // 只读通道 + 词法门）/rbac_check/iac_scan/openapi_parse/plugin_list（纯查询）/
    // browser_snapshot（导航只读）/complete_at（纯索引查询）；v0.5.17 新增
    // collab_threads/collab_feed/collab_summary（协作线程纯查询）+ cloud_probe/
    // cloud_dockerfile/cloud_clis（云生态探测/模板/注册表 —— 纯读零副作用）+
    // v0.5.18 新增 mobile_devices/mobile_logcat/mobile_plan（移动端调试簇 ——
    // adb 探测/logcat -d dump 快照/计划纯函数，全只读零写副作用；工具缺席在
    // lib/mobile.ts 内部诚实降级，不触碰任何门）。
    if name != String::from("fs_read") && name != String::from("fs_list") && name != String::from("fs_glob")
        && name != String::from("semantic_search")
        && name != String::from("agent_spawn") && name != String::from("audio_compose")
        && name != String::from("symbol_search") && name != String::from("db_schema")
        && name != String::from("db_query") && name != String::from("read_pdf")
        && name != String::from("review_suggest")
        && name != String::from("db_diagnose") && name != String::from("rbac_check")
        && name != String::from("iac_scan") && name != String::from("openapi_parse")
        && name != String::from("plugin_list") && name != String::from("browser_snapshot")
        && name != String::from("complete_at")
        && name != String::from("collab_threads") && name != String::from("collab_feed")
        && name != String::from("collab_summary")
        && name != String::from("lsp_definition") && name != String::from("lsp_references")
        && name != String::from("lsp_hover") && name != String::from("lsp_servers")
        && name != String::from("debug_breakpoints") && name != String::from("debug_plan")
        && name != String::from("cloud_probe") && name != String::from("cloud_dockerfile")
        && name != String::from("cloud_clis")
        && name != String::from("mobile_devices") && name != String::from("mobile_logcat")
        && name != String::from("mobile_plan") {
        let approved = gate_write(policy, gate_cap, name.clone(), args.clone()).await;
        if approved == String::from("denied") {
            emit_tool(String::from("tool_denied"), format!("{} {}", name, "capability denied"));
            return json_ok(name.clone(), false, String::from("DENIED: 此工具需要能力授权（file_write/process_spawn）。请改用只读工具，或让用户以 ORG_APPROVAL=1 启动并在面板放行。"));
        }
        if approved == String::from("off") {
            emit_tool(String::from("tool_denied"), format!("{} {}", name, "tools read-only"));
            return json_ok(name.clone(), false, String::from("DENIED: 工具环为只读模式（ORG_TOOLS=write 开启写工具）。"));
        }
    }

    emit_tool(String::from("tool_call"), format!("{} {}", name, preview_args(args.clone())));

    let result: String = match name.as_str() {
        "fs_read" => tool_fs_read(args.clone()),
        "fs_list" => tool_fs_list(args.clone()),
        "fs_glob" => tool_fs_glob(args.clone()),
        "semantic_search" => tool_semantic_search(args.clone()),
        "fs_write" => tool_fs_write(args.clone()),
        "fs_edit" => tool_fs_edit(args.clone()),
        "shell_run" => tool_shell_run(args.clone()),
        "agent_spawn" => tool_agent_spawn(args.clone()).await,
        "audio_compose" => tool_audio_compose(args.clone()),
        "symbol_search" => tool_symbol_search(args.clone()),
        "db_schema" => tool_db_schema(args.clone()),
        "db_query" => tool_db_query(args.clone()),
        "db_migrate" => tool_db_migrate(args.clone()),
        "read_pdf" => tool_read_pdf(args.clone()).await,
        "fs_move" => tool_fs_move(args.clone()),
        "audit_export" => tool_audit_export(args.clone()),
        "review_suggest" => tool_review_suggest(args.clone()),
        // v0.5.16 治理与扩展批（native 块动态 import lib —— 与 CLI/Web 同源）
        "db_diagnose" => tool_db_diagnose(args.clone()).await,
        "git_merge" => tool_git_merge(args.clone()),
        "git_rebase" => tool_git_rebase(args.clone()),
        "rbac_check" => tool_rbac_check(args.clone()),
        "iac_scan" => tool_iac_scan(args.clone()),
        "plugin_list" => tool_plugin_list(args.clone()),
        "plugin_install" => tool_plugin_install(args.clone()),
        "plugin_remove" => tool_plugin_remove(args.clone()),
        "openapi_parse" => tool_openapi_parse(args.clone()),
        "browser_snapshot" => tool_browser_snapshot(args.clone()).await,
        "browser_screenshot" => tool_browser_screenshot(args.clone()).await,
        "complete_at" => tool_complete_at(args.clone()).await,
        "rename_symbol" => tool_rename_symbol(args.clone()).await,
        // v0.5.17 协作簇（native 块动态 import lib —— 与 CLI/Web 同源）
        "collab_threads" => tool_collab_threads(args.clone()),
        "collab_feed" => tool_collab_feed(args.clone()),
        "collab_summary" => tool_collab_summary(args.clone()),
        "collab_post" => tool_collab_post(args.clone()),
        "collab_comment" => tool_collab_comment(args.clone()),
        // v0.5.17 LSP/DAP 深度簇（native 块动态 import lib —— 与 CLI/Web 同源）
        "lsp_definition" => tool_lsp_definition(args.clone()).await,
        "lsp_references" => tool_lsp_references(args.clone()).await,
        "lsp_hover" => tool_lsp_hover(args.clone()).await,
        "lsp_servers" => tool_lsp_servers(args.clone()).await,
        "debug_breakpoints" => tool_debug_breakpoints(args.clone()).await,
        "debug_plan" => tool_debug_plan(args.clone()).await,
        // v0.5.17 云生态簇（native 块动态 import lib/cloud.ts —— 与 CLI/Web 同源）
        "cloud_probe" => tool_cloud_probe(args.clone()),
        "cloud_dockerfile" => tool_cloud_dockerfile(args.clone()),
        "cloud_clis" => tool_cloud_clis(args.clone()),
        "cloud_docker" => tool_cloud_docker(args.clone()),
        "cloud_ssh" => tool_cloud_ssh(args.clone()),
        "cloud_k8s" => tool_cloud_k8s(args.clone()),
        // v0.5.18 移动端调试簇（native 块动态 import lib/mobile.ts —— 与 CLI/Web 同源）
        "mobile_devices" => tool_mobile_devices(args.clone()),
        "mobile_logcat" => tool_mobile_logcat(args.clone()),
        "mobile_plan" => tool_mobile_plan(args.clone()),
        _ => json_ok(name.clone(), false, format!("未知工具 {}（可用：fs_read/fs_list/fs_glob/semantic_search/symbol_search/db_schema/db_query/db_diagnose/read_pdf/fs_write/fs_edit/fs_move/db_migrate/git_merge/git_rebase/rbac_check/iac_scan/openapi_parse/plugin_list/plugin_install/plugin_remove/browser_snapshot/browser_screenshot/complete_at/rename_symbol/collab_threads/collab_feed/collab_summary/collab_post/collab_comment/lsp_definition/lsp_references/lsp_hover/lsp_servers/debug_breakpoints/debug_plan/cloud_probe/cloud_dockerfile/cloud_clis/cloud_docker/cloud_ssh/cloud_k8s/mobile_devices/mobile_logcat/mobile_plan/shell_run/agent_spawn/audio_compose/audit_export/review_suggest）", name)),
    };
    emit_tool(String::from("tool_result"), result_summary(result.clone()));
    result
}

// ---- 能力门 -------------------------------------------------------------------

/// 写类工具的门：审批队列（人在环）优先；未开审批 → 明确拒绝。
/// 返回 "granted" / "denied" / "off"（只读模式）。
async fn gate_write(policy: CapabilityPolicy, capability: String, tool: String, args: String) -> String {
    // 只读模式直接拦截（工具清单都没给，模型一般不会调；调了也给明确反馈）
    let mode = tool_mode();
    if mode != ToolMode::Full {
        return String::from("off");
    }
    // 审批队列开启：走文件协议（org web / taskd / CLI approvals 都能放行）
    let approval_enabled: bool = native typescript {
        const v = String($host.env.get("ORG_APPROVAL") || "").trim().toLowerCase();
        return v === "1" || v === "on" || v === "queue";
    };
    if approval_enabled {
        let decision = request_approval(capability.clone(), format!("tool:{}", tool), preview_args(args.clone())).await;
        let outcome = match decision {
            ApprovalOutcome::Allowed => String::from("granted"),
            ApprovalOutcome::Denied => String::from("denied"),
            ApprovalOutcome::NotQueued => String::from("denied"),
        };
        return outcome;
    }
    // 未开审批：用户不在环 —— 拒绝（安全缺省；direct 模式 v0.4.x 的「confirm
    // 就地放行」仅覆盖 llm_call，写文件/执行命令不能静默放行）
    let _ = policy.decide(capability.clone(), AccessMode::Direct);
    String::from("denied")
}

/// v0.5.16 RBAC 工具门（可选启用，execute_tool 的最外层治理）：
/// ORG_RBAC_ROLE 未设 → 返回空串（门控完全不启用 —— 零行为回归，单机
/// 缺省 owner 全放行）；设了 → lib/rbac.ts loadRbac + rbacCheck
/// （动作命名空间 tool:<name>），拒绝时返回 DENIED 文案（含 rule 与
/// reason），并落两处审计：journal rbac_denied 事件（events.jsonl/
/// journal.jsonl 可观测）+ runtime/rbac.jsonl 决策账本（rbacDecisionLog
/// 单行 JSONL，账本写失败不拦拒绝语义）。放行静默（不刷屏审计面）。
async fn rbac_gate_tool(name: String) -> String {
    let n = name.clone();
    let verdict: String = native typescript {
        try {
            const role = String($host.env.get("ORG_RBAC_ROLE") || "").trim();
            if (!role) return ""; // 未设 = 门控不启用（零行为回归）
            const action = "tool:" + n;
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return "DENIED (RBAC): org 根目录未定位，策略无法加载 —— 拒绝执行（安全缺省；需经 org 宿主启动）";
            const pathMod = await import("node:path");
            const fsMod = await import("node:fs");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const rbac = await import(root + "/lib/rbac.ts");
            const loaded = rbac.loadRbac(ws);
            const decision = rbac.rbacCheck(loaded.policy, role, action);
            if (decision.allowed) return "";
            // 审计 ①：journal 事件（events.jsonl / journal.jsonl 同步可观测）
            $host.events.emit("journal", { name: "rbac_denied", detail: (action + " " + decision.rule + " " + String(decision.reason || "")).slice(0, 300) });
            // 审计 ②：决策账本 runtime/rbac.jsonl（单行 JSONL；失败不拦拒绝语义）
            try {
                const dir = pathMod.join(ws, "runtime");
                fsMod.mkdirSync(dir, { recursive: true });
                fsMod.appendFileSync(pathMod.join(dir, "rbac.jsonl"), rbac.rbacDecisionLog(decision) + "\n", "utf8");
            } catch (e2) { /* 账本失败不影响拒绝 */ }
            return "DENIED (RBAC): " + action + " 被拒 —— rule=" + decision.rule + "；" + String(decision.reason || "") + "（角色 " + role + "；策略 " + (loaded.file || "内建兜底") + "）";
        } catch (e) {
            return "DENIED (RBAC): 门控评估异常（" + String(e && e.message || e) + "）—— 拒绝执行（安全缺省）";
        }
    };
    verdict
}

// ---- 工具执行体（$host ABI 直通；全部带界与容错） -----------------------------

/// v0.5.15 符号定义/引用（capabilities #20）：lib/symbols.ts 动态 import（同源）。
/// 只读工具（file_read 能力，ReadOnly 模式可用）。
fn tool_symbol_search(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const name = String(a.name || a.symbol || "");
            const wantRefs = a.refs !== false;
            if (!name) return JSON.stringify({ tool: "symbol_search", ok: false, error: "args.name 必填" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "symbol_search", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const mod = await import(root + "/lib/symbols.ts");
            const pathMod = await import("node:path");
            const wsRaw0 = String($host.config.workspace || ".").replace(/\\/g, "/");
            const wsAbs = pathMod.isAbsolute(wsRaw0) ? wsRaw0 : pathMod.resolve(process.cwd(), wsRaw0);
            const idx = mod.indexSymbols(wsAbs, [""]); // v0.5.15：工作区根扫描（runtime/out-* 已排除）
            const defs = mod.lookupDef(idx.symbols, name, a.substring !== true);
            const out = { tool: "symbol_search", ok: true, name, defs: defs.slice(0, 20).map((d) => ({ kind: d.kind, file: d.file, line: d.line })) };
            if (wantRefs) {
                const refs = mod.findRefs(wsAbs, name, { dirs: [""], maxHits: 50 });
                out.refs = refs.map((r) => ({ kind: r.kind, file: r.file, line: r.line, snippet: String(r.snippet || "").slice(0, 100) }));
            }
            return JSON.stringify(out);
        } catch (e) {
            return JSON.stringify({ tool: "symbol_search", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.15 SQLite schema 检查（capabilities #43 读半环）：lib/db.ts 动态 import。
/// 工作区路径监狱 + 只读连接（lib 内建）。只读工具。
fn tool_db_schema(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const file = String(a.file || a.db || "");
            if (!file) return JSON.stringify({ tool: "db_schema", ok: false, error: "args.file 必填（工作区相对路径或 :memory:）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "db_schema", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const guard = await (async () => {
                try {
                    if (file === ":memory:") return { jail: true, path: ":memory:" };
                    const pathMod = await import("node:path");
                    const fsMod = await import("node:fs");
                    const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
                    const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
                    const wsReal = fsMod.realpathSync(ws);
                    const lexical = pathMod.isAbsolute(file) ? file.replace(/\\/g, "/") : pathMod.resolve(wsReal, file);
                    const jail = await import(root + "/lib/pathjail.ts"); // v0.5.16.1：win32 混合分隔符收敛（CI run 35367288947 修复）
                    const inWs = (p) => jail.inWorkspace(wsReal, p);
                    // 第一层：词法判定先行（../ 逃逸在此拦截 —— 即便父目录不存在也能判）
                    if (!inWs(lexical)) return { jail: false, error: "路径越界（须在工作区内）：" + file };
                    // 第二层：符号链实解析（父目录不存在 = 新建文件场景，词法判定已过则降级放行）
                    try {
                        const parent = fsMod.realpathSync(pathMod.dirname(lexical));
                        const resolved = pathMod.join(parent, pathMod.basename(lexical));
                        if (!inWs(resolved)) return { jail: false, error: "路径越界（符号链逃逸）：" + file };
                        return { jail: true, path: resolved };
                    } catch (e2) { return { jail: true, path: lexical }; }
                } catch (e) { return { jail: false, error: String(e && e.message || e) }; }
            })();
            if (!guard.jail) return JSON.stringify({ tool: "db_schema", ok: false, error: guard.error });
            const db = await import(root + "/lib/db.ts");
            const s = db.dbSchema(guard.path);
            if (s.missing) return JSON.stringify({ tool: "db_schema", ok: false, error: "库文件不存在或不可读：" + file });
            return JSON.stringify({
                tool: "db_schema", ok: true, file,
                tables: s.tables.map((t) => ({ name: t.name, rows: t.rowCount, columns: t.columns.map((c) => c.name + (c.pk ? " PK" : "")) })),
                indexes: s.indexes, views: s.views,
            });
        } catch (e) {
            return JSON.stringify({ tool: "db_schema", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.15 SQLite 只读查询（capabilities #73 查询半环）：lib/db.ts 双层只读门
/// （词法白名单 + readonly 连接）。只读工具 —— 写语句在两层都会被拒。
fn tool_db_query(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const file = String(a.file || a.db || "");
            const sql = String(a.sql || a.query || "");
            if (!file || !sql) return JSON.stringify({ tool: "db_query", ok: false, error: "args.file/args.sql 必填" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "db_query", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const guard = await (async () => {
                try {
                    if (file === ":memory:") return { jail: true, path: ":memory:" };
                    const pathMod = await import("node:path");
                    const fsMod = await import("node:fs");
                    const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
                    const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
                    const wsReal = fsMod.realpathSync(ws);
                    const lexical = pathMod.isAbsolute(file) ? file.replace(/\\/g, "/") : pathMod.resolve(wsReal, file);
                    const jail = await import(root + "/lib/pathjail.ts"); // v0.5.16.1：win32 混合分隔符收敛（CI run 35367288947 修复）
                    const inWs = (p) => jail.inWorkspace(wsReal, p);
                    // 第一层：词法判定先行（../ 逃逸在此拦截 —— 即便父目录不存在也能判）
                    if (!inWs(lexical)) return { jail: false, error: "路径越界（须在工作区内）：" + file };
                    // 第二层：符号链实解析（父目录不存在 = 新建文件场景，词法判定已过则降级放行）
                    try {
                        const parent = fsMod.realpathSync(pathMod.dirname(lexical));
                        const resolved = pathMod.join(parent, pathMod.basename(lexical));
                        if (!inWs(resolved)) return { jail: false, error: "路径越界（符号链逃逸）：" + file };
                        return { jail: true, path: resolved };
                    } catch (e2) { return { jail: true, path: lexical }; }
                } catch (e) { return { jail: false, error: String(e && e.message || e) }; }
            })();
            if (!guard.jail) return JSON.stringify({ tool: "db_query", ok: false, error: guard.error });
            const db = await import(root + "/lib/db.ts");
            const limit = Math.max(1, Math.min(200, Math.floor(Number(a.limit) || 50)));
            const r = db.dbQuery(guard.path, sql, { limit });
            if (!r.ok) return JSON.stringify({ tool: "db_query", ok: false, kind: r.kind, error: r.error });
            const res = r.result;
            return JSON.stringify({
                tool: "db_query", ok: true, columns: res.columns,
                rows: res.rows.slice(0, limit).map((row) => row.map((c) => (c === null ? null : String(c).slice(0, 256)))),
                row_count: res.rowCount, truncated: res.truncated, ms: res.ms,
            });
        } catch (e) {
            return JSON.stringify({ tool: "db_query", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.15 SQLite 版本化迁移（capabilities #43/#73 写半环）：Full 模式 + 审批在环。
/// dry_run = 事务跑完即回滚（真正验证 SQL 可执行但不落盘）。
fn tool_db_migrate(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const file = String(a.file || a.db || "");
            const sql = String(a.sql || "");
            const name = String(a.name || ("migration-" + Date.now().toString(36)));
            const dryRun = a.dry_run === true;
            if (!file || !sql) return JSON.stringify({ tool: "db_migrate", ok: false, error: "args.file/args.sql 必填" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "db_migrate", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const guard = await (async () => {
                try {
                    if (file === ":memory:") return { jail: true, path: ":memory:" };
                    const pathMod = await import("node:path");
                    const fsMod = await import("node:fs");
                    const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
                    const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
                    const wsReal = fsMod.realpathSync(ws);
                    const lexical = pathMod.isAbsolute(file) ? file.replace(/\\/g, "/") : pathMod.resolve(wsReal, file);
                    const jail = await import(root + "/lib/pathjail.ts"); // v0.5.16.1：win32 混合分隔符收敛（CI run 35367288947 修复）
                    const inWs = (p) => jail.inWorkspace(wsReal, p);
                    // 第一层：词法判定先行（../ 逃逸在此拦截 —— 即便父目录不存在也能判）
                    if (!inWs(lexical)) return { jail: false, error: "路径越界（须在工作区内）：" + file };
                    // 第二层：符号链实解析（父目录不存在 = 新建文件场景，词法判定已过则降级放行）
                    try {
                        const parent = fsMod.realpathSync(pathMod.dirname(lexical));
                        const resolved = pathMod.join(parent, pathMod.basename(lexical));
                        if (!inWs(resolved)) return { jail: false, error: "路径越界（符号链逃逸）：" + file };
                        return { jail: true, path: resolved };
                    } catch (e2) { return { jail: true, path: lexical }; }
                } catch (e) { return { jail: false, error: String(e && e.message || e) }; }
            })();
            if (!guard.jail) return JSON.stringify({ tool: "db_migrate", ok: false, error: guard.error });
            const db = await import(root + "/lib/db.ts");
            const r = db.dbApplyMigration(guard.path, name, sql, { dryRun });
            if (!r.ok) return JSON.stringify({ tool: "db_migrate", ok: false, kind: r.kind, error: r.error });
            return JSON.stringify({ tool: "db_migrate", ok: true, version: r.version, name, dry_run: r.dryRun, ms: r.durMs });
        } catch (e) {
            return JSON.stringify({ tool: "db_migrate", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.15 PDF 文本提取（capabilities #24）：lib/pdfread.ts 三层降级链
/// （pdftotext → uv+pypdf → 诚实失败）。只读工具。
async fn tool_read_pdf(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const file = String(a.file || a.path || "");
            if (!file) return JSON.stringify({ tool: "read_pdf", ok: false, error: "args.file 必填" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "read_pdf", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const guard = await (async () => {
                try {
                    if (file === ":memory:") return { jail: true, path: ":memory:" };
                    const pathMod = await import("node:path");
                    const fsMod = await import("node:fs");
                    const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
                    const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
                    const wsReal = fsMod.realpathSync(ws);
                    const lexical = pathMod.isAbsolute(file) ? file.replace(/\\/g, "/") : pathMod.resolve(wsReal, file);
                    const jail = await import(root + "/lib/pathjail.ts"); // v0.5.16.1：win32 混合分隔符收敛（CI run 35367288947 修复）
                    const inWs = (p) => jail.inWorkspace(wsReal, p);
                    // 第一层：词法判定先行（../ 逃逸在此拦截 —— 即便父目录不存在也能判）
                    if (!inWs(lexical)) return { jail: false, error: "路径越界（须在工作区内）：" + file };
                    // 第二层：符号链实解析（父目录不存在 = 新建文件场景，词法判定已过则降级放行）
                    try {
                        const parent = fsMod.realpathSync(pathMod.dirname(lexical));
                        const resolved = pathMod.join(parent, pathMod.basename(lexical));
                        if (!inWs(resolved)) return { jail: false, error: "路径越界（符号链逃逸）：" + file };
                        return { jail: true, path: resolved };
                    } catch (e2) { return { jail: true, path: lexical }; }
                } catch (e) { return { jail: false, error: String(e && e.message || e) }; }
            })();
            if (!guard.jail) return JSON.stringify({ tool: "read_pdf", ok: false, error: guard.error });
            const pdf = await import(root + "/lib/pdfread.ts");
            const maxPages = Math.max(1, Math.min(200, Math.floor(Number(a.max_pages || a.maxPages) || 30)));
            const r = await pdf.readPdf(guard.path, { maxPages, maxChars: 128 * 1024 });
            if (!r.ok) return JSON.stringify({ tool: "read_pdf", ok: false, error: r.error, hint: r.hint });
            return JSON.stringify({ tool: "read_pdf", ok: true, engine: r.engine, pages: r.pages, ms: r.ms, text: String(r.text || "").slice(0, 32768) });
        } catch (e) {
            return JSON.stringify({ tool: "read_pdf", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.15 文件移动/重命名（capabilities #52）：Full 模式 + 审批在环 + 工作区监狱。
/// node:fs.renameSync 直通（$host.fs 无 move 原语），jail 判定与 realpath 实解析。
fn tool_fs_move(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const from = String(a.from || a.src || "");
            const to = String(a.to || a.dst || "");
            if (!from || !to) return JSON.stringify({ tool: "fs_move", ok: false, error: "args.from/args.to 必填" });
            const pathMod = await import("node:path");
            const fsMod = await import("node:fs");
            const norm = (s) => String(s || "").replace(/\\/g, "/");
            const wsRaw = norm(String($host.config.workspace || "."));
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const wsReal = fsMod.realpathSync(ws);
            // v0.5.16.1：监狱判定单点收敛（pathjail）+ DHV_TS 缺席时内联同形回退（fs_move 是唯一不依赖 org 根的工具，保持零硬依赖）
            const jail = (() => {
                const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/");
                const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/);
                return m ? import(m[1] + "/lib/pathjail.ts") : Promise.resolve({ inWorkspace: (w, p) => { const c = (s) => { const n = String(s).replace(/\\/g, "/"); return process.platform === "win32" ? n.toLowerCase() : n; }; const wc = c(w); return c(p) === wc || c(p).startsWith(wc + "/"); } });
            })();
            const jailMod = await jail;
            const inWs = (p) => jailMod.inWorkspace(wsReal, p);
            const resolveIn = (p) => {
                const lexical = pathMod.isAbsolute(p) ? norm(p) : pathMod.resolve(wsReal, p);
                if (!inWs(lexical)) throw new Error("路径越界（须在工作区内）：" + p);
                try {
                    const parent = fsMod.realpathSync(pathMod.dirname(lexical));
                    return pathMod.join(parent, pathMod.basename(lexical));
                } catch (e2) { return lexical; } // 父目录不存在（新建场景）：词法判定已过
            };
            const src = resolveIn(from);
            const dst = resolveIn(to);
            if (!fsMod.existsSync(src)) return JSON.stringify({ tool: "fs_move", ok: false, error: "源不存在：" + from });
            // 防自嵌套：把目录移进自己的子目录会 EINVAL/EBUSY —— 前置友好报错
            if (dst.startsWith(src + pathMod.sep)) return JSON.stringify({ tool: "fs_move", ok: false, error: "不能把目录移动到自身内部" });
            fsMod.mkdirSync(pathMod.dirname(dst), { recursive: true });
            fsMod.renameSync(src, dst);
            return JSON.stringify({ tool: "fs_move", ok: true, from, to });
        } catch (e) {
            return JSON.stringify({ tool: "fs_move", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.15 审计导出（capabilities #150）：lib/audit.ts 同源（events/journal/
/// 审批台账/llm-ledger → 零依赖 zip + markdown 摘要）。写动作（落 zip）→ 审批在环。
fn tool_audit_export(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "audit_export", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const norm = (s) => String(s || "").replace(/\\/g, "/");
            const wsRaw = norm(String($host.config.workspace || "."));
            const pathMod = await import("node:path");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const audit = await import(root + "/lib/audit.ts");
            const r = audit.exportAudit(ws, a.run ? { run: String(a.run) } : {});
            if (!r.ok) return JSON.stringify({ tool: "audit_export", ok: false, error: (r.warnings || []).join("; ") });
            return JSON.stringify({ tool: "audit_export", ok: true, zip: pathMod.basename(r.zip), entries: r.entries, bytes: r.bytes, report: pathMod.basename(r.report) });
        } catch (e) {
            return JSON.stringify({ tool: "audit_export", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.15 评审人推荐（capabilities #85/#89）：lib/owners.ts 同源
/// （CODEOWNERS 后规则覆盖 + 无文件时目录启发式降级）。只读工具。
fn tool_review_suggest(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const files = Array.isArray(a.files) ? a.files.map(String).filter(Boolean) : [];
            if (files.length === 0) return JSON.stringify({ tool: "review_suggest", ok: false, error: "args.files 必填（变更文件清单）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "review_suggest", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const norm = (s) => String(s || "").replace(/\\/g, "/");
            const wsRaw = norm(String($host.config.workspace || "."));
            const pathMod = await import("node:path");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const owners = await import(root + "/lib/owners.ts");
            const r = owners.recommendReviewers(ws, files.slice(0, 100));
            return JSON.stringify({
                tool: "review_suggest", ok: true, from_codeowners: r.fromCodeowners,
                fallback_reason: r.fallbackReason || undefined,
                reviewers: r.reviewers.map((x) => ({ name: x.name, files_covered: x.filesCovered, reason: x.reason })),
            });
        } catch (e) {
            return JSON.stringify({ tool: "review_suggest", ok: false, error: String(e && e.message || e) });
        }
    }
}

