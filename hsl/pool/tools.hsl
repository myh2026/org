            if (!jail.inWorkspace(ws, abs)) return JSON.stringify({ tool: "debug_plan", ok: false, error: "路径越界（须在工作区内）：" + file });
            const debug = await import(root + "/lib/debug.ts");
            const r = debug.debugPlan(ws, file);
            return JSON.stringify({
                tool: "debug_plan", ok: r.ok, ...(r.reason ? { reason: r.reason } : {}),
                file: r.file, language: r.language, suggestions: r.suggestions,
                steps: r.steps.map((st) => ({ step: st.step, title: st.title, detail: st.detail.slice(0, 500), ...(st.breakpoints ? { breakpoints: st.breakpoints.map((s) => ({ line: s.line, kind: s.kind, reason: s.reason, confidence: s.confidence })) } : {}) })),
                dap_messages: r.dapMessages,
                roadmap: "真 debug adapter attach（node --inspect / debugpy / lldb-dap）是路线图 —— 本计划交付协议就绪的消息序列与步骤说明",
            });
        } catch (e) {
            return JSON.stringify({ tool: "debug_plan", ok: false, error: String(e && e.message || e) });
        }
    }
}

// ---- v0.5.17 协作簇：5 工具（capabilities #87 团队共享会话/评论） ---------------
// lib/collab.ts 同源（append-only JSONL 团队线程 + 回复树 + @mention + 身份）。
// collab_threads/collab_feed/collab_summary 只读（ReadOnly 模式可用）；
// collab_post/collab_comment 是工作区写动作（file_write 门 + 审批在环）。

fn tool_collab_threads(args: String) -> String {
    native typescript {
        try {
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "collab_threads", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const collab = await import(root + "/lib/collab.ts");
            const threads = collab.listThreads(ws);
            const s = collab.collabSummary(ws);
            return JSON.stringify({
                tool: "collab_threads", ok: true,
                threads: threads.slice(0, 50).map((t) => ({
                    id: t.id, title: t.title, posts: t.posts, comments: t.comments,
                    participants: t.participants, last_active: t.lastActive,
                })),
                summary: { threads: s.threads, posts: s.posts, comments: s.comments, users: s.users, ...(s.lastActive ? { last_active: s.lastActive } : {}) },
                ...(threads.length > 50 ? { truncated: true } : {}),
            });
        } catch (e) {
            return JSON.stringify({ tool: "collab_threads", ok: false, error: String(e && e.message || e) });
        }
    }
}

fn tool_collab_feed(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const thread = String(a.thread || a.id || "");
            if (!thread) return JSON.stringify({ tool: "collab_feed", ok: false, error: "args.thread 必填（线程 id）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "collab_feed", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const collab = await import(root + "/lib/collab.ts");
            const sinceSeq = a.since_seq != null ? Math.max(0, Math.floor(Number(a.since_seq) || 0)) : 0;
            const feed = collab.threadFeed(ws, thread, { sinceSeq });
            const flat = collab.flattenThread(feed.posts).slice(0, 100);
            const users = [...new Set(feed.posts.map((p) => p.user))];
            return JSON.stringify({
                tool: "collab_feed", ok: true, thread: thread, since_seq: sinceSeq,
                posts: flat.map((p) => ({
                    seq: p.seq, user: p.user, kind: p.kind, depth: p.depth,
                    ...(p.replyTo !== undefined ? { reply_to: p.replyTo } : {}),
                    ...(p.mentions && p.mentions.length ? { mentions: p.mentions } : {}),
                    text: String(p.text).slice(0, 500), at: p.at,
                })),
                counts: { posts: feed.posts.length, comments: feed.posts.filter((p) => p.kind === "comment").length, users: users.length },
                ...(feed.truncated ? { truncated: true } : {}),
                ...(flat.length < collab.flattenThread(feed.posts).length ? { posts_truncated: true } : {}),
            });
        } catch (e) {
            return JSON.stringify({ tool: "collab_feed", ok: false, error: String(e && e.message || e) });
        }
    }
}

fn tool_collab_summary(args: String) -> String {
    native typescript {
        try {
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "collab_summary", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
