fn tool_plugin_install(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const source = String(a.source || a.url || a.dir || "");
            if (!source) return JSON.stringify({ tool: "plugin_install", ok: false, error: "args.source 必填（本地插件目录或 git URL）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "plugin_install", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const plugins = await import(root + "/lib/plugins.ts");
            // git 源（协议 URL）原样透传；本地源解析进工作区（监狱：源须在 ws 内）
            const isGit = /^(?:https?|git|ssh|file):\/\//i.test(source) || /^git@[\w.-]+:[\w./-]+/i.test(source);
            const resolved = isGit ? source : pathMod.resolve(ws, source);
            const jail = await import(root + "/lib/pathjail.ts"); // v0.5.16.1：win32 混合分隔符收敛
            if (!isGit && !jail.inWorkspace(ws, resolved)) {
                return JSON.stringify({ tool: "plugin_install", ok: false, error: "路径越界（本地源须在工作区内）：" + source });
            }
            const r = plugins.pluginInstall(ws, resolved);
            if (!r.ok) return JSON.stringify({ tool: "plugin_install", ok: false, kind: r.kind, error: r.error });
            return JSON.stringify({ tool: "plugin_install", ok: true, name: r.name, version: r.version, path: ".org/plugins/" + r.name, warnings: r.warnings });
        } catch (e) {
            return JSON.stringify({ tool: "plugin_install", ok: false, error: String(e && e.message || e) });
        }
    }
}

fn tool_plugin_remove(args: String) -> String {
