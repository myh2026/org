fn tool_collab_post(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const thread = String(a.thread || a.id || "");
            const text = String(a.text || a.message || "");
            if (!thread || !text.trim()) return JSON.stringify({ tool: "collab_post", ok: false, error: "args.thread/args.text 必填" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "collab_post", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const collab = await import(root + "/lib/collab.ts");
            // 署名：args.user 显式覆盖 > 当前协作用户（身份文件/env）
            const user = a.user != null && String(a.user) !== "" ? String(a.user) : collab.currentUser(ws).user;
            const r = collab.postThread(ws, thread, user, text);
            return JSON.stringify({ tool: "collab_post", ok: true, thread: thread, seq: r.seq, user: user, mentions: r.mentions });
        } catch (e) {
            return JSON.stringify({ tool: "collab_post", ok: false, error: String(e && e.message || e) });
        }
    }
}

fn tool_collab_comment(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const thread = String(a.thread || a.id || "");
            const seqRaw = a.seq != null ? Number(a.seq) : NaN;
            const text = String(a.text || a.message || "");
            if (!thread || !text.trim() || !Number.isInteger(seqRaw)) return JSON.stringify({ tool: "collab_comment", ok: false, error: "args.thread/args.seq/args.text 必填" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "collab_comment", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const collab = await import(root + "/lib/collab.ts");
            const user = a.user != null && String(a.user) !== "" ? String(a.user) : collab.currentUser(ws).user;
            const r = collab.commentOn(ws, thread, seqRaw, user, text);
            return JSON.stringify({ tool: "collab_comment", ok: true, thread: thread, seq: r.seq, reply_to: seqRaw, user: user, mentions: r.mentions });
        } catch (e) {
            return JSON.stringify({ tool: "collab_comment", ok: false, error: String(e && e.message || e) });
        }
    }
}

// ---- v0.5.17 云生态簇：6 工具（capabilities #67/#68/#72/#74） --------------------
// lib/cloud.ts 同源（多重优雅降级：探测 → 白名单真实车道 → 模板/计划降级 →
// 诚实拒绝）。cloud_probe/cloud_dockerfile/cloud_clis 只读（ReadOnly 可用）；
// cloud_docker/cloud_ssh/cloud_k8s 是执行车道（process_spawn 门 + 审批在环）。
// 路径监狱：docker build context/Dockerfile、scp local、kubectl apply -f 全过
// lib/pathjail.ts（v0.5.16.1 比较形单点收敛）。

/// 云生态全景探测（五键：docker/ssh/k8s/terraform/clis）。只读。
fn tool_cloud_probe(args: String) -> String {
    native typescript {
        try {
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "cloud_probe", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const cloud = await import(root + "/lib/cloud.ts");
            const r = cloud.cloudProbeAll();
            return JSON.stringify({
                tool: "cloud_probe", ok: true, took_ms: r.tookMs,
                docker: { available: r.docker.available, version: r.docker.version, daemon_reachable: r.docker.daemonReachable, ...(r.docker.reason ? { reason: r.docker.reason } : {}) },
                ssh: { available: r.ssh.available, version: r.ssh.version, ssh_dir: r.ssh.sshDirExists, config: r.ssh.configExists, known_hosts: r.ssh.knownHostsExists, ...(r.ssh.reason ? { reason: r.ssh.reason } : {}) },
                k8s: { available: r.k8s.available, version: r.k8s.version, cluster_reachable: r.k8s.clusterReachable, ...(r.k8s.reason ? { reason: r.k8s.reason } : {}) },
                terraform: { available: r.terraform.available, version: r.terraform.version, ...(r.terraform.reason ? { reason: r.terraform.reason } : {}) },
                clis: r.clis.map((c) => ({ name: c.name, available: c.available, ...(c.version ? { version: c.version } : {}), install_hint: c.installHint })),
                summary: r.summary,
                hint: "工具缺席不是失败 —— 模板车道（cloud_dockerfile / org cloud manifest / terraform）始终可用",
            });
        } catch (e) {
            return JSON.stringify({ tool: "cloud_probe", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// 生产级 Dockerfile 模板（node/bun/python/rust 四型，#67 降级车道）。只读。
