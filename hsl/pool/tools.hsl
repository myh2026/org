/// docker 白名单子命令执行（#67 真实车道；process_spawn 门 + 审批在环）。
/// args[0]="build" 时用 context/dockerfile/tag 字段（全过监狱）。
fn tool_cloud_docker(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const argv = Array.isArray(a.args) ? a.args.map(String).filter((s) => s.length > 0) : [];
            if (argv.length === 0) return JSON.stringify({ tool: "cloud_docker", ok: false, error: "args.args 必填（数组，首元素为 docker 子命令；白名单 16 子命令见 tools_prompt）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "cloud_docker", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const cloud = await import(root + "/lib/cloud.ts");
            let r;
            if (argv[0] === "build") {
                // build 车道：context/dockerfile/tag 显式字段（context 与 Dockerfile 过监狱）
                r = cloud.dockerBuild(ws, String(a.context || "."), {
                    ...(a.dockerfile ? { dockerfile: String(a.dockerfile) } : {}),
                    ...(a.tag ? { tag: String(a.tag) } : {}),
                });
            } else {
                r = cloud.dockerRun(argv[0], argv.slice(1));
            }
            return JSON.stringify({
                tool: "cloud_docker", ok: r.ok, ...(r.kind ? { kind: r.kind } : {}),
                ...(r.reason ? { reason: r.reason } : {}),
                argv: r.argv, exit_code: r.exitCode,
                stdout: String(r.stdout).slice(0, 16384), stderr: String(r.stderr).slice(0, 4096),
                took_ms: r.tookMs,
            });
        } catch (e) {
            return JSON.stringify({ tool: "cloud_docker", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// 远程 SSH 执行 / scp 上传（#68 真实车道；host 须在 <ws>/ssh-hosts.allow，
/// local 过监狱；process_spawn 门 + 审批在环）。
fn tool_cloud_ssh(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const host = String(a.host || "");
            if (!host) return JSON.stringify({ tool: "cloud_ssh", ok: false, error: "args.host 必填（且须在 <工作区>/ssh-hosts.allow 白名单内 —— 无此文件 = 拒绝一切远程执行）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "cloud_ssh", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const cloud = await import(root + "/lib/cloud.ts");
            let r;
            if (a.upload_local != null) {
                // scp 车道：local 过工作区监狱
                r = cloud.scpUpload(ws, host, String(a.upload_local), String(a.upload_remote || ""));
            } else {
                const command = String(a.command || "");
                if (!command) return JSON.stringify({ tool: "cloud_ssh", ok: false, error: "args.command 必填（或用 upload_local/upload_remote 走 scp 车道）" });
                r = cloud.sshRun(ws, host, command);
            }
            return JSON.stringify({
                tool: "cloud_ssh", ok: r.ok, ...(r.kind ? { kind: r.kind } : {}),
                ...(r.reason ? { reason: r.reason } : {}),
                argv: r.argv, exit_code: r.exitCode,
                stdout: String(r.stdout).slice(0, 16384), stderr: String(r.stderr).slice(0, 4096),
                took_ms: r.tookMs,
            });
        } catch (e) {
            return JSON.stringify({ tool: "cloud_ssh", ok: false, error: String(e && e.message || e) });
        }
    }
}

