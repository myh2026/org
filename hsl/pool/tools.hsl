            if (!root) return JSON.stringify({ tool: "plugin_remove", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const plugins = await import(root + "/lib/plugins.ts");
            const r = plugins.pluginRemove(ws, name);
            if (!r.ok) return JSON.stringify({ tool: "plugin_remove", ok: false, kind: r.kind, error: r.error });
            return JSON.stringify({ tool: "plugin_remove", ok: true, name: r.name });
