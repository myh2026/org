/// v0.5.17 符号→声明位置（#26）：lib/lsp.ts lspDefinition 同源。
/// 输出 LSP 0 基 uri/range + 人读 1 基 file:line:column 双形。
async fn tool_lsp_definition(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const name = String(a.name || a.symbol || "");
            if (!name) return JSON.stringify({ tool: "lsp_definition", ok: false, error: "args.name 必填（符号名）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "lsp_definition", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const lsp = await import(root + "/lib/lsp.ts");
            // dirs:[""] = 工作区根扫描（与 complete_at/rename_symbol 同口径）
            const r = lsp.lspDefinition(ws, name, { dirs: [""] });
            return JSON.stringify({
                tool: "lsp_definition", ok: r.ok, lane: r.lane, name: r.name,
                ...(r.reason ? { reason: r.reason } : {}),
                definitions: r.definitions.map((d) => ({ kind: d.kind, name: d.name, file: d.file, line: d.line, column: d.column, lsp: d.lsp, snippet: d.snippet })),
            });
        } catch (e) {
            return JSON.stringify({ tool: "lsp_definition", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.17 符号引用列表（#26）：lib/lsp.ts lspReferences 同源（call/mention
/// 分类 · 定义行排除 · max_hits 帽缺省 200）。
