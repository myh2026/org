/// v0.5.17 断点建议（#108）：lib/debug.ts suggestBreakpoints 同源。
/// file 过 pathjail（越界即拒）；入口/分支/循环/return 前，符号级 > 启发式级。
async fn tool_debug_breakpoints(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const file = String(a.file || a.path || "");
            if (!file) return JSON.stringify({ tool: "debug_breakpoints", ok: false, error: "args.file 必填（工作区相对路径）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "debug_breakpoints", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            // jail 铁律：与 complete_at 同一条 pathjail 真源（分隔符归一 + win32 大小写折叠）
            const jail = await import(root + "/lib/pathjail.ts");
            const abs = pathMod.isAbsolute(file) ? file.replace(/\\/g, "/") : pathMod.resolve(ws, file);
            if (!jail.inWorkspace(ws, abs)) return JSON.stringify({ tool: "debug_breakpoints", ok: false, error: "路径越界（须在工作区内）：" + file });
            const debug = await import(root + "/lib/debug.ts");
            const r = debug.suggestBreakpoints(ws, file, { max: 60 });
            return JSON.stringify({
                tool: "debug_breakpoints", ok: r.ok, ...(r.reason ? { reason: r.reason } : {}),
                file: r.file, language: r.language, lines: r.lines, ...(r.truncated ? { truncated: true } : {}),
                suggestions: r.suggestions.map((s) => ({ line: s.line, kind: s.kind, reason: s.reason, confidence: s.confidence, snippet: s.snippet })),
            });
        } catch (e) {
            return JSON.stringify({ tool: "debug_breakpoints", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.17 调试计划（#108）：lib/debug.ts debugPlan 同源 —— 步骤说明 +
/// DAP 协议就绪消息序列（initialize/setBreakpoints/threads/stackTrace）。
