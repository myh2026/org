/// logcat dump 快照（#117 只读）：-d 一次性快照（非流式尾随）+ 五元组解析
/// + tag/级别/包名三重过滤。行数 1..2000 钳制。
fn tool_mobile_logcat(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "mobile_logcat", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const mobile = await import(root + "/lib/mobile.ts");
            const lines = Math.floor(Number(a.lines));
            const r = mobile.mobileLogcat({
                ...(a.serial ? { serial: String(a.serial) } : {}),
                ...(Number.isFinite(lines) && lines > 0 ? { lines } : {}),
                ...(a.tag ? { tag: String(a.tag) } : {}),
                ...(a.level ? { level: String(a.level) } : {}),
                ...(a.package ? { package: String(a.package) } : {}),
            });
            // 载荷保护：消息体截 200 字/条 · 总条数截 200（观测面足够 + 回灌不爆）
            return JSON.stringify({
                tool: "mobile_logcat", ok: r.ok, ...(r.kind ? { kind: r.kind } : {}),
                ...(r.reason ? { reason: r.reason } : {}),
                argv: r.argv,
                entries: r.entries.slice(0, 200).map((e) => ({ time: e.time, pid: e.pid, tid: e.tid, level: e.level, tag: e.tag, message: String(e.message).slice(0, 200) })),
                count: r.entries.length, skipped: r.skipped, truncated: r.truncated,
                took_ms: r.tookMs,
                hint: "-d 是一次性 dump（真·流式尾随是路线图）；复现一次目标操作后再抓最完整",
            });
        } catch (e) {
            return JSON.stringify({ tool: "mobile_logcat", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// 移动端调试计划（#117 只读保底车道）：纯函数（平台 × 症状矩阵 → 步骤化
/// 计划，每步 命令 + 预期 + 降级指引）。零外部依赖 —— 任何环境永远可用。
fn tool_mobile_plan(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const platform = String(a.platform || "android");
            const symptom = String(a.symptom || a.issue || "crash");
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "mobile_plan", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const mobile = await import(root + "/lib/mobile.ts");
            if (!(mobile.MOBILE_PLAN_PLATFORMS || []).includes(platform)) {
                return JSON.stringify({ tool: "mobile_plan", ok: false, error: "args.platform 须为 " + mobile.MOBILE_PLAN_PLATFORMS.join("/") + "（症状关键词中英宽容：crash/白屏/network/卡顿/构建/装不上/webview…）" });
            }
            const p = mobile.mobileDebugPlan(platform, symptom);
            return JSON.stringify({
                tool: "mobile_plan", ok: true,
                platform: p.platform, symptom: p.symptom,
                steps: p.steps, note: p.note,
                hint: "纯函数保底车道（零外部依赖永远可用）；真实执行面走 mobile_devices/mobile_logcat 与 CLI org mobile logcat/forward/apk（全只读）",
            });
        } catch (e) {
            return JSON.stringify({ tool: "mobile_plan", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.8 语义检索（capabilities #19/#22）：lib/search.ts 的 ABI 内同构
/// 实现（HSL 无法 import TS —— 分词/BM25 公式与 lib 侧一致，
/// tests/search.test.ts 行为对拍保证排序等价；「一源多投射 + 行为级
/// 对拍」与 HSL 代码生成器同一治理手法）。只读工具（ReadOnly 模式可用）。
/// v0.5.15 注：lib 侧其余新能力（db/symbols/scan/…）已改用动态 import 的
/// 零重复路线；semantic_search 保留同构实现是历史兼容（对拍用例锁定中）。
fn tool_semantic_search(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const query = String(a.query ?? a.q ?? "");
            const k = Math.max(1, Math.min(20, Math.floor(Number(a.k ?? 5) || 5)));
            if (!query.trim()) return JSON.stringify({ tool: "semantic_search", ok: false, error: "args.query 必填" });

            // ---- 与 lib/search.ts 同构：分词（西文词元 + CJK bigram）----
            const tokenize = (text) => {
                const tokens = [];
                const lower = String(text).toLowerCase();
                for (const m of lower.match(/[a-z0-9_]+/g) || []) tokens.push(m);
                for (const seg of lower.match(/[\u3400-\u9fff]+/g) || []) {
                    if (seg.length === 1) { tokens.push(seg); continue; }
                    for (let i = 0; i < seg.length - 1; i++) tokens.push(seg.slice(i, i + 2));
                    tokens.push(seg.slice(seg.length - 1));
                }
                return tokens;
            };

            // ---- 语料枚举（CORPUS_DIRS 同款：raw/ registry/ work/ factory/）----
            const CORPUS = ["raw/", "registry/", "work/", "factory/"];
            const MAX_FILES = 512;
            const MAX_CHARS = 256 * 1024;
            const all = String($host.fs.list(".", 8)).split("\n").filter((p) => p.length > 0);
            const files = all.filter((p) => CORPUS.some((c) => p.startsWith(c))).slice(0, MAX_FILES);

            // ---- 索引（逐文件隔离：读失败跳过不连坐）----
            const docs = [];
            let totalTokens = 0;
            for (const p of files) {
                let text;
                try { text = String($host.fs.read(p)); } catch (e) { continue; }
                if (text.length > MAX_CHARS) text = text.slice(0, MAX_CHARS);
                if (text.indexOf("\u0000") >= 0) continue; // 二进制嗅探
                const tokens = tokenize(text);
                const tf = new Map();
                for (const t of tokens) tf.set(t, (tf.get(t) || 0) + 1);
                totalTokens += tokens.length;
                // raw 仅存头部（64KB：短语检测 16KB + snippet 定位窗 —— 内存面
                // 512 文件 × 64KB 有界；全文场景用 fs_read 按需读回）
                docs.push({ path: p, len: tokens.length, tf: tf, raw: text.slice(0, 65536) });
            }
            const avgdl = docs.length > 0 ? totalTokens / docs.length : 0;

            // ---- BM25（Lucene IDF 防负 · k1=1.5 · b=0.75，与 lib 同参）+ 短语加成 ----
            const K1 = 1.5, B = 0.75;
            const df = new Map();
            for (const d of docs) for (const t of d.tf.keys()) df.set(t, (df.get(t) || 0) + 1);
            const qTokens = [...new Set(tokenize(query))];
            const cjkSegs = (String(query).match(/[\u3400-\u9fff]+/g) || []).filter((s) => s.length >= 2);
            const hits = [];
            for (const d of docs) {
                let score = 0;
                const matched = [];
                for (const t of qTokens) {
                    const f = d.tf.get(t);
                    if (!f) continue;
                    matched.push(t);
                    const dfv = df.get(t) || 0;
                    const idf = Math.log(1 + (docs.length - dfv + 0.5) / (dfv + 0.5));
                    score += idf * (f * (K1 + 1)) / (f + K1 * (1 - B + B * (d.len / (avgdl || 1))));
                }
                // 短语加成（与 lib/search.ts 同参对拍：原文命中查询段 +3.0）
                const head = d.raw.slice(0, 16384);
                for (const seg of cjkSegs) {
                    if (head.indexOf(seg) >= 0) {
                        score += 3.0;
                        if (matched.indexOf(seg) < 0) matched.push(seg);
                    }
                }
                if (matched.length > 0 && score > 0) {
                    let at = -1;
                    for (const t of matched) {
                        const i = d.raw.indexOf(t);
                        if (i >= 0 && (at < 0 || i < at)) at = i;
                    }
                    let snippet = "";
                    if (at >= 0) {
                        const from = Math.max(0, at - 80), to = Math.min(d.raw.length, at + 80);
                        snippet = (from > 0 ? "…" : "") + d.raw.slice(from, to).replace(/\s+/g, " ") + (to < d.raw.length ? "…" : "");
                    } else {
                        snippet = d.raw.slice(0, 120).replace(/\s+/g, " ");
                    }
                    hits.push({ path: d.path, score: Math.round(score * 100) / 100, terms: matched, snippet: snippet.slice(0, 200) });
                }
            }
            hits.sort((x, y) => y.score - x.score || (x.path < y.path ? -1 : 1));
            hits.length = Math.min(hits.length, k);
            return JSON.stringify({
                tool: "semantic_search", ok: true,
                query: query, total_docs: docs.length, hits: hits,
                hint: "用 fs_read 读回命中文件获取全文；RAG 注入（用户侧）写 @?查询词",
            });
        } catch (e) {
            return JSON.stringify({ tool: "semantic_search", ok: false, error: String(e && e.message || e) });
        }
    }
}

fn tool_fs_read(args: String) -> String {
    native typescript {
        const CAP = 32768;
        try {
            const a = JSON.parse(args);
            const path = String(a.path ?? a.file ?? a.filename ?? "");
            if (!path) return JSON.stringify({ tool: "fs_read", ok: false, error: "args.path 必填（收到的 args：" + JSON.stringify(a).slice(0, 200) + "）" });
            const content = $host.fs.read(path);
            if (content.length > CAP) {
                return JSON.stringify({ tool: "fs_read", ok: true, truncated: true, chars: content.length, content: content.slice(0, CAP) + "\\n…(truncated)" });
            }
            return JSON.stringify({ tool: "fs_read", ok: true, chars: content.length, content });
        } catch (e) {
            return JSON.stringify({ tool: "fs_read", ok: false, error: String(e && e.message || e) });
        }
    }
}

fn tool_fs_list(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const dir = String(a.dir || ".");
            const depth = Math.max(1, Math.min(8, Number(a.depth ?? 3) || 3));
            const out = $host.fs.list(dir, depth);
            const lines = String(out).split("\\n").slice(0, 400).join("\\n");
            return JSON.stringify({ tool: "fs_list", ok: true, dir, entries: lines });
        } catch (e) {
            return JSON.stringify({ tool: "fs_list", ok: false, error: String(e && e.message || e) });
        }
    }
}

fn tool_fs_glob(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const pattern = String(a.pattern || "");
            if (!pattern) return JSON.stringify({ tool: "fs_glob", ok: false, error: "args.pattern 必填" });
            // 简单 glob：** → 任意层级，* → 单段。全树枚举（fs.list depth 8）后匹配
            const all = String($host.fs.list(".", 8)).split("\\n").filter((l) => l.length > 0);
            const rx = new RegExp("^" + pattern
                .replace(/[.+^${}()|[\\]]/g, "\\\\$&")
                .replace(/\\*\\*/g, "::DBL::")
                .replace(/\\*/g, "[^/]*")
                .replace(/::DBL::/g, ".*") + "$");
            const hits = all.filter((p) => rx.test(p)).slice(0, 200);
            return JSON.stringify({ tool: "fs_glob", ok: true, matched: hits.length, files: hits.join("\\n") });
        } catch (e) {
            return JSON.stringify({ tool: "fs_glob", ok: false, error: String(e && e.message || e) });
        }
    }
}

fn tool_fs_write(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const path = String(a.path || "");
            const content = String(a.content ?? "");
            const preview = a.preview === true;
            if (!path) return JSON.stringify({ tool: "fs_write", ok: false, error: "args.path 必填" });

            // v0.5.15 密钥拦截（capabilities #141）：写入前 scanText —— 高危密钥模式
            // （OpenAI/Anthropic/GitHub/AWS/Google/私钥/JWT…，lib/scan.ts 同源）拒绝落盘；
            // 中低危告警但放行。ORG_SCAN=off 可关（用户明示信任内容的逃生口）。
            const scanOff = String($host.env.get("ORG_SCAN") || "").trim().toLowerCase() === "off";
            let scanHits = [];
            if (!scanOff && !preview) {
                try {
                    const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/");
                    const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/);
                    if (m) {
                        const scan = await import(m[1] + "/lib/scan.ts");
                        scanHits = scan.scanText(content, path);
                    }
                } catch (e) { /* 扫描器缺席 → 不拦截写入（降级不阻断） */ }
            }
            const high = scanHits.filter((h) => h.severity === "high");
            if (high.length > 0) {
                return JSON.stringify({
                    tool: "fs_write", ok: false, refused: "secret_scan",
                    error: "写入被拒：内容含 " + high.length + " 处高危密钥模式（" + high.map((h) => h.pattern).join(", ") + "）。凭据不该落盘 —— 请改用环境变量或密钥文件引用；确需写入请让用户设 ORG_SCAN=off。",
                });
            }

            // v0.5.15 preview 干跑（capabilities #60）：不落盘，返回 unified diff。
            // 旧文件不存在 = 全新增；diff 引擎与 lib/diff.ts 同源（GNU diff -u 对拍一致）。
            if (preview) {
                let oldText = "";
                let exists = true;
                try { oldText = String($host.fs.read(path)); } catch (e) { exists = false; }
                try {
                    const d0 = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/");
                    const m0 = d0.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/);
                    if (!m0) throw new Error("DHV_TS 缺席");
                    const diff = await import(m0[1] + "/lib/diff.ts");
                    const r = diff.diffText(oldText, content);
                    return JSON.stringify({
                        tool: "fs_write", ok: true, preview: true, wrote: false, path, exists,
                        stats: diff.renderStats(r), diff: diff.renderUnified(r, path, path).slice(0, 16384),
                    });
                } catch (e) {
                    return JSON.stringify({ tool: "fs_write", ok: false, error: "preview 降级（diff 引擎缺席）" + String(e && e.message || e) });
                }
            }

            const n = $host.fs.write(path, content);
            const warn = scanHits.length > 0 ? "（⚠ 密钥扫描：" + scanHits.length + " 处中低危模式已放行 — " + scanHits.map((h) => h.pattern).join(", ") + "）" : "";
            return JSON.stringify({ tool: "fs_write", ok: true, bytes: n, path, scan_warnings: scanHits.length, note: warn || undefined });
        } catch (e) {
            return JSON.stringify({ tool: "fs_write", ok: false, error: String(e && e.message || e) });
        }
    }
}

fn tool_fs_edit(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const path = String(a.path || "");
            const old = String(a.old ?? "");
            const nw = String(a.new ?? "");
            const preview = a.preview === true;
            if (!path || !old) return JSON.stringify({ tool: "fs_edit", ok: false, error: "args.path/args.old 必填" });

            // v0.5.15 preview 干跑：老内容 → 新内容 unified diff，不落盘。
            if (preview) {
                const cur = String($host.fs.read(path));
                if (cur.indexOf(old) < 0) return JSON.stringify({ tool: "fs_edit", ok: false, error: "old 锚点未命中（preview 同样要求锚点存在且唯一）" });
                if (cur.indexOf(old) !== cur.lastIndexOf(old)) return JSON.stringify({ tool: "fs_edit", ok: false, error: "old 锚点多处命中（须唯一）" });
                try {
                    const d0 = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/");
                    const m0 = d0.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/);
                    if (!m0) throw new Error("DHV_TS 缺席");
                    const diff = await import(m0[1] + "/lib/diff.ts");
                    const r = diff.diffText(cur, cur.replace(old, nw));
                    return JSON.stringify({
                        tool: "fs_edit", ok: true, preview: true, wrote: false, path,
                        stats: diff.renderStats(r), diff: diff.renderUnified(r, path, path).slice(0, 16384),
                    });
                } catch (e) {
                    return JSON.stringify({ tool: "fs_edit", ok: false, error: "preview 降级（diff 引擎缺席）" + String(e && e.message || e) });
                }
            }

            const r = $host.fs.edit(path, old, nw);
            if (r && r.ok) return JSON.stringify({ tool: "fs_edit", ok: true, path });
            return JSON.stringify({ tool: "fs_edit", ok: false, error: String(r && r.error || "edit 失败（old 锚点须唯一命中）") });
        } catch (e) {
            return JSON.stringify({ tool: "fs_edit", ok: false, error: String(e && e.message || e) });
        }
    }
}

fn tool_shell_run(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const cmd = String(a.cmd || "");
            if (!cmd) return JSON.stringify({ tool: "shell_run", ok: false, error: "args.cmd 必填" });
            const r = $host.shell.run(cmd, { timeoutMs: 60000 });
            const out = String(r.stdout || "").slice(0, 16384);
            const err = String(r.stderr || "").slice(0, 2048);
            return JSON.stringify({ tool: "shell_run", ok: r.ok, code: r.code, stdout: out, stderr: err });
        } catch (e) {
            return JSON.stringify({ tool: "shell_run", ok: false, error: String(e && e.message || e) });
        }
    }
}

// ---- v0.5.6 新工具：子生孙递归派生 + 音频作曲 ----------------------------------

/// 子生孙递归派生：派生一个子组织进程（org run 团队任务 / org ask 直连专家）。
///
/// 深度治理（理论可子子孙孙无穷尽，深度帽是安全线）：
///   ORG_SPAWN_DEPTH  当前深度（派生方注入；顶层缺省 0）
///   ORG_SPAWN_MAX    深度上限（缺省 2；0 = 全局关闭派生）
/// 子进程经 bash 继承本进程全部环境（DHV_LLM_* 车道配置自动透传），
/// 子工作区 <ws>/spawn/<序号>-<slug>（ensureWorkspace 自动铺模板）。
async fn tool_agent_spawn(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const goal = String(a.goal || a.task || a.question || "");
            if (!goal) return JSON.stringify({ tool: "agent_spawn", ok: false, error: "args.goal 必填（要派生子组织完成的任务）" });
            const mode = String(a.mode || "run") === "ask" ? "ask" : "run";
            const expert = String(a.expert || "");
            if (mode === "ask" && !expert) return JSON.stringify({ tool: "agent_spawn", ok: false, error: "ask 模式需要 args.expert（直连专家名）" });
            // v0.5.11 池化复用开关：reuse:false 强制新派生（绕过池命中）
            const forceFresh = a.reuse === false;

            // ---- 深度治理（先于一切执行：拒绝即终态，不烧预算） ----
            const depth = Number($host.env.get("ORG_SPAWN_DEPTH") || "0") || 0;
            const maxD = Number($host.env.get("ORG_SPAWN_MAX") || "2");
            if (maxD === 0) {
                return JSON.stringify({ tool: "agent_spawn", ok: false, denied: true, error: "递归派生已全局关闭（ORG_SPAWN_MAX=0）。请自行完成任务。" });
            }
            const childDepth = depth + 1;
            if (childDepth > maxD) {
                return JSON.stringify({
                    tool: "agent_spawn", ok: false, denied: true,
                    error: "递归深度已达上限（depth=" + depth + ", max=" + maxD + "）。子子孙孙须有界：请在本层自行完成任务，不要再派生。",
                });
            }

            // ---- v0.5.11 预算继承（深度帽之后的第二道安全线） ----
            // ORG_SPAWN_BUDGET（份数）：未设=100；"0"=已耗尽（拒绝派生）；
            // "off"/"unlimited"/"-1"=治理关闭（逃生口，语义与 MAX=0 对称）。
            // ORG_SPAWN_DECAY（衰减率 (0,1]，缺省 0.5）：
            //   子预算 = floor(父预算 × decay) —— 预算随深度指数衰减，无保底
            //   （floor 到 0 即耗尽），用户调大 ORG_SPAWN_MAX 时预算接得住。
            const budgetRaw = String($host.env.get("ORG_SPAWN_BUDGET") || "").trim().toLowerCase();
            const budgetOff = budgetRaw === "off" || budgetRaw === "unlimited" || budgetRaw === "-1";
            let budget = budgetOff ? -1 : (budgetRaw === "" ? 100 : Math.floor(Number(budgetRaw)));
            if (!budgetOff && !Number.isFinite(budget)) budget = 100;
            const decayRaw = Number($host.env.get("ORG_SPAWN_DECAY"));
            const decay = Math.min(1, Math.max(0.01, Number.isFinite(decayRaw) && decayRaw > 0 ? decayRaw : 0.5));
            if (!budgetOff && budget < 1) {
                return JSON.stringify({
                    tool: "agent_spawn", ok: false, denied: true,
                    error: "派生预算已耗尽（本层剩余 " + budget + " 份）。请在本层自行完成任务；确需派生请让用户调大 ORG_SPAWN_BUDGET（off=关闭预算治理）。",
                });
            }
            const childBudget = budgetOff ? -1 : Math.floor(budget * decay);

            // ---- org 根目录（DHV_TS = <root>/toolchain/dhv-ts/src/main.ts） ----
            const norm = (s) => String(s || "").replace(/\\/g, "/");
            const dhv = norm($host.env.get("DHV_TS"));
            if (!dhv) return JSON.stringify({ tool: "agent_spawn", ok: false, error: "DHV_TS 环境缺席：无法定位 org 根目录（需经 org 宿主启动）" });
            const root = dhv.replace(/\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/, "");
            const ws = norm(String($host.config.workspace || "."));
            const lane = String($host.config.model || "scripted");
            const fixture = norm(String($host.env.get("ORG_FIXTURE") || ""));

            // ---- v0.5.11 池化重档：同 goal 复用（先查池，零派生成本） ----
            // 池文件 <ws>/spawn/pool.json：每次派生登记一条；相似 goal 命中即
            // 复用（reuse_count 递增）。池读写失败降级 —— 登记是治理面，派生
            // 是执行面，治理面故障不能阻断执行面（派生照常，只是不留痕）。
            const POOL_PATH = "spawn/pool.json"; // 相对 ws（jail 内）
            const REUSE_FLOOR = Math.max(0.3, Math.min(0.95, Number($host.env.get("ORG_SPAWN_REUSE_FLOOR")) || 0.6));
            const loadPool = () => {
                try {
                    const o = JSON.parse($host.fs.read(POOL_PATH));
                    if (o && Array.isArray(o.records)) return o;
                } catch (e) { /* 池不存在/损坏 → 空池 */ }
                return { version: 1, records: [] };
            };
            // 中英混合分词（与 semantic_search 同构：西文词元 + CJK bigram）
            const tokenize = (text) => {
                const tokens = [];
                const lower = String(text).toLowerCase();
                for (const m of lower.match(/[a-z0-9_]+/g) || []) tokens.push(m);
                for (const seg of lower.match(/[\u3400-\u9fff]+/g) || []) {
                    if (seg.length === 1) { tokens.push(seg); continue; }
                    for (let i = 0; i < seg.length - 1; i++) tokens.push(seg.slice(i, i + 2));
                    tokens.push(seg.slice(seg.length - 1));
                }
                return tokens;
            };
            // 双向词面重合（max 覆盖率）：goal 表述长短不齐时单向覆盖会漏
            // （记录「做X」vs 任务「请帮我做X」：正向 1.0 反向 0.6）
            const overlap = (x, y) => {
                const tx = [...new Set(tokenize(x))], sy = new Set(tokenize(y));
                if (tx.length === 0 || sy.size === 0) return 0;
                let hx = 0; for (const t of tx) if (sy.has(t)) hx++;
                const ty = [...new Set(tokenize(y))], sx = new Set(tokenize(x));
                if (ty.length === 0) return 0;
                let hy = 0; for (const t of ty) if (sx.has(t)) hy++;
                return Math.max(hx / tx.length, hy / ty.length);
            };
            if (!forceFresh) {
                const pool = loadPool();
                let best = null, bestScore = 0;
                for (const r of pool.records) {
                    if (!r || r.ok !== true) continue; // 只复用成功记录
                    const s = overlap(goal, String(r.goal || ""));
                    if (s >= REUSE_FLOOR && s > bestScore) { best = r; bestScore = s; }
                }
                if (best) {
                    best.reuse_count = (Number(best.reuse_count) || 0) + 1;
                    best.reused_at = new Date().toISOString();
                    try { $host.fs.write(POOL_PATH, JSON.stringify(pool, null, 2)); } catch (e) { /* 命中计数失败：本次仍复用 */ }
                    return JSON.stringify({
                        tool: "agent_spawn", ok: true, reused: true, reuse_of: best.id,
                        similarity: Math.round(bestScore * 100) / 100,
                        goal: best.goal, mode: best.mode, depth: best.depth,
                        budget: best.budget,
                        workspace: best.workspace, out: best.out,
                        reuse_count: best.reuse_count,
                        summary: String(best.summary || "").slice(0, 2048),
                        note: "池化命中：相似 goal 的子组织已在池（零派生成本）。args.reuse=false 可强制新派生。",
                    });
                }
            }

            // ---- 子工作区与产物目录 ----
            const slug = goal.slice(0, 24).replace(/[^A-Za-z0-9\u4e00-\u9fff]+/g, "-").replace(/^-+|-+$/g, "") || "mission";
            const childWs = ws + "/spawn/" + Date.now().toString(36) + "-" + slug;
            const outDir = childWs + "/out-spawn";
            const spawnedAt = new Date().toISOString();

            // ---- 命令组装（sh 单引号转义：goal 来自模型，不得破坏命令边界；
            // 深度/预算经 --spawn-depth/--spawn-budget 旗标传递 —— env 前缀会
            // 破坏 shell 白名单首词判定，CLI 旗标是白名单友好的递归通道） ----
            const q = (s) => "'" + String(s).replace(/'/g, "'\\''") + "'";
            const budgetFlag = budgetOff ? "off" : String(childBudget); // -1 → off（子进程侧同语义）
            let cmd;
            if (mode === "ask") {
                cmd = "bun " + q(root + "/cli/org.ts")
                    + " ask " + q(expert) + " " + q(goal)
                    + " --workspace " + q(childWs) + " --model " + q(lane)
                    + (fixture ? " --fixture " + q(fixture) : "")
                    + " --out " + q(outDir)
                    + " --spawn-depth " + childDepth
                    + " --spawn-budget " + budgetFlag;
            } else {
                cmd = "bun " + q(root + "/cli/org.ts")
                    + " run --task " + q(goal)
                    + " --workspace " + q(childWs) + " --model " + q(lane)
                    + (fixture ? " --fixture " + q(fixture) : "")
                    + " --out " + q(outDir)
                    + " --spawn-depth " + childDepth
                    + " --spawn-budget " + budgetFlag;
            }

            const r = await $host.shell.run(cmd, { timeoutMs: 180000 });
            const out = String(r.stdout || "");
            // 子运行摘要（交付物行 + 验收行；观测有界）
            const lines = out.split("\n").filter((l) => /task#|accepted|交付物|✓ harness|♪/.test(l)).slice(-12);
            const summary = lines.join("\n").slice(0, 4096);

            // ---- v0.5.11 用量回填：子组织 metrics.json / run.json 的真实开销 ----
            // （scripted 车道是估算口径 tokens_total；真实车道是 llm_stream_done
            // 计量 —— 都落 metrics.json，本层只做搬运，不重复计量）
            let usage = null;
            try {
                const m = JSON.parse($host.fs.read(outDir + "/metrics.json"));
                let elapsed = 0;
                try {
                    const j = JSON.parse($host.fs.read(outDir + "/run.json"));
                    elapsed = Number(j.elapsed_ms) || 0;
                } catch (e2) { /* run.json 缺席：elapsed 留 0 */ }
                usage = { tokens: Number(m.tokens_total) || 0, model_calls: Number(m.model_calls_total) || 0, elapsed_ms: elapsed };
            } catch (e) { /* 产物缺席：usage 留空（观测面降级，不影响派生语义） */ }

            // ---- v0.5.11 池化登记（治理面：失败降级不阻断 —— 派生已完成不回滚） ----
            const id = childWs.split("/").pop();
            try {
                const pool = loadPool();
                pool.version = 1;
                pool.records.push({
                    id: id, goal: goal, mode: mode, depth: childDepth, budget: budgetOff ? "off" : childBudget,
                    workspace: childWs, out: outDir,
                    ok: r.ok === true, usage: usage,
                    summary: summary.slice(0, 2048),
                    spawned_at: spawnedAt, finished_at: new Date().toISOString(),
                    reuse_count: 0,
                });
                if (pool.records.length > 200) pool.records = pool.records.slice(-200); // 粗上限防膨胀
                $host.fs.write(POOL_PATH, JSON.stringify(pool, null, 2));
            } catch (e) { /* 登记失败：留痕缺失，不回滚派生 */ }

            return JSON.stringify({
                tool: "agent_spawn", ok: r.ok, code: r.code,
                depth: childDepth, max: maxD, mode: mode,
                budget: budgetOff ? "off" : budget, child_budget: budgetOff ? "off" : childBudget,
                workspace: childWs, out: outDir,
                usage: usage, summary: summary,
                stdout_tail: out.slice(-2048),
                stderr: String(r.stderr || "").slice(0, 1024),
            });
        } catch (e) {
            return JSON.stringify({ tool: "agent_spawn", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// 音频作曲（直连车道）：写 <name>.notes.json 工件 —— 引擎收尾扫描渲染
/// 同名 .wav（开袋即食：交付物是音频不是乐谱）。参数宽容（多形态别名）。
/// v0.5.9：timbre 音色（8 种乐器）/ chords 和弦进行（7 套预设，可代 notes）/
/// export_midi（缺省 true —— audio_compose 显式调用，MIDI 顺手交付）。
fn tool_audio_compose(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            let notes = a.notes;
            let chordsUsed = "";
            // v0.5.9：和弦进行车道 —— 无 notes 时用 chords/progression 生成
            // 宽容形态："canon" | "D3:canon" | "D3:canon:arp" | {root,name,style,beats_per_chord}
            // （与 lib/audio.ts progressionToNotes 同构：音名/音级质量/进行表同参，保持对拍）
            let progSpec = a.chords ?? a.progression ?? null;
            if ((!notes || (Array.isArray(notes) && notes.length === 0)) && progSpec) {
                let root = "C4", progName = "canon", style = "block", bpc = 4;
                if (typeof progSpec === "string") {
                    const parts = String(progSpec).split(":").map((s) => s.trim()).filter(Boolean);
                    for (const p of parts) {
                        if (/^[A-Ga-g][#b♯♭]?-?\d+$/.test(p) && p === parts[0]) root = p;
                        else if (p === "arp") style = "arp";
                        else progName = p.toLowerCase();
                    }
                } else if (progSpec && typeof progSpec === "object") {
                    root = String(progSpec.root || "C4");
                    progName = String(progSpec.name || progSpec.prog || "canon").toLowerCase();
                    style = String(progSpec.style) === "arp" ? "arp" : "block";
                    bpc = Number(progSpec.beats_per_chord ?? progSpec.beatsPerChord ?? 4) || 4;
                }
                // ---- 同构内联（lib/audio.ts 的 ABI 镜像）----
                const PROGS = {
                    canon: [0, 7, 9, 4, 5, 0, 5, 7], pop: [0, 7, 9, 5], epic: [9, 5, 0, 7],
                    circle: [0, 5, 7, 0], jazz: [2, 7, 0],
                    blues: [0, 0, 0, 0, 5, 5, 0, 0, 7, 5, 0, 0], romance: [0, 9, 5, 7],
                };
                const QUAL = {
                    maj: [0, 4, 7], min: [0, 3, 7], dim: [0, 3, 6], "7": [0, 4, 7, 10],
                    m7: [0, 3, 7, 10],
                };
                const diatonic = (off) => {
                    const v = ((off % 12) + 12) % 12;
                    if (v === 2 || v === 4 || v === 9) return "m7";
                    if (v === 11) return "dim";
                    if (v === 7) return "7";
                    return "maj";
                };
                const nameToMidi = (nm) => {
                    const m = /^([A-Ga-g])([#b♯♭]?)(-?\d+)$/.exec(String(nm).trim());
                    if (!m) return 60;
                    const BASE = { C: 0, D: 2, E: 4, F: 5, G: 7, A: 9, B: 11 };
                    const acc = m[2] === "#" || m[2] === "♯" ? 1 : m[2] === "b" || m[2] === "♭" ? -1 : 0;
                    const midi = (Number(m[3]) + 1) * 12 + BASE[m[1].toUpperCase()] + acc;
                    return Math.max(0, Math.min(127, midi));
                };
                const f2 = (m) => 440 * Math.pow(2, (m - 69) / 12);
                const steps = PROGS[progName] || PROGS.canon;
                const LETTERS = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
                const rootMidi = nameToMidi(root);
                const gen = [];
                const chordNames = [];
                const g = Math.max(0.05, Math.min(1, Number(a.gain ?? 0.6) || 0.6));
                steps.forEach((step, i) => {
                    const q = diatonic(step);
                    const ivs = QUAL[q] || QUAL.maj;
                    const rn = rootMidi + step;
                    chordNames.push(LETTERS[((rn % 12) + 12) % 12] + (Math.floor(rn / 12) - 1) + (q === "maj" ? "" : q));
                    ivs.forEach((iv, j) => {
                        if (style === "block") gen.push({ freq: f2(rn + iv), start_beat: i * bpc, beats: bpc * 0.95, gain: g, channel: "both" });
                        else {
                            const sb = bpc / ivs.length;
                            gen.push({ freq: f2(rn + iv), start_beat: i * bpc + j * sb, beats: sb * 1.4, gain: g, channel: "both" });
                        }
                    });
                });
                notes = gen;
                chordsUsed = chordNames.join(" ");
            }
            // 宽容形态：单个音符对象 / score 简谱串（"261.63:1, 293.66:1, 329.63:2"）
            if (!Array.isArray(notes)) {
                if (notes && typeof notes === "object") notes = [notes];
                else if (typeof a.score === "string") {
                    notes = String(a.score).split(",").map((seg) => {
                        const m = seg.trim().split(":");
                        return { freq: Number(m[0]), beats: Number(m[1] || 1) };
                    });
                } else notes = null;
            }
            if (!notes || !Array.isArray(notes) || notes.length === 0) {
                return JSON.stringify({ tool: "audio_compose", ok: false, error: "args.notes 必填（[{freq,start_beat,beats,gain,wave}] 或 score 简谱串或 chords 和弦进行）" });
            }
            let beat = 0;
            const clean = notes.slice(0, 20000).map((n) => {
                const freq = Number(n.freq || n.f || 0);
                const beats = Number(n.beats ?? n.dur ?? 1);
                const start = Number(n.start_beat ?? beat);
                beat = start + beats;
                return {
                    freq: freq,
                    start_beat: start,
                    beats: beats,
                    gain: Number(n.gain ?? 0.6),
                    wave: String(n.wave || "sine"),
                    channel: String(n.channel || "both"),
                };
            }).filter((n) => Number.isFinite(n.freq) && n.freq > 0 && Number.isFinite(n.beats) && n.beats > 0);
            if (clean.length === 0) {
                return JSON.stringify({ tool: "audio_compose", ok: false, error: "notes 不含任何合法音符（freq/beats 必须为正数）" });
            }
            const name = String(a.name || a.file || "music").replace(/[^A-Za-z0-9_-]/g, "-") || "music";
            // v0.5.9：音色透传（未注册名保留 —— lib 侧降级到 wave 波形并留痕）
            const timbre = typeof a.timbre === "string" ? a.timbre : undefined;
            const doc = {
                title: String(a.title || "audio_compose"),
                tempo: Number(a.tempo || 90),
                sample_rate: 44100,
                ...(timbre ? { timbre: timbre } : {}),
                export_midi: a.export_midi !== false, // 显式 false 才关（缺省交付）
                notes: clean,
            };
            $host.artifacts.write(name + ".notes.json", JSON.stringify(doc, null, 2));
            const totalBeats = clean.reduce((m, n) => Math.max(m, n.start_beat + n.beats), 0);
            return JSON.stringify({
                tool: "audio_compose", ok: true, notes: clean.length,
                artifact: name + ".notes.json", wav: name + ".wav", mid: name + ".mid",
                ...(timbre ? { timbre: timbre } : {}),
                ...(chordsUsed ? { chords: chordsUsed.slice(0, 120) } : {}),
                duration_hint: Math.round(totalBeats * 60 / doc.tempo) + "s",
                note: "引擎收尾自动渲染同名 .wav 与 .mid（本次运行产物目录）",
            });
        } catch (e) {
            return JSON.stringify({ tool: "audio_compose", ok: false, error: String(e && e.message || e) });
        }
    }
}

// ---- 观测与辅助 ----------------------------------------------------------------

/// 事件上总线（journal 通道，三端消费）。
fn emit_tool(name: String, detail: String) {
    let n = name.clone();
    let d = detail.clone();
    let _ = native typescript {
        $host.events.emit("journal", { name: n, detail: d.slice(0, 300) });
        return true;
    };
}

fn json_ok(tool: String, ok: bool, payload: String) -> String {
    native typescript {
        return JSON.stringify({ tool: tool, ok: ok, content: payload });
    }
}

/// args 摘要（观测面脱敏：不整段落 content）。
fn preview_args(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const parts = [];
            for (const k of Object.keys(a)) {
                let v = String(a[k]);
                if (v.length > 60) v = v.slice(0, 57) + "…";
                parts.push(k + "=" + v);
            }
            return parts.join(" ").slice(0, 200);
        } catch (e) {
            return String(args).slice(0, 120);
        }
    }
}

fn result_summary(result: String) -> String {
    native typescript {
        try {
            const o = JSON.parse(result);
            const tool = String(o.tool || "?");
            if (o.ok === true) {
                const size = o.content != null ? String(o.content).length : o.entries != null ? String(o.entries).length : o.files != null ? String(o.files).length : 0;
                // v0.5.6：agent_spawn / audio_compose 的观测摘要（深度/音符数等结构化字段）
                // v0.5.11：agent_spawn 加预算/复用/用量（池化命中 reused×N；新派生 budget 与 usage tokens）
                if (tool === "agent_spawn") {
                    const bud = o.budget !== undefined ? " budget=" + String(o.budget) : "";
                    const tok = o.usage && o.usage.tokens ? " tokens=" + String(o.usage.tokens) : "";
                    if (o.reused) return tool + " reused ×" + String(o.reuse_count ?? "?") + " sim=" + String(o.similarity ?? "?") + bud + " ws=" + String((o.workspace || "?").split("/").pop());
                    return tool + " ok depth=" + String(o.depth ?? "?") + bud + tok + " ws=" + String((o.workspace || "?").split("/").pop());
                }
                if (tool === "audio_compose") return tool + " ok notes=" + String(o.notes ?? "?") + " wav=" + String(o.wav ?? "?");
                // v0.5.8：语义检索的观测摘要（hits 数 + top-1 路径 —— tests/
                // search.test.ts 以此对拍 HSL 版与 lib 版的排序一致性）
                if (tool === "semantic_search") return tool + " ok hits=" + String((o.hits || []).length) + " docs=" + String(o.total_docs ?? "?") + " top=" + String((o.hits && o.hits[0] && o.hits[0].path) || "-");
                // v0.5.15：桌面 Agent 补全批次的观测摘要（journal 人读面）
                if (tool === "symbol_search") return tool + " ok defs=" + String((o.defs || []).length) + (o.refs !== undefined ? " refs=" + String((o.refs || []).length) : "") + " top=" + String((o.defs && o.defs[0] && o.defs[0].file + ":" + o.defs[0].line) || "-");
                if (tool === "db_schema") return tool + " ok tables=" + String((o.tables || []).length) + " " + (o.tables || []).map((t) => t.name).slice(0, 5).join(",");
                if (tool === "db_query") return tool + " ok rows=" + String(o.row_count ?? (o.rows || []).length) + (o.truncated ? " (截断)" : "") + " ms=" + String(o.ms ?? "?");
                if (tool === "db_migrate") return tool + (o.dry_run ? " dry-run ok" : " ok") + " v" + String(o.version) + " " + String(o.name || "");
                if (tool === "fs_move") return tool + " ok " + String(o.from) + " → " + String(o.to);
                if (tool === "read_pdf") return tool + " ok engine=" + String(o.engine) + " pages=" + String(o.pages) + " chars=" + String((o.text || "").length);
                if (tool === "audit_export") return tool + " ok " + String(o.zip) + " entries=" + String(o.entries);
                if (tool === "review_suggest") return tool + " ok reviewers=" + String((o.reviewers || []).map((x) => x.name).join(","));
                if (tool === "fs_write" && o.preview) return tool + " preview " + String(o.stats || "") + " " + String(o.path);
                if (tool === "fs_edit" && o.preview) return tool + " preview " + String(o.stats || "") + " " + String(o.path);
                if (tool === "fs_write" && o.scan_warnings > 0) return tool + " ok " + String(o.bytes) + "B ⚠密钥告警 " + String(o.scan_warnings) + " " + String(o.path);
                // v0.5.16 治理与扩展批的观测摘要（journal 人读面）
                if (tool === "db_diagnose") return tool + " ok steps=" + String((o.plan && o.plan.step_count) ?? "?") + " tables=" + String((o.plan && o.plan.tables || []).join(",")) + (o.plan && o.plan.full_scan ? " ⚠全表扫描" : "") + " 建议" + String((o.suggestions || []).length) + "条 " + String(o.ms ?? "?") + "ms";
                if (tool === "git_merge" || tool === "git_rebase") return tool + (o.ok ? " ok " : " " + String(o.kind || "?") + " ") + String(o.output || o.error || "").trim().split("\n")[0].slice(0, 90) + ((o.conflicts || []).length > 0 ? " 冲突" + String(o.conflicts.length) + "已abort" : "");
                if (tool === "rbac_check") return tool + " " + (o.allowed ? "allow" : "deny") + " " + String(o.role) + "×" + String(o.action) + " rule=" + String(o.rule);
                if (tool === "iac_scan") return tool + " ok hits=" + String((o.hits || []).length) + "/" + String(o.files || 0) + "文件 high=" + String(o.high ?? 0) + ((o.hits && o.hits[0]) ? " top=" + String(o.hits[0].file) + ":" + String(o.hits[0].line) + "(" + String(o.hits[0].severity) + ")" : "") + " " + String(o.took_ms ?? "?") + "ms";
                if (tool === "plugin_list") return tool + " ok " + String(o.count ?? 0) + " 个插件";
                if (tool === "plugin_install") return tool + " ok " + String(o.name) + "@" + String(o.version) + ((o.warnings || []).length > 0 ? " ⚠" + String(o.warnings.length) : "");
                if (tool === "plugin_remove") return tool + " ok " + String(o.name);
                if (tool === "openapi_parse") return tool + " ok " + String(o.total_operations ?? (o.operations || []).length) + " 操作 " + String(o.version) + " " + String(o.info && o.info.title || "");
                if (tool === "browser_snapshot") return tool + " ok engine=" + String(o.engine) + " chars=" + String((o.text || "").length) + " links=" + String((o.links || []).length) + " " + String(o.ms ?? "?") + "ms";
                if (tool === "browser_screenshot") return tool + " ok " + String(o.path) + " (" + String(o.engine) + ", " + String(o.ms ?? "?") + "ms)";
                if (tool === "complete_at") return tool + " ok " + String((o.candidates || []).length) + " 候选" + (o.prefix ? " prefix=" + String(o.prefix) : "") + (o.reason ? "（" + String(o.reason).slice(0, 60) + "）" : "");
                if (tool === "rename_symbol") return tool + (o.dry_run ? " dry-run" : " applied") + " " + String(o.edits ?? "?") + " 处编辑 · " + String(o.files ?? "?") + " 文件" + ((o.warnings || []).length > 0 ? " ⚠" + String(o.warnings.length) : "");
                // v0.5.17 LSP/DAP 深度簇的观测摘要（journal 人读面）
                if (tool === "lsp_definition") return tool + " ok defs=" + String((o.definitions || []).length) + " top=" + String((o.definitions && o.definitions[0] && o.definitions[0].file + ":" + o.definitions[0].line) || "-");
                if (tool === "lsp_references") return tool + " ok refs=" + String((o.refs || []).length) + " calls=" + String((o.refs || []).filter(function (x) { return x.kind === "call"; }).length) + " defs=" + String(o.definitions ?? 0) + ((o.refs && o.refs[0]) ? " top=" + String(o.refs[0].file + ":" + o.refs[0].line) : "");
                if (tool === "lsp_hover") return tool + (o.hover ? " ok " + String(o.hover.kind) + " " + String(o.hover.name) + " " + String(o.hover.file) + ":" + String(o.hover.line) : " 空 " + String(o.reason || "?").slice(0, 60));
                if (tool === "lsp_servers") return tool + " ok 可用 " + String((o.servers || []).filter(function (s) { return s.available; }).length) + "/" + String((o.servers || []).length);
                if (tool === "debug_breakpoints") return tool + " ok 建议" + String((o.suggestions || []).length) + "处" + (o.language ? " " + String(o.language) : "") + ((o.suggestions && o.suggestions[0]) ? " top=" + String(o.suggestions[0].line) + "(" + String(o.suggestions[0].kind) + ")" : "") + (o.reason ? "（" + String(o.reason).slice(0, 60) + "）" : "");
                if (tool === "debug_plan") return tool + " ok " + String(o.suggestions ?? 0) + "断点 · " + String((o.steps || []).length) + "步 · DAP消息" + String((o.dap_messages || o.dapMessages || []).length) + "条";
                // v0.5.17 云生态簇的观测摘要（journal 人读面）
                if (tool === "cloud_probe") {
                    const s = o.summary || {};
                    return tool + " ok docker=" + String(s.dockerDaemon ? "daemon✓" : (s.dockerAvailable ? "CLI" : "✗")) + " ssh=" + String(s.sshAvailable ? "✓" : "✗") + " k8s=" + String(s.k8sCluster ? "cluster✓" : (s.k8sAvailable ? "CLI" : "✗")) + " tf=" + String(s.terraformAvailable ? "✓" : "✗") + " clis=" + String(s.clisAvailable ?? "?") + "/" + String(s.clisTotal ?? "?") + " " + String(o.took_ms ?? "?") + "ms";
                }
                if (tool === "cloud_dockerfile") return tool + " ok " + String(o.project_type) + " 模板 " + String((o.dockerfile || "").length) + "字符（多阶段·非root·healthcheck）";
                if (tool === "cloud_clis") return tool + " ok " + String(o.available ?? "?") + "/" + String(o.total ?? "?") + " 家在场 · 模型商" + String((o.providers_overview || {}).model_providers ?? "?") + "家";
                if (tool === "cloud_docker" || tool === "cloud_ssh" || tool === "cloud_k8s") {
                    return tool + " ok " + String((o.argv || []).slice(0, 4).join(" ")) + " " + String(o.took_ms ?? "?") + "ms";
                }
                // v0.5.18 移动端调试簇的观测摘要（journal 人读面；devices 按
                // 「N 台·就绪 M」口径，logcat 按条数+截断口径 —— 与 lib 同源）
                if (tool === "mobile_devices") {
                    return tool + " ok " + String((o.devices || []).length) + "台（就绪" + String(o.ready ?? 0) + "）" + ((o.devices && o.devices[0]) ? " top=" + String(o.devices[0].serial) + "(" + String(o.devices[0].state) + ")" : "") + " iOS=" + String((o.ios || {}).available ? "✓" : "✗") + " " + String(o.took_ms ?? "?") + "ms";
                }
                if (tool === "mobile_logcat") {
                    return tool + " ok " + String(o.count ?? (o.entries || []).length) + "条" + (o.truncated ? "（截断）" : "") + " 未匹配" + String(o.skipped ?? 0) + " top=" + String(((o.entries || [])[0] || {}).tag || "-") + " " + String(o.took_ms ?? "?") + "ms";
                }
                if (tool === "mobile_plan") {
                    return tool + " ok " + String(o.platform) + " " + String(o.symptom) + " " + String((o.steps || []).length) + "步（纯函数保底）";
                }
                // v0.5.17 协作簇的观测摘要（journal 人读面；feed 按「N 帖·M 评论·K 用户」口径）
                if (tool === "collab_threads") { const s = o.summary || {}; return tool + " ok " + String(s.threads ?? (o.threads || []).length) + " 线程 · " + String(s.posts ?? "?") + " 帖 · " + String(s.users ?? "?") + " 用户" + ((o.threads && o.threads[0]) ? " top=" + String(o.threads[0].id) : ""); }
                if (tool === "collab_feed") { const c = o.counts || {}; return tool + " ok " + String(o.thread) + " " + String(c.posts ?? (o.posts || []).length) + "帖·" + String(c.comments ?? "?") + "评论·" + String(c.users ?? "?") + "用户 since=" + String(o.since_seq ?? 0); }
                if (tool === "collab_summary") return tool + " ok threads=" + String(o.threads) + " posts=" + String(o.posts) + " comments=" + String(o.comments) + " users=" + String(o.users) + " me=" + String((o.me && o.me.user) || "?");
                if (tool === "collab_post") return tool + " ok " + String(o.thread) + " #" + String(o.seq) + " " + String(o.user) + ((o.mentions || []).length > 0 ? " @" + String(o.mentions.join(" @")) : "");
                if (tool === "collab_comment") return tool + " ok " + String(o.thread) + " #" + String(o.seq) + " ↳#" + String(o.reply_to) + " " + String(o.user);
                return tool + " ok " + size + " chars";
            }
            // v0.5.15：错误摘要带 kind（denied/jail 拒绝可观测）；v0.5.17：
            // cloud_* 执行车道的失败面用 reason 字段（白名单/host 门控/监狱拒因）
            const kind = o.kind !== undefined ? " [" + String(o.kind) + "]" : o.refused !== undefined ? " [" + String(o.refused) + "]" : "";
            return tool + " error" + kind + " " + String(o.error || o.reason || "").split("\n")[0].slice(0, 120);
        } catch (e) {
            return "result " + String(result).slice(0, 100);
        }
    }
}
