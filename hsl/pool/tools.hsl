/// v0.5.16 RBAC 判定查询（capabilities #149）：lib/rbac.ts 同源（只读——
/// 门控本身在 execute_tool 分发处，本工具只是策略查询面）。只读工具。
fn tool_rbac_check(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const action = String(a.action || "");
            if (!action) return JSON.stringify({ tool: "rbac_check", ok: false, error: "args.action 必填（如 tool:fs_write / cli:db）" });
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "rbac_check", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const rbac = await import(root + "/lib/rbac.ts");
            const role = a.role != null && String(a.role) !== "" ? String(a.role) : String($host.env.get("ORG_RBAC_ROLE") || "owner");
            const loaded = rbac.loadRbac(ws);
            const d = rbac.rbacCheck(loaded.policy, role, action);
            return JSON.stringify({
                tool: "rbac_check", ok: true, allowed: d.allowed, role: d.role, action: d.action,
                rule: d.rule, ...(d.reason ? { reason: d.reason } : {}),
                roles: rbac.rbacRoles(loaded.policy),
                policy_file: loaded.file, ...(loaded.fallbackReason ? { fallback_reason: loaded.fallbackReason } : {}),
            });
        } catch (e) {
            return JSON.stringify({ tool: "rbac_check", ok: false, error: String(e && e.message || e) });
        }
    }
}

/// v0.5.16 容器/IaC 静态扫描（capabilities #147）：lib/iacscan.ts 同源
/// （16 规则三族：Dockerfile/compose/terraform）。只读工具。
fn tool_iac_scan(args: String) -> String {
    native typescript {
        try {
            const a = JSON.parse(args);
            const root = (() => { const d = String($host.env.get("DHV_TS") || "").replace(/\\/g, "/"); const m = d.match(/^(.*)\/toolchain\/dhv-ts\/src\/main\.(ts|js)$/); return m ? m[1] : ""; })();
            if (!root) return JSON.stringify({ tool: "iac_scan", ok: false, error: "org 根目录未定位（DHV_TS 缺席，需经 org 宿主启动）" });
            const pathMod = await import("node:path");
            const wsRaw = String($host.config.workspace || ".").replace(/\\/g, "/");
            const ws = pathMod.isAbsolute(wsRaw) ? wsRaw : pathMod.resolve(process.cwd(), wsRaw);
            const iac = await import(root + "/lib/iacscan.ts");
            const dirs = Array.isArray(a.dirs) ? a.dirs.map(String).filter(Boolean).slice(0, 10) : undefined;
            const r = dirs && dirs.length > 0 ? iac.scanIac(ws, { dirs }) : iac.scanIac(ws);
            const order = { high: 0, medium: 1, low: 2 };
            const hits = r.hits.slice().sort((x, y) => order[x.severity] - order[y.severity]);
            return JSON.stringify({
                tool: "iac_scan", ok: true, files: r.files, scanned: r.scanned, took_ms: r.tookMs,
                truncated: r.truncated, rules: iac.IAC_RULES.length,
                high: hits.filter((h) => h.severity === "high").length,
                hits: hits.slice(0, 100).map((h) => ({ rule: h.ruleId, file: h.file, line: h.line, severity: h.severity, message: h.message, hint: h.hint })),
            });
        } catch (e) {
            return JSON.stringify({ tool: "iac_scan", ok: false, error: String(e && e.message || e) });
        }
    }
}

