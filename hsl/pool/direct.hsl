// ============================================================================
// org/pool/direct.hsl — 直连前台：用户可寻址任意池内专家（多轮会话）
// ============================================================================
// 治理原则（设计铁律 #1）：调度权可绕，知情权与记账权不可绕。
//   - 事件上总线（每次直连发 direct_open / direct_close 事件）
//   - 花销记独立科目（tokens 独立计数，artifact: direct-ledger.jsonl）
//   - 结束后纪要回写（memo → 工作区 runtime/direct-memos.md，主控可读）
// 用户在场（Direct 模式）：confirm 态能力就地放行 —— 天花板管缺席，确认管在场。
//
// 多轮会话（v0.3.0）：会话语义以「磁盘会话账本」落地（BNF v1.5 无 pool/session
// 实例语义，内存级多轮是 v1.6 路线图项）：
//   - 会话账本：runtime/sessions/<expert>/<session>.jsonl（跨 CLI 调用持久）
//   - 上下文：每轮把账本中的历史问答织入提示词（专家带着会话史作答）
//   - 一次进程可跑多轮（ORG_ASK_TURNS 传 JSON 问题数组，逐轮消费轨道）
// ============================================================================
import { AccessMode, CapabilityPolicy } from "../policy/capability.hsl";
import { ExpertError } from "../types/errors.hsl";
import { ExpertManifest, Registry } from "../registry/manifest.hsl";
import { ask, ask_conv } from "../providers/model.hsl";
import { tool_mode, tools_prompt, parse_tool_calls, execute_tool, tool_result_message, ToolMode } from "./tools.hsl";
import { json_escape } from "../registry/manifest.hsl";

/// 直连会话（一次 org ask = 一轮问答；多轮 = 账本上的多行）。
/// ctx_tokens：本轮提示词+回答的上下文占用估算（Codex 风格窗口计量）。
#[derive(Debug, Clone)]
export struct DirectSession {
    expert: String,
    session: String,
    question: String,
    answer: String,
    tokens: u32,
    ctx_tokens: u32,
    turn: u32,
}

/// 直连入口（org ask <expert> "<question>" [--session <id>]）。
export fn main() -> Result<(), ExpertError> {
    // CLI 经环境变量传参：
    //   ORG_ASK_EXPERT / ORG_ASK_QUESTION —— 单轮
    //   ORG_ASK_TURNS —— 多轮（JSON 字符串数组；一次进程消费多条轨道）
    //   ORG_ASK_SESSION —— 会话 id（缺省 default）
    let expert: String = native typescript {
        return $host.env.get("ORG_ASK_EXPERT") || "";
    };
    if expert.len() == 0 {
        return Err(ExpertError::new(
            String::from("direct"),
            String::from("usage"),
            String::from("org ask <expert> \"<question>\"（专家名必填）"),
        ));
    }
    let turns: Vec<String> = read_turns();
    if turns.len() == 0 {
        return Err(ExpertError::new(
            String::from("direct"),
            String::from("usage"),
            String::from("org ask <expert> \"<question>\"（问题必填）"),
        ));
    }
    let session_id: String = native typescript {
        return $host.env.get("ORG_ASK_SESSION") || "default";
    };
    let mut i: u32 = 0;
    let total = turns.len() as u32;
    loop {
        let q = turns[i as usize].clone();
        let s = direct(expert.clone(), session_id.clone(), q)?;
        if total > 1 {
            println!("[direct] turn {} —— {}（{} tokens）：", s.turn, s.expert, s.tokens);
        } else {
            println!("[direct] {} 回答（{} tokens）：", s.expert, s.tokens);
        }
        println!("{}", s.answer);
        // 上下文窗口占用（Codex 风格：会话史单调增长，占用可见）
        println!("[ctx] 窗口占用 {}（{} 轮累计）", ctx_line(s.ctx_tokens, 131072), s.turn);
        i += 1;
        if i >= total {
            break;
        }
    }
    Ok(())
}

/// 读取问题列表（多轮 ORG_ASK_TURNS 优先，单轮 ORG_ASK_QUESTION 兜底）。
fn read_turns() -> Vec<String> {
    let raw: String = native typescript {
        const t = $host.env.get("ORG_ASK_TURNS");
        if (t && t.length > 0) return t;
        return "";
    };
    if raw.len() > 0 {
        let list: Vec<String> = native typescript {
            try {
                const arr = JSON.parse(raw);
                if (Array.isArray(arr) === false) return [];
                return arr.map((x) => String(x));
            } catch (e) {
                return [];
            }
        };
        return list;
    }
    let single: String = native typescript {
        return $host.env.get("ORG_ASK_QUESTION") || "";
    };
    let mut out: Vec<String> = Vec::new();
    if single.len() > 0 {
        out.push(single);
    }
    out
}

/// 直连一轮：能力核对 → 寻址 → 会话史装载 → 问答 → 记账 → 纪要回写。
export async fn direct(expert: String, session_id: String, question: String) -> Result<DirectSession, ExpertError> {
    let mut policy = CapabilityPolicy::default();
    let registry = Registry::load(String::from("registry"))?;

    // 直连模式：用户在场 —— confirm 态能力就地放行（天花板管缺席，确认管在场）
    policy.decide(String::from("llm_call"), AccessMode::Direct)?;

    // 事件上总线（知情权不可绕）
    let expert_evt = expert.clone();
    let _ = native typescript {
        $host.events.emit("journal", { name: "direct_open", detail: expert_evt });
        return true;
    };

    // 专家寻址：注册表命中（在岗才可直连）
    let manifest = find_direct_target(registry, expert.clone());
    let m = match manifest {
        Some(found) => found,
        None => {
            return Err(ExpertError::new(
                String::from("direct"),
                String::from("not-found"),
                format!("专家 {} 不在注册表（直连仅可寻址在岗专家）", expert),
            ));
        },
    };

    // 会话史装载（磁盘会话账本：跨 CLI 调用的多轮上下文）
    let history = load_history(expert.clone(), session_id.clone());
    let turn = history.len() as u32 + 1;

    // 问题经模型网关（轨道 direct:<expert>；历史织入提示词 —— 会话连续性）
    let track = format!("direct:{}", expert);
    // v0.5.3 agent 化：系统提示三段组装 —— 专家描述 + 会话史 +（可选）
    // 工作区规则（AGENTS.md）+ 专家长期记忆 + 工具协议（ORG_TOOLS 开启时）
    let system = format!(
        "You are the expert: {}. Answer the user directly and briefly.{}{}{}",
        m.description,
        render_history(history.clone()),
        agents_rules(),
        memory_block(expert.clone()),
    );
    let mode = tool_mode();
    if mode == ToolMode::Off {
        let answer = ask(track, system, question.clone()).await?;
        return Ok(finish_direct(expert.clone(), session_id.clone(), question.clone(), answer, turn, m.description.clone(), history.clone()));
    } else {
        // 工具环（v0.5.3）：模型可调用工作区工具（读/写/执行，能力门）。
        // 有界循环（ORG_TOOL_MAX_TURNS，缺省 6）—— 防失控；每轮轨道消耗
        // 一条剧本（scripted）/一次真实调用（real）。
        let system_full = format!("{}{}", system, tools_prompt(mode.clone()));
        let max_turns = tool_max_turns();
        let mut turns: Vec<(String, String)> = Vec::new();
        turns.push((String::from("user"), question.clone()));
        let mut answer = String::new();
        let mut round: u32 = 0;
        loop {
            if round >= max_turns {
                answer = format!("（工具环达到 {} 轮上限 —— 强制收束；最后一轮原始输出）\n{}", max_turns, answer);
                break;
            }
            let turns_json = turns_to_json(turns.clone());
            let raw = ask_conv(track.clone(), system_full.clone(), turns_json).await?;
            let calls = parse_tool_calls(raw.clone());
            if calls.len() == 0 {
                answer = raw;
                break;
            }
            turns.push((String::from("assistant"), raw.clone()));
            let mut results: Vec<String> = Vec::new();
            for c in calls.iter() {
                let r = execute_tool(policy.clone(), c.clone()).await;
                results.push(r);
            }
            let results_json = results_to_json(results);
            turns.push((String::from("user"), tool_result_message(results_json)));
            round += 1;
        }
        return Ok(finish_direct(expert.clone(), session_id.clone(), question.clone(), answer, turn, m.description.clone(), history.clone()));
    }
}

/// 直连收尾（v0.5.3 抽出）：记账 → 会话账本 → 事件 → 纪要 → 组装结果。
/// 工具环与纯问答共用同一条收尾链（治理不可绕：知情权与记账权）。
fn finish_direct(
    expert: String,
    session_id: String,
    question: String,
    answer: String,
    turn: u32,
    desc: String,
    history: Vec<TurnRecord>,
) -> DirectSession {
    // 花销记账（独立科目：direct-ledger.jsonl；多轮累加而非覆盖）
    let tokens = estimate_tokens(question.clone(), answer.clone());
    // 上下文占用（近似口径，与 lib/engine.ts 同源：系统提示含会话史）
    let ctx_tokens = estimate_context(desc.clone(), history.clone(), question.clone(), answer.clone());
    let ledger_line = format!(
        "{{\"expert\":\"{}\",\"session\":\"{}\",\"turn\":{},\"question\":\"{}\",\"tokens\":{},\"ctx_tokens\":{},\"accepted\":1}}\n",
        json_escape(expert), json_escape(session_id), turn, json_escape(question), tokens, ctx_tokens
    );
    let _ = native typescript {
        let prev = "";
        try {
            // 产物目录在工作区内时（org 默认布局），读取既有账本续写
            const outdir = String($host.config.outdir || "");
            const ws = String($host.config.workspace || "");
            if (outdir.startsWith(ws)) {
                const rel = outdir.slice(ws.length + 1).replace(/\\/g, "/") + "/direct-ledger.jsonl";
                prev = $host.fs.read(rel);
            }
        } catch (e) {
            prev = "";
        }
        $host.artifacts.write("direct-ledger.jsonl", prev + ledger_line);
        return true;
    };

    // 会话账本落盘（runtime/sessions/<expert>/<session>.jsonl；多轮连续性载体）
    append_session(expert.clone(), session_id.clone(), turn, question.clone(), answer.clone(), tokens, ctx_tokens);

    // 上下文占用上总线（知情权不可绕：TUI / status 消费 direct_ctx 事件）
    // detail 走字符串通道（与 direct_open 等事件同构，store 侧正则解析）
    let ctx_detail = format!("{}/{} turn={} ctx={} window=131072", expert, session_id, turn, ctx_tokens);
    let _ = native typescript {
        $host.events.emit("journal", { name: "direct_ctx", detail: ctx_detail });
        return true;
    };

    // 纪要回写（主控编排上下文保持完整 —— 事后知情，不事前审批）
    let memo = format!("direct session with {} [{}] turn {} :: {} -> {}", expert, session_id, turn, question, answer);
    let _ = native typescript {
        try {
            const prev = $host.fs.read("runtime/direct-memos.md");
            $host.fs.write("runtime/direct-memos.md", prev + memo + "\n");
        } catch (e) {
            $host.fs.write("runtime/direct-memos.md", memo + "\n");
        }
        return true;
    };
    let close_evt = expert.clone();
    let _ = native typescript {
        $host.events.emit("journal", { name: "direct_close", detail: close_evt });
        return true;
    };

    DirectSession {
        expert: expert,
        session: session_id,
        question: question,
        answer: answer,
        tokens: tokens,
        ctx_tokens: ctx_tokens,
        turn: turn,
    }
}

/// 会话消息序列化（工具环的 turns JSON：[{"role":..,"content":..}]）。
fn turns_to_json(turns: Vec<(String, String)>) -> String {
    let out: String = native typescript {
        return JSON.stringify(turns.map((t) => ({ role: t[0], content: t[1] })));
    };
    out
}

/// 工具结果序列化（JSON 数组字符串）。
fn results_to_json(results: Vec<String>) -> String {
    let out: String = native typescript {
        return JSON.stringify(results);
    };
    out
}

/// 工具环轮数上限（ORG_TOOL_MAX_TURNS，缺省 6；下限 1 上限 16）。
fn tool_max_turns() -> u32 {
    let n: u32 = native typescript {
        const v = Number($host.env.get("ORG_TOOL_MAX_TURNS") || "6");
        if (!Number.isFinite(v)) return 6;
        return Math.max(1, Math.min(16, Math.floor(v)));
    };
    n
}

/// 工作区规则注入（AGENTS.md / .org/rules.md —— codex 的 AGENTS.md 同形）。
/// 文件存在即织入系统提示（≤8KB 截断可观测）；缺失返回空串（零成本）。
fn agents_rules() -> String {
    let out: String = native typescript {
        const CAP = 8192;
        for (const f of ["AGENTS.md", ".org/rules.md"]) {
            try {
                const content = $host.fs.read(f);
                if (content && content.trim().length > 0) {
                    const body = content.length > CAP ? content.slice(0, CAP) + "\n…(truncated)" : content;
                    return "\n\n## Workspace rules (AGENTS.md — MUST follow)\n" + body;
                }
            } catch (e) { /* 无此文件：下一个候选 */ }
        }
        return "";
    };
    out
}

/// 专家长期记忆注入（runtime/memories/<expert>.md 尾部 40 行 —— 跨会话
/// 的用户偏好/项目约定沉淀；org memory add 管理）。
fn memory_block(expert: String) -> String {
    let path = format!("runtime/memories/{}.md", expert);
    let p = path.clone();
    let out: String = native typescript {
        try {
            const content = $host.fs.read(p);
            if (!content || content.trim().length === 0) return "";
            const lines = content.split("\n");
            const tail = lines.slice(-40).join("\n");
            return "\n\n## Long-term memory for this expert (remember these)\n" + tail;
        } catch (e) {
            return "";
        }
    };
    out
}

/// 直连寻址（v1：注册表在岗检查；池实例忙时排队是路线图项）。
fn find_direct_target(registry: Registry, name: String) -> Option<ExpertManifest> {
    for m in registry.experts.iter() {
        if m.name == name {
            return Some(m.clone());
        }
    }
    None
}

/// 会话史条目（轮次问答对）。
#[derive(Debug, Clone)]
struct TurnRecord {
    turn: u32,
    question: String,
    answer: String,
}

/// 装载会话史（runtime/sessions/<expert>/<session>.jsonl；缺失 = 新会话）。
fn load_history(expert: String, session_id: String) -> Vec<TurnRecord> {
    let path = format!("runtime/sessions/{}/{}.jsonl", expert, session_id);
    let raw: String = native typescript {
        try {
            return $host.fs.read(path);
        } catch (e) {
            return "";
        }
    };
    let mut out: Vec<TurnRecord> = Vec::new();
    if raw.len() == 0 {
        return out;
    }
    let rows: Vec<(u32, String, String)> = native typescript {
        try {
            const out = [];
            for (const line of raw.split("\n")) {
                if (line.trim().length === 0) continue;
                const o = JSON.parse(line);
                out.push([Math.floor(Number(o.turn ?? 0)), String(o.question ?? ""), String(o.answer ?? "")]);
            }
            return out;
        } catch (e) {
            return [];
        }
    };
    for r in rows.iter() {
        out.push(TurnRecord { turn: r.0, question: r.1, answer: r.2 });
    }
    out
}

/// 会话史渲染（提示词注入形态；空会话返回空串）。
fn render_history(history: Vec<TurnRecord>) -> String {
    if history.len() == 0 {
        return String::new();
    }
    let mut out = String::from("\n\nSession history (previous turns, oldest first):");
    for t in history.iter() {
        out.push_str(format!("\n[turn {}] Q: {} / A: {}", t.turn, t.question, t.answer).as_str());
    }
    out.push_str("\n\nContinue this session naturally.");
    out
}

/// 会话账本追加（JSONL；目录自动建；ctx_tokens 为窗口占用估算）。
fn append_session(expert: String, session_id: String, turn: u32, question: String, answer: String, tokens: u32, ctx_tokens: u32) {
    let path = format!("runtime/sessions/{}/{}.jsonl", expert, session_id);
    let line = format!(
        "{{\"turn\":{},\"question\":\"{}\",\"answer\":\"{}\",\"tokens\":{},\"ctx_tokens\":{}}}\n",
        turn, json_escape(question), json_escape(answer), tokens, ctx_tokens
    );
    let _ = native typescript {
        let prev = "";
        try {
            prev = $host.fs.read(path);
        } catch (e) {
            prev = "";
        }
        $host.fs.write(path, prev + line);
        return true;
    };
}

/// 粗估 token（问答各按 1 token / 3 chars 折算；诚实边界：非精确计量）。
fn estimate_tokens(question: String, answer: String) -> u32 {
    let raw = (question.len() + answer.len()) / 3;
    raw as u32
}

/// 上下文占用估算（与 lib/engine.ts contextUsageOf 同口径）：系统提示
/// （专家描述 + 会话史）+ 本轮问答，chars/3 折算 + 每轮结构开销近似。
fn estimate_context(desc: String, history: Vec<TurnRecord>, question: String, answer: String) -> u32 {
    let mut chars = desc.len() + question.len() + answer.len() + 64;
    for t in history.iter() {
        chars += t.question.len() + t.answer.len() + 24;
    }
    (chars / 3) as u32
}

/// 千分位 k 格式（8400 → "8.4k"；与 TS 侧 fmt 同形）。
fn fmt_k(n: u32) -> String {
    if n >= 1000 {
        let whole = n / 1000;
        let frac = (n % 1000) / 100;
        format!("{}.{}k", whole, frac)
    } else {
        format!("{}", n)
    }
}

/// 上下文计量条（Codex 风格）：▓▓░░ 8.4k/131.1k（6.4%）。
/// 整数运算（千分数避免浮点），12 格 meter。
fn ctx_line(used: u32, window: u32) -> String {
    let mut denom = window;
    if denom == 0 {
        denom = 1;
    }
    let pct = (used * 1000) / denom;
    let mut filled = (used * 12) / denom;
    if filled > 12 {
        filled = 12;
    }
    if used > 0 && filled == 0 {
        filled = 1;
    }
    let mut bar = String::new();
    let mut i: u32 = 0;
    loop {
        if i >= 12 {
            break;
        }
        if i < filled {
            bar.push_str("▓");
        } else {
            bar.push_str("░");
        }
        i += 1;
    }
    format!("{} {}/{}（{}.{}%）", bar, fmt_k(used), fmt_k(window), pct / 10, pct % 10)
}
