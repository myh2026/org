// ============================================================================
// org/factory/pipeline.hsl — 专家工厂：生成与验收管线 + 补丁合入流水线
// ============================================================================
// 两条生产线共用同一道闸门（设计铁律 #4：同一意见第二次出现，修专家本体）：
//
//   新品线：规格提取 → HSL 生成 → dhv check → fixture 验收 → 入库登记
//   补丁线：提案（内核提议权）→ fs.edit → dhv check → smoke 验收 → 版本登记
//
// 生成者与合入者分离：主控（或任何 LLM）只有补丁提议权，按合并键的是本管线。
// 嵌套解释器调用 = 真实质量闸门：机器生成的 .hsl 必须真的通过 dhv check、
// 真的跑通 scripted fixture 验收，才允许注册上岗。
//
// 环境约定：DHV_TS 指向 dhv-ts/src/main.ts 的绝对路径（CLI 负责注入）。
// ============================================================================

import { TaskSpec } from "../contracts/contract.hsl";
import { OrgError } from "../types/errors.hsl";
import { ExpertManifest, PatchRecord } from "../registry/manifest.hsl";
import { Registry, json_escape } from "../registry/manifest.hsl";
import { ask } from "../providers/model.hsl";
import { MINT_SPEC_PROMPT, MINT_SOURCE_PROMPT, MINT_SAMPLE_PROMPT } from "../config/resources.hsl";

/// 管线阶段（状态机形态的 AgentLoop 素材）。
enum MintStage {
    ExtractSpec,
    GenerateSource,
    StructuralCheck,
    FixtureExam,
    Register,
    Done,
}

/// 生成有界再生成上限（v0.4.12）：首生成 + 2 次携带诊断的再生成 ——
/// 与监督回路的有界返工（DEFAULT_MAX_REVISES=2）同构：审查意见可返工，
/// 生成物的 check 诊断同样应反馈给生成器而不是直接炸全场（deepseek
/// 真实模式实测：首生成物是 Rust 风格，check 拒绝后整个 run 直接 Err）。
const MAX_MINT_ATTEMPTS: u32 = 3;

/// 边事件（G5）。
enum MintSignal {
    SpecReady,
    SourceReady,
    CheckPassed,
    ExamPassed,
    Registered,
}

/// 专家规格（第 1 步产物：从任务契约反推）。
#[derive(Debug, Clone)]
export struct ExpertSpec {
    name: String,
    description: String,
    capabilities: Vec<String>,
    acceptance: String,
    /// 验收样本 payload（fixture 反推的原料）。
    sample_payload: String,
}

impl ExpertSpec {
    fn blank() -> ExpertSpec {
        ExpertSpec {
            name: String::new(),
            description: String::new(),
            capabilities: Vec::new(),
            acceptance: String::new(),
            sample_payload: String::new(),
        }
    }
}

/// 闸门结果（第 3/4 步产物）。
#[derive(Debug, Clone)]
export struct MintGate {
    check_ok: bool,
    check_log: String,
    exam_ok: bool,
    exam_log: String,
}

impl MintGate {
    fn new() -> MintGate {
        MintGate { check_ok: false, check_log: String::new(), exam_ok: false, exam_log: String::new() }
    }
}

/// 补丁提案（内核的提议权物化；合并键在本管线）。
#[derive(Debug, Clone)]
export struct PatchProposal {
    expert: String,
    /// 触发意见（复发键；写入 provenance.trigger）。
    trigger: String,
    old_text: String,
    new_text: String,
}

/// 工厂 graph：为「库中无匹配且具备复用价值」的子任务现场铸专家。
///
/// 五步全部静态可追踪；任何一步失败即 Err（不允许半成品上岗）。
export graph Factory(goal: String, skills: Vec<String>, payload_preview: String) -> Result<ExpertManifest, OrgError> {
    // node 声明：管线各阶段的物化依赖
    node mut spec: ExpertSpec = ExpertSpec::blank();
    node mut source: String = String::new();
    node gate: MintGate = MintGate::new();
    node registry: Registry = Registry::new(String::from("registry"));

    // 管线拓扑（直线流；G2 端点已声明，G4 全部可达）
    edge spec -> source on MintSignal::SpecReady;
    edge source -> gate on MintSignal::SourceReady;
    edge gate -> registry on MintSignal::ExamPassed;
    edge registry -> spec on MintSignal::Registered;

    // 主控提案的补丁位（复用同管线的闸门）
    let mut stage = MintStage::ExtractSpec;
    // 有界再生成状态（v0.4.12）：尝试计数 + 上一次 check 诊断（反馈给生成器）
    let mut mint_attempts: u32 = 0;
    let mut repair_feedback: String = String::new();

    // AgentLoop（G1）：阶段状态机推进
    loop {
        match stage.clone() {
            MintStage::ExtractSpec => {
                // v0.4.12：把子任务技能标签织入 brief —— mint_spec 的 capabilities
                // 必须逐字包含（否则登记后检索 serves 会失配：分解器与规格提取是
                // 两次独立模型输出，词汇表会漂移，deepseek 实测抓到）。
                let brief = format!("{}\n子任务技能标签（capabilities 必须逐字包含）: {}", goal.clone(), skills.join(","));
                let raw = ask(String::from("mint_spec"), MINT_SPEC_PROMPT.clone(), brief).await?;
                spec = parse_spec(raw)?;
                stage = MintStage::GenerateSource;
            },
            MintStage::GenerateSource => {
                let mut brief = format!("{}\n技能标签: {}", spec.description.clone(), skills.join(","));
                if payload_preview.trim().len() > 0 {
                    // v0.4.13：载荷形态织入生成器 brief —— mint_hsl 与 mint_fixture
                    // 是两次独立模型调用，字段名词汇表会漂移（实测生成器找
                    // "date" 字段而样本用「日期」→ 闸门必挂）。同一预览喂两侧，
                    // 词汇表钉死在真实载荷上。
                    let head = payload_preview.trim();
                    let clipped: String = native typescript {
                        return head.slice(0, 400);
                    };
                    brief = format!(
                        "{}\n输入载荷形态（专家将收到此结构的载荷，字段名以此为准）：\n{}",
                        brief, clipped
                    );
                }
                if repair_feedback.len() > 0 {
                    // 携带 check 诊断的再生成（有界）：闸门拒绝不是终点，
                    // 诊断反馈给生成器 —— 与审查 Revise 的有界返工同构。
                    // 附最常犯三错的速查（真实模型实测：use→Rust 风格、
                    // 虚构 ./std/*.hsl 路径、调用不存在的宿主 API）。
                    brief = format!(
                        "{}\n\n上一次生成物未通过 dhv check（结构闸门，第 {} 次）。诊断信息：\n{}\n请针对诊断修复，重新输出完整的 HSL 文件。速查：Vec/HashMap/String/Option/Result 是内建类型（绝不 import、绝无 use）；用户模块 import {{ Foo }} from \"./dir/file.hsl\"；宿主 API 只能在 native typescript 块内调用（$host.fs / $host.json / $host.artifacts）。",
                        brief, mint_attempts, repair_feedback
                    );
                }
                let raw = ask(String::from("mint_hsl"), MINT_SOURCE_PROMPT.clone(), brief).await?;
                source = raw.trim();
                mint_attempts = mint_attempts + 1;
                stage = MintStage::StructuralCheck;
            },
            MintStage::StructuralCheck => {
                let written = write_source(spec.name.clone(), source.clone())?;
                let out = dhv_check_gate(written);
                gate.check_ok = out.ok;
                gate.check_log = out.output;
                if out.ok {
                    stage = MintStage::FixtureExam;
                } else if mint_attempts < MAX_MINT_ATTEMPTS {
                    println!("[factory] check 未过（第 {}/{} 次），携带诊断再生成", mint_attempts, MAX_MINT_ATTEMPTS);
                    repair_feedback = out.output;
                    stage = MintStage::GenerateSource;
                } else {
                    return Err(OrgError::factory(format!(
                        "dhv check 拒绝生成物（{} 次再生成均未过结构闸门，不允许上岗）：\n{}",
                        mint_attempts, out.output
                    )));
                }
            },
            MintStage::FixtureExam => {
                println!("[factory] stage=Exam");
                let sample = sample_spec(spec.clone(), payload_preview.clone())?;
                // 显式约定车道（不走 resolve_dispatch_paths）：此时新专家尚未注册，
                // 若注册表恰有同名导入专家，按名解析会劫持 Exam 寻址跑错文件。
                let entry = format!("registry/experts/{}.hsl", spec.name);
                let fixture = format!("factory/fixtures/{}.fixture.json", spec.name);
                let out = run_expert_at(entry, fixture, sample, String::from("factory/mint-out"));
                // 行为闸门：样本必须过覆盖率线（验收语义 ≠ 执行语义）
                gate.exam_ok = out.ok && read_acceptance_coverage(String::from("factory/mint-out"));
                gate.exam_log = out.output;
                if gate.exam_ok {
                    stage = MintStage::Register;
                } else if mint_attempts < MAX_MINT_ATTEMPTS {
                    // v0.4.13：Exam 失败也走有界再生成（与 check 失败同构）——
                    // 此前行为闸门一挂直接 Err 炸工厂，但行为缺陷（字段名错认/
                    // 覆盖率不足）恰恰是诊断反馈最能修的形态（实测：生成器找
                    // "date" 而样本用「日期」，一次反馈即可对齐词汇表）。
                    println!("[factory] exam 未过（第 {}/{} 次），携带行为诊断再生成", mint_attempts, MAX_MINT_ATTEMPTS);
                    repair_feedback = out.output;
                    stage = MintStage::GenerateSource;
                } else {
                    return Err(OrgError::factory(format!(
                        "fixture 验收未通过（{} 次再生成均不合格，不允许上岗）：\n{}",
                        mint_attempts, out.output
                    )));
                }
            },
            MintStage::Register => {
                println!("[factory] stage=Register");
                let manifest = register_expert(spec.clone(), gate.clone(), skills.clone())?;
                let _ = manifest;
                stage = MintStage::Done;
            },
            MintStage::Done => break,
        }
    }

    // 登记位产出：从磁盘注册表取回（register_expert 已写入并提交）
    // v0.4.13：按名取回（身份已知）—— 此前按 goal+skills 语义检索，B 复用
    // 语义地板（REUSE_AFFINITY_RATIO）落地后，mint_spec 描述与 goal 的词面
    // 漂移会让登记后检索落空 →「管线状态不一致」假 Err（登记是事实，检索
    // 是路由 —— 身份已知时语义检索是多余的自由度）。
    println!("[factory] stage=Done");
    let disk_registry = Registry::load(String::from("registry"))?;
    let found = disk_registry.find_by_name(spec.name.clone());
    match found {
        Some(m) => Ok(m),
        None => Err(OrgError::factory(format!(
            "登记后按名检索失败（{} 未在注册表 —— 管线状态不一致）", spec.name
        ))),
    }
}

/// 补丁合入流水线（变更分级闸门：knowledge / flow / capability）。
///
/// 提议权在内核；合并键在此。任何闸门不过 → 回滚编辑并 Err（宁可拒绝不可静默）。
/// 变更分级（机械启发式，诚实边界见 classify_patch 注释）：
///   knowledge   静态资源 / 规则行      闸门：check + smoke
///   flow        graph 拓扑关键词       闸门：check + smoke + 评测分不得回退
///   capability  #[capability] 注解     闸门：审计事件，仅用户可批准（env 门）
export fn merge_patch(registry: Registry, proposal: PatchProposal) -> Result<ExpertManifest, OrgError> {
    let manifest = match registry.find_by_name(proposal.expert.clone()) {
        Some(m) => m,
        None => {
            return Err(OrgError::factory(format!("补丁目标专家不存在：{}", proposal.expert)));
        },
    };

    // 0) 变更分级（编辑之前 —— capability 变更被拒时不得触碰源码）
    let change_kind = classify_patch(proposal.old_text.clone(), proposal.new_text.clone());
    let mut gate = String::from("check+smoke");
    if change_kind == String::from("capability") {
        let approved: bool = native typescript {
            return $host.env.get("ORG_CAPABILITY_APPROVED") === "1";
        };
        if approved == false {
            let _ = native typescript {
                $host.events.emit("audit", { event: "capability_change_rejected", expert: proposal.expert, reason: "仅用户可批准（ORG_CAPABILITY_APPROVED=1 缺失）" });
                return true;
            };
            return Err(OrgError::factory(String::from("能力变更补丁被拒：天花板调升只属于用户（审计事件已留痕）")));
        }
        let _ = native typescript {
            $host.events.emit("audit", { event: "capability_change_approved", expert: proposal.expert });
            return true;
        };
        gate = String::from("audit-user-only+check+smoke");
    } else if change_kind == String::from("flow") {
        gate = String::from("full-fixture+no-regress");
    }

    // 1) 版本归档（蓝绿 + 金丝雀的回退原料）：编辑前把当前源存为 <name>@<from>.hsl
    let archive_path = format!("registry/experts/{}@{}.hsl", manifest.name, manifest.version);
    let entry_for_read = manifest.entry_path.clone();
    let archive_for_write = archive_path.clone();
    let _ = native typescript {
        try {
            const src = $host.fs.read(entry_for_read);
            if (src.length > 0) $host.fs.write(archive_for_write, src);
        } catch (e) {
            // 归档失败不阻断补丁（金丝雀将以当前盘上版本为旧侧）
        }
        return true;
    };

    // 2) 提案应用（fs.edit：old_text 必须唯一命中）
    let path = manifest.entry_path.clone();
    let old_text = proposal.old_text.clone();
    let new_text = proposal.new_text.clone();
    let edit_ok: bool = native typescript {
        const r = $host.fs.edit(path, old_text, new_text);
        return r.ok === true;
    };
    if edit_ok == false {
        return Err(OrgError::factory(String::from("补丁锚点未命中（old_text 不存在或不唯一）")));
    }

    // 3) 结构闸门：dhv check（补丁后源码必须仍然合法）
    let check_out = dhv_check_gate(path);
    if check_out.ok == false {
        rollback(path, proposal.new_text.clone(), proposal.old_text.clone());
        return Err(OrgError::factory(format!("补丁未过 dhv check（已回滚）：\n{}", check_out.output)));
    }

    // 4) 行为闸门：smoke（以验收样本重跑：执行 ok + 覆盖率不回退）
    let sample_path = manifest.fixture_path.clone();
    let sample = load_sample_spec(sample_path);
    match sample {
        Some(spec) => {
            let out = run_expert(manifest.name.clone(), spec, String::from("factory/patch-out"));
            let smoke_coverage = read_acceptance_coverage(String::from("factory/patch-out"));
            if out.ok == false || smoke_coverage == false {
                rollback(path, proposal.new_text.clone(), proposal.old_text.clone());
                return Err(OrgError::factory(format!("补丁未过 smoke 验收（已回滚）：\n{}", out.output)));
            }
            // flow 附加闸门：评测分不得回退（补丁后样本覆盖率 >= 在岗 eval_score）
            if change_kind == String::from("flow") {
                let after = read_acceptance_details(String::from("factory/patch-out"));
                if after.0 + 0.01 < manifest.eval_score {
                    rollback(path, proposal.new_text.clone(), proposal.old_text.clone());
                    return Err(OrgError::factory(format!(
                        "补丁未过评测分不回退闸门（已回滚）：coverage {:.2} < eval {:.2}",
                        after.0, manifest.eval_score
                    )));
                }
            }
        },
        None => {
            rollback(path, proposal.new_text.clone(), proposal.old_text.clone());
            return Err(OrgError::factory(String::from("验收样本缺失，补丁合入拒绝（宁可拒绝不可静默）")));
        },
    }

    // 5) 版本登记：蓝绿发布（在岗会话继续旧版；新派单自动加载新版）
    let from_version = manifest.version.clone();
    let to_version = bump_patch_version(from_version.clone());
    let record = PatchRecord {
        from_version: from_version,
        to_version: to_version.clone(),
        change_kind: change_kind,
        trigger: proposal.trigger.clone(),
        gate: gate,
    };
    let patched = manifest.patched(record);
    // 磁盘新鲜态合入：传入 registry 是主控节点的克隆快照，可能滞后于磁盘
    // （同轮 note_use 增量已落盘）—— 以克隆为准 flush 会把其他专家的
    // uses 计数回退（实测：补丁合入后 notice-parser 的 uses 归零）。
    // 同理：patched 自身携带的 uses 也是快照值 —— 合入时保留磁盘最新计数
    // （补丁只改版本与 provenance，不改使用统计）。
    let mut reg = Registry::load(String::from("registry"))?;
    let disk_manifest = reg.clone().find_by_name(proposal.expert.clone());
    let merged = match disk_manifest {
        Some(dm) => patched.clone().set_uses(dm.uses),
        None => patched.clone(),
    };
    let _ = reg.register(merged.clone())?;
    let _ = commit_registry(format!("patch {} -> {} ({})", proposal.expert, to_version, proposal.trigger));
    Ok(merged)
}

/// 补丁变更分级（机械启发式；诚实边界：文本级分类无法与语法级完全等价，
/// v1 以关键词保守归类 —— 宁可过重闸门，不可放行流程变更）。
///   capability：触碰 #[capability 注解 —— 仅用户可批准；
///   flow      ：触碰 graph 拓扑关键词（node/edge/graph/loop/match/fn main）；
///   knowledge ：其余（静态资源 / 规则行）。
fn classify_patch(old_text: String, new_text: String) -> String {
    if new_text.contains("#[capability") || old_text.contains("#[capability") {
        return String::from("capability");
    }
    if contains_flow_keyword(new_text.clone()) || contains_flow_keyword(old_text.clone()) {
        return String::from("flow");
    }
    String::from("knowledge")
}

/// 拓扑关键词检测（classify_patch 辅助）。
fn contains_flow_keyword(text: String) -> bool {
    text.contains("node ") || text.contains("edge ") || text.contains("graph ")
        || text.contains("loop") || text.contains("match ") || text.contains("fn main")
}

/// 派单寻址结果（run_expert 的解析产物）。
#[derive(Debug, Clone)]
struct DispatchPaths {
    /// harness 入口（相对工作区）。
    entry: String,
    /// 嵌套 run 的剧本文件（--fixture；相对工作区）。
    run_fixture: String,
}

/// manifest.fixture 字段的二相解析（source 分相）：
///   source=import    → fixture 字段是嵌套 run 剧本（tracks 形态）→ 直接可用；
///   source=factory   → fixture 字段是验收样本（TaskSpec 形态，factory/samples/）
///                      → 不可作 --fixture，run 剧本走约定 factory/fixtures/。
/// 语义错配（把样本当剧本传）对机械专家零轨道场景恰好无害，但任何消费
/// $host.fixture 轨道的专家会静默拿不到剧本 —— 必须按 source 分相。
export fn run_fixture_of(manifest: ExpertManifest) -> String {
    if manifest.source == String::from("import") {
        manifest.fixture_path.clone()
    } else {
        format!("factory/fixtures/{}.fixture.json", manifest.name)
    }
}

/// 派单寻址（v0.4.6）：注册表登记优先，未登记回退约定车道。
/// 背景：导入专家（org import）的 harness 与剧本都登记在 registry/harnesses/，
/// 原先 run_expert 硬编码 registry/experts/ + factory/fixtures/ 约定 —— B/D
/// 路径派单导入专家必然「入口文件不存在」（issue #6 实测复现）。
/// 注册表从磁盘新鲜加载（note_use / 补丁合入都可能改版本，内存态不可信）。
fn resolve_dispatch_paths(expert: String) -> DispatchPaths {
    let conventional = DispatchPaths {
        entry: format!("registry/experts/{}.hsl", expert),
        run_fixture: format!("factory/fixtures/{}.fixture.json", expert),
    };
    let loaded = Registry::load(String::from("registry"));
    match loaded {
        Ok(reg) => {
            let found = reg.find_by_name(expert.clone());
            match found {
                Some(m) => {
                    // 登记命中：entry 尊重注册表（import 在 harnesses/，factory
                    // 与约定同址）；run 剧本按 source 分相（见 run_fixture_of）。
                    let fixture = run_fixture_of(m.clone());
                    DispatchPaths { entry: m.entry_path.clone(), run_fixture: fixture }
                },
                None => conventional,
            }
        },
        Err(_) => conventional,
    }
}

/// 验收样本落盘 + 嵌套执行专家（真实闸门：子进程解释器）。
/// 寻址：注册表登记优先（导入专家 → registry/harnesses/），未登记回退约定
/// （mint Exam 时新专家尚未注册 —— 此时约定车道正是刚写入的文件）。
export fn run_expert(expert: String, spec: TaskSpec, out_dir: String) -> ShellFlat {
    let paths = resolve_dispatch_paths(expert.clone());
    run_expert_at(paths.entry.clone(), paths.run_fixture.clone(), spec, out_dir)
}

/// 按显式 entry/fixture 执行（金丝雀双跑同晶专家的旧版本归档用）。
export fn run_expert_at(entry: String, fixture: String, spec: TaskSpec, out_dir: String) -> ShellFlat {
    // 工单落盘（嵌套进程的输入契约）
    let spec_path = String::from("factory/current-spec.json");
    let body = spec_to_json(spec);
    let _ = native typescript {
        $host.fs.write(spec_path, body);
        return true;
    };
    let entry_cmd = entry.clone();
    let fixture_cmd = fixture.clone();
    let goal_cmd = spec.goal.clone();
    let out_cmd = out_dir.clone();
    let out = dhv_run_gate(entry_cmd, goal_cmd, fixture_cmd, out_cmd);
    // 执行判定（确定性）：run.json ok —— 覆盖率裁决归监督回路 / 验收调用点，
    // 此处不越权（真实派单首轮低覆盖是合法的 Revise 语义）
    let verdict = read_run_ok(out_dir.clone());
    let flat = ShellFlat {
        ok: out.ok && verdict,
        code: out.code,
        output: concat3(out.output.clone(), verdict_detail(out_dir), coverage_note(out_dir)),
    };
    flat
}

/// 供嵌套执行复用的结果载体（native → HSL 的字段直通形态）。
#[derive(Debug, Clone)]
export struct ShellFlat {
    ok: bool,
    code: u32,
    output: String,
}

// ----------------------------------------------------------------------------
// 步骤实现（管线内部函数）
// ----------------------------------------------------------------------------

/// dhv-ts 解释器路径（嵌套闸门用）。
/// 解析顺序：DHV_TS（CLI 注入）→ 解释器自身入口脚本（process.argv[1]）。
/// 为什么必须有第二级：按 HSL 指南直接跑 `bun dhv-ts/src/main.ts run <entry>`
/// 时没有任何东西注入 DHV_TS，而历史上这里会退回哨兵串 "UNSET_DHV_TS"，
/// 于是 has_bun() 为真、shell 车道被选中，实际执行 `bun UNSET_DHV_TS check …`
/// —— 必然失败。工厂因此每轮都 "check 未过" 三次后降级为 (factory failed)，
/// 而整轮仍报 accepted 3/3 / 退出码 0，故障只藏在 [factory] 日志里。
/// 本 native 块与解释器同进程，argv[1] 即其入口，自我定位不依赖外部变量。
/// 跨平台注记：统一转成正斜杠 —— shell_exec 经 bash -c 执行，反斜杠路径
/// 在 bash 串里会被吃掉；Windows API 接受正斜杠，bun 同样接受。
/// 返回空串 = 自身路径也拿不到，调用方改走进程内车道（语义等价）。
fn dhv_path() -> String {
    let path: String = native typescript {
        const norm = (s) => String(s || "").replace(/\\/g, "/");
        const injected = $host.env.get("DHV_TS");
        if (injected && String(injected).trim().length > 0) return norm(injected);
        try {
            const self = (typeof process !== "undefined" && process.argv && process.argv[1]) ? process.argv[1] : "";
            if (self && /\.(ts|js|mjs|cjs)$/i.test(self)) return norm(self);
        } catch (e) { /* 拿不到自身路径 → 空串，走进程内车道 */ }
        return "";
    };
    path
}

/// 壳执行（首词白名单：bun）。
fn shell_exec(command: String) -> ShellFlat {
    let cmd = command.clone();
    let r = native typescript {
        const out = await $host.shell.run(cmd, { timeoutMs: 90000 });
        return { ok: out.ok, code: out.code, stdout: out.stdout, stderr: out.stderr };
    };
    return flat_from(r.ok, r.code, r.stdout, r.stderr);
}

/// ShellFlat 组装（stdout/stderr 合并，与 shell 输出形态一致）。
fn flat_from(ok: bool, code: u32, stdout: String, stderr: String) -> ShellFlat {
    let mut combined = String::new();
    if stdout.len() > 0 {
        combined.push_str(stdout.as_str());
    }
    if stderr.len() > 0 {
        combined.push_str("\n[stderr]\n");
        combined.push_str(stderr.as_str());
    }
    if combined.len() == 0 {
        combined.push_str(format!("(no output, exit {})", code).as_str());
    }
    ShellFlat { ok: ok, code: code, output: combined }
}

/// bun 可用性探测（嵌入分发场景：单二进制 + 无 bun 的终端用户机）。
fn has_bun() -> bool {
    let r: String = native typescript {
        try {
            return (typeof Bun !== "undefined" && typeof Bun.which === "function" && Bun.which("bun")) ? "1" : "";
        } catch (e) {
            return "";
        }
    };
    return r.len() > 0;
}

/// 结构闸门（dhv check）：bun 在场且解释器路径可解析时走嵌套子进程
/// （蓝绿语义）；否则进程内兜底（$host.dhv.check，fresh loadProgram 状态隔离）。
/// 判据必须同时看 has_bun() 与 dhv_path()：只看 bun 会把「有 bun 但路径不可解析」
/// 送进 shell 车道，拼出一条注定失败的 `bun <空> check …` 命令。
fn dhv_check_gate(file: String) -> ShellFlat {
    if has_bun() && dhv_path().len() > 0 {
        return shell_exec(format!("bun {} check {}", dhv_path(), file));
    }
    let r = native typescript {
        const out = await $host.dhv.check(file);
        return { ok: out.ok, code: out.ok ? 0 : 1, stdout: out.output, stderr: "" };
    };
    return flat_from(r.ok, r.code, r.stdout, r.stderr);
}

/// 嵌套专家执行（fixture 验收 / 磁盘车道）：同 dhv_check_gate 的双车道策略
/// （同一判据：bun 在场 且 解释器路径可解析才走 shell 车道）。
fn dhv_run_gate(entry: String, task: String, fixture: String, out_dir: String) -> ShellFlat {
    if has_bun() && dhv_path().len() > 0 {
        let cmd = format!(
            "bun {} run {} --workspace . --task \"{}\" --model scripted --fixture {} --out {} --quiet",
            dhv_path(), entry, task, fixture, out_dir
        );
        return shell_exec(cmd);
    }
    let r = native typescript {
        // 进程内基准对齐：子进程模式的 bash cwd = workspace，这里把相对路径
        // 显式解析到 workspace（$host.config.workspace），语义逐项等价。
        const ws = $host.config.workspace;
        const isAbs = (p) => /^([A-Za-z]:[\\/]|\/)/.test(p);
        const joinWs = (p) => isAbs(p) ? p : (ws.endsWith("/") ? ws + p : ws + "/" + p);
        const out = await $host.dhv.run([
            "run", joinWs(entry), "--workspace", ws, "--task", task,
            "--model", "scripted", "--fixture", joinWs(fixture),
            "--out", joinWs(out_dir), "--quiet",
        ]);
        return { ok: out.ok, code: out.code, stdout: out.stdout, stderr: out.stderr };
    };
    return flat_from(r.ok, r.code, r.stdout, r.stderr);
}

/// 规格解析（mint_spec 轨道输出 → ExpertSpec）。
fn parse_spec(raw: String) -> Result<ExpertSpec, OrgError> {
    let fields: HashMap<String, String> = native typescript {
        try {
            return $host.json.fields(raw);
        } catch (e) {
            const m = new Map();
            m.set("error", String(e && e.message || e));
            return m;
        }
    };
    if fields.contains_key(String::from("error")) {
        return Err(OrgError::factory(format!(
            "规格提取输出不是合法 JSON：{}",
            fields.get(String::from("error")).unwrap_or(String::from("?"))
        )));
    }
    let name = fields.get(String::from("name")).unwrap_or(String::from("minted-expert"));
    let description = fields.get(String::from("description")).unwrap_or(String::from(""));
    let acceptance = fields.get(String::from("acceptance")).unwrap_or(String::from("coverage >= 0.95"));
    let caps_raw = fields.get(String::from("capabilities")).unwrap_or(String::from("[]"));
    let capabilities: Vec<String> = native typescript {
        const arr = JSON.parse(caps_raw);
        if (Array.isArray(arr) === false) return [];
        return arr.map((x) => String(x));
    };
    Ok(ExpertSpec {
        name: name,
        description: description,
        capabilities: capabilities,
        acceptance: acceptance,
        sample_payload: String::new(),
    })
}

/// 源码落盘（registry/experts/<name>.hsl）。
fn write_source(name: String, source: String) -> Result<String, OrgError> {
    if name.len() == 0 || source.len() == 0 {
        return Err(OrgError::factory(String::from("生成物为空（name / source 缺失）")));
    }
    let path = format!("registry/experts/{}.hsl", name);
    let body = source.clone();
    let _ = native typescript {
        $host.fs.write(path, body);
        return true;
    };
    Ok(path)
}

/// 验收样本（从任务规格反推；scripted 模式由剧本轨道提供）。
/// v0.4.13：brief 织入真实载荷预览 —— 此前只给 acceptance，样本格式纯靠
/// 模型想象（实测单引号伪 JSON `'record_id':'R001'`），minted 专家按真实
/// 载荷格式解析必然挂自己的闸门（工厂 3 连 mint 全废的根因）。
/// 同时落盘两类资产：
///   factory/samples/<name>.json          验收样本工单（补丁 smoke 的重放原料）
///   factory/fixtures/<name>.fixture.json 嵌套运行的空剧本（机械专家零轨道）
async fn sample_spec(spec: ExpertSpec, payload_preview: String) -> Result<TaskSpec, OrgError> {
    let mut brief = spec.acceptance.clone();
    if payload_preview.trim().len() > 0 {
        // 截断预览（前 400 字符）：格式约束而非内容注入 —— 样本必须用与真实
        // 载荷相同的结构形态，否则闸门检验的是另一个世界的行为。
        let head = payload_preview.trim();
        let clipped: String = native typescript {
            return head.slice(0, 400);
        };
        brief = format!(
            "{}\n\nThe expert will receive payloads in EXACTLY this format (produce your sample payload in the same structure, valid JSON):\n{}",
            brief, clipped
        );
    }
    let raw = ask(String::from("mint_fixture"), MINT_SAMPLE_PROMPT.clone(), brief).await?;
    let fields: HashMap<String, String> = native typescript {
        try {
            return $host.json.fields(raw);
        } catch (e) {
            const m = new Map();
            m.set("error", String(e && e.message || e));
            return m;
        }
    };
    let payload = fields.get(String::from("payload")).unwrap_or(String::from("[]"));
    let goal = fields.get(String::from("goal")).unwrap_or(spec.goal_hint());
    let acceptance = fields.get(String::from("acceptance")).unwrap_or(spec.acceptance.clone());
    let feedback = fields.get(String::from("feedback")).unwrap_or(String::from("[]"));
    let spec_json = format!(
        "{{\"task_id\":1,\"goal\":\"{}\",\"acceptance\":\"{}\",\"payload\":{},\"feedback\":{}}}",
        goal, acceptance, payload, feedback
    );
    let sample_path = format!("factory/samples/{}.json", spec.name);
    let sample_body = spec_json.clone();
    let _ = native typescript {
        $host.fs.write(sample_path, sample_body);
        return true;
    };
    // 嵌套运行的剧本文件（机械专家：空轨道剧本即可）
    let fixture_path = format!("factory/fixtures/{}.fixture.json", spec.name);
    let _ = native typescript {
        $host.fs.write(fixture_path, JSON.stringify({ acts: [], reviews: [], tracks: {} }));
        return true;
    };
    let task_id: u32 = 1;
    // feedback 织入工单（验收样本的宽容语义随样本走，不随 forge 默认值丢失）
    let feedback_list: Vec<String> = native typescript {
        try {
            const arr = JSON.parse(feedback);
            if (Array.isArray(arr) === false) return [];
            return arr.map((f) => String(f));
        } catch (e) {
            return [];
        }
    };
    let mut spec_out = TaskSpec::forge(task_id, goal, String::from("验收样本"), acceptance, payload, 4096, 2);
    for f in feedback_list.iter() {
        spec_out = spec_out.clone().with_feedback(f.clone());
    }
    Ok(spec_out)
}

impl ExpertSpec {
    fn goal_hint(self) -> String {
        format!("acceptance rehearsal for {}", self.name)
    }
}

/// 入库登记（manifest 建档 + 注册表提交 + git 版本记录）。
fn register_expert(spec: ExpertSpec, gate: MintGate, skills: Vec<String>) -> Result<ExpertManifest, OrgError> {
    let eval_score = if gate.exam_ok { 1.0 } else { 0.0 };
    // 能力并集（v0.4.12）：分解器的 skills 与 mint_spec 的 capabilities 是两次
    // 独立的模型输出，词汇表会漂移（deepseek 实测：登记后检索 serves 失配 →
    // 「管线状态不一致」Err）。专家是为带这些 skills 的子任务铸造的，机械并集
    // 保证 serves 恒真（登记后检索的后置条件 + 未来 B 路径复用的前置条件）。
    let mut caps: Vec<String> = Vec::new();
    for c in spec.capabilities.iter() {
        if caps.contains(c.clone()) == false {
            caps.push(c.clone());
        }
    }
    for s in skills.iter() {
        if caps.contains(s.clone()) == false {
            caps.push(s.clone());
        }
    }
    let manifest = ExpertManifest::forge(
        spec.name.clone(),
        String::from("1.0.0"),
        spec.description.clone(),
        caps,
        String::from("factory"),
        eval_score,
        format!("factory/samples/{}.json", spec.name),
        format!("registry/experts/{}.hsl", spec.name),
    );
    let mut registry = Registry::load(String::from("registry"))?;
    let _ = registry.register(manifest.clone())?;
    let _ = commit_registry(format!("mint {}@1.0.0 (factory)", spec.name));
    Ok(manifest)
}

/// git 注册表提交（best-effort：git 不可用则跳过并记事件）。
fn commit_registry(message: String) -> bool {
    let msg = message.clone();
    let ok: bool = native typescript {
        const add = await $host.shell.run("git add registry/ 2>/dev/null", { timeoutMs: 15000 });
        const commit = await $host.shell.run("git commit -m '" + msg + "' 2>/dev/null", { timeoutMs: 15000 });
        return commit.ok === true;
    };
    if ok == false {
        let _ = native typescript {
            $host.events.emit("registry_commit_skipped", { message: msg });
            return true;
        };
    }
    ok
}

/// TaskSpec → JSON（current-spec.json 的写盘形态）。
/// 序列化卫生（v0.4.6，issue #6 连带）：goal/acceptance/payload/feedback 一律
/// json_escape 后按 JSON 字符串嵌入。原先 payload 裸插值 —— 纯文本负载
/// （fetch/parse 角色的 raw 材料、上游占位交付物）会直接嵌坏整个工单文件，
/// 嵌套 harness 报「工单不是合法 JSON」。字符串形态与裸 JSON 嵌入在
/// $host.json.fields 解析后的字段值同构（fields 对对象/数组本来就 JSON 化），
/// 既有 harness 的 JSON.parse(payload) 语义不变。
fn spec_to_json(spec: TaskSpec) -> String {
    let mut fb_items: Vec<String> = Vec::new();
    for f in spec.feedback.iter() {
        fb_items.push(format!("\"{}\"", json_escape(f.clone())));
    }
    let fb = fb_items.join(",");
    format!(
        "{{\"task_id\":{},\"goal\":\"{}\",\"acceptance\":\"{}\",\"payload\":\"{}\",\"feedback\":[{}]}}",
        spec.task_id, json_escape(spec.goal.clone()), json_escape(spec.acceptance.clone()),
        json_escape(spec.payload.clone()), fb
    )
}

/// 嵌套 run.json 的 ok 判定。
export fn read_run_ok(out_dir: String) -> bool {
    let path = format!("{}/run.json", out_dir);
    let ok: bool = native typescript {
        try {
            const raw = $host.fs.read(path);
            const obj = JSON.parse(raw);
            return obj.ok === true;
        } catch (e) {
            return false;
        }
    };
    ok
}

/// 嵌套 acceptance.json 的覆盖率判定（行为闸门：coverage >= 0.95）。
export fn read_acceptance_coverage(out_dir: String) -> bool {
    let d = read_acceptance_details(out_dir);
    d.0 >= 0.95
}

/// 嵌套 acceptance.json 的明细读取（金丝雀对比与评测分不回退闸门的原料）。
/// 返回 (coverage, valid, total)；文件缺失时 (0.0, 0, 0)。
export fn read_acceptance_details(out_dir: String) -> (f64, u32, u32) {
    let path = format!("{}/acceptance.json", out_dir);
    let raw: String = native typescript {
        try {
            return $host.fs.read(path);
        } catch (e) {
            return "";
        }
    };
    if raw.len() == 0 {
        return (0.0, 0, 0);
    }
    let fields: HashMap<String, String> = native typescript {
        try {
            return $host.json.fields(raw);
        } catch (e) {
            return new Map();
        }
    };
    let cov_raw = fields.get(String::from("coverage")).unwrap_or(String::from("0"));
    let valid_raw = fields.get(String::from("valid")).unwrap_or(String::from("0"));
    let total_raw = fields.get(String::from("total")).unwrap_or(String::from("0"));
    let cov: f64 = native typescript {
        const n = parseFloat(cov_raw);
        return Number.isFinite(n) ? n : 0.0;
    };
    let valid: u32 = native typescript {
        const n = parseInt(valid_raw, 10);
        return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
    };
    let total: u32 = native typescript {
        const n = parseInt(total_raw, 10);
        return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
    };
    (cov, valid, total)
}

/// 覆盖率回声（验收日志的人类可读面）。
fn coverage_note(out_dir: String) -> String {
    let path = format!("{}/acceptance.json", out_dir);
    let head: String = native typescript {
        try {
            const raw = $host.fs.read(path);
            return raw.slice(0, 200);
        } catch (e) {
            return "(acceptance.json missing)";
        }
    };
    head
}

/// 验收明细（嵌套产物的人类可读回声）。
fn verdict_detail(out_dir: String) -> String {
    let path = format!("{}/report.md", out_dir);
    let head: String = native typescript {
        try {
            const raw = $host.fs.read(path);
            return raw.slice(0, 400);
        } catch (e) {
            return "";
        }
    };
    if head.len() == 0 {
        String::from("(no acceptance report)")
    } else {
        head
    }
}

/// 补丁回滚（fs.edit 反向：把已打入的补丁行换回原始行）。
fn rollback(path: String, current: String, original: String) {
    let _ = native typescript {
        try {
            $host.fs.edit(path, current, original);
        } catch (e) {
            $host.events.emit("patch_rollback_failed", { path, message: String(e && e.message || e) });
        }
        return true;
    };
}

/// 语义版本 patch 位 bump（1.0.0 → 1.0.1）。
fn bump_patch_version(version: String) -> String {
    let parts = version.split(".");
    let segs: Vec<String> = parts.collect();
    if segs.len() == 3 {
        let major = segs[0].clone();
        let minor = segs[1].clone();
        let patch_raw = segs[2].clone();
        let patch_num = native typescript {
            const n = parseInt(patch_raw, 10);
            return Number.isFinite(n) ? n + 1 : 1;
        };
        format!("{}.{}.{}", major, minor, patch_num)
    } else {
        String::from("0.0.1")
    }
}

/// 注册表按名检索（补丁线用）。
fn find_by_name_helper(registry: Registry, name: String) -> Option<ExpertManifest> {
    registry.find_by_name(name)
}

/// 验收样本读取（补丁 smoke 的原料：factory/fixtures/<name>.json）。
fn load_sample_spec(sample_path: String) -> Option<TaskSpec> {
    let raw: String = native typescript {
        try {
            return $host.fs.read(sample_path);
        } catch (e) {
            return "";
        }
    };
    if raw.len() == 0 {
        return None;
    }
    let fields: HashMap<String, String> = native typescript {
        try {
            return $host.json.fields(raw);
        } catch (e) {
            return new Map();
        }
    };
    let goal = fields.get(String::from("goal")).unwrap_or(String::from("smoke"));
    let acceptance = fields.get(String::from("acceptance")).unwrap_or(String::from("coverage >= 0.95"));
    let payload = fields.get(String::from("payload")).unwrap_or(String::from("[]"));
    Some(TaskSpec::forge(999, goal, String::from("补丁 smoke"), acceptance, payload, 4096, 2))
}

impl Registry {
    /// 按名检索（精确匹配）。
    fn find_by_name(self, name: String) -> Option<ExpertManifest> {
        for m in self.experts.iter() {
            if m.name == name {
                return Some(m.clone());
            }
        }
        None
    }
}

/// 三段拼接（日志卫生）。
fn concat3(a: String, b: String, c: String) -> String {
    let mut out = a;
    if b.len() > 0 {
        out.push_str("\n");
        out.push_str(b.as_str());
    }
    if c.len() > 0 {
        out.push_str("\n");
        out.push_str(c.as_str());
    }
    out
}
