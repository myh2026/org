// ============================================================================
// record-validator.hsl — ORG 工厂生成物（生成响应的录制剧本 + 人工抽查样本）
// ============================================================================
// 说明：本文件是「工厂现场生成」的诚实形态——scripted 模式下它是某次真实
// 生成响应的录制（fixture 轨道 mint_hsl 的内容与本文件逐字一致）；它同时
// 作为人工抽查（human review）的存档保留在 factory/stock/。运行时工厂把它
// 写入工作区 registry/experts/ 并经 dhv check + fixture 验收后注册上岗。
//
// 信封契约（内核视角）：
//   输入：factory/current-spec.json（TaskSpec 工单：goal/acceptance/payload/feedback）
//   输出：work-out/acceptance.json（验收工件：coverage/issues/summary）
//
// 节点分类：全部机械节点（纯 HSL 校验规则，零模型调用）—— 返工重跑零成本。
// PATCH-ANCHOR 行是知识补丁的锚点（v1.0.0：unparsed 记录是否计入覆盖由
// spec.feedback 门控；复发两次的意见经补丁管线改为无条件计入）。
// ============================================================================

#[derive(Debug, Clone)]
struct Record {
    title: String,
    date: String,
    date_status: String,
    dept: String,
    category: String,
}

#[derive(Debug, Clone)]
struct Issue {
    title: String,
    reason: String,
}

export fn main() -> Result<(), String> {
    // ---- 工单读取（输入契约） ----
    let spec_json: String = native typescript {
        try {
            return $host.fs.read("factory/current-spec.json");
        } catch (e) {
            return "";
        }
    };
    if spec_json.len() == 0 {
        return Err(String::from("factory/current-spec.json 缺失（工单未落盘）"));
    }
    let fields: HashMap<String, String> = native typescript {
        try {
            const m = new Map();
            const obj = JSON.parse(spec_json);
            for (const [k, v] of Object.entries(obj)) {
                // 类型纪律：对象/数组 → JSON 串，原始值 → String
                m.set(k, v === null || v === undefined ? "" : typeof v === "object" ? JSON.stringify(v) : String(v));
            }
            return m;
        } catch (e) {
            const m = new Map();
            m.set("error", String(e && e.message || e));
            return m;
        }
    };
    if fields.contains_key(String::from("error")) {
        return Err(format!("工单不是合法 JSON：{}", fields.get(String::from("error")).unwrap_or(String::from("?"))));
    }
    let _goal = fields.get(String::from("goal")).unwrap_or(String::from("validate records"));
    let feedback_raw = fields.get(String::from("feedback")).unwrap_or(String::from("[]"));

    // PATCH-ANCHOR: unparsed-date policy (v1.0.0 — feedback-gated)
    let unparsed_ok = feedback_raw != String::from("[]");

    // ---- 记录解析（payload = JSON 数组） ----
    let payload_raw = fields.get(String::from("payload")).unwrap_or(String::from("[]"));
    let records: Vec<HashMap<String, String>> = native typescript {
        try {
            const arr = JSON.parse(payload_raw);
            if (Array.isArray(arr) === false) return [];
            return arr.map((r) => {
                const m = new Map();
                for (const [k, v] of Object.entries(r)) m.set(k, String(v));
                return m;
            });
        } catch (e) {
            return [];
        }
    };
    if records.len() == 0 {
        return Err(String::from("payload 不含任何记录（无法验收）"));
    }

    // ---- 校验规则（机械节点：零模型调用） ----
    let mut valid: u32 = 0;
    let mut issues: Vec<Issue> = Vec::new();
    let mut seen_titles: Vec<String> = Vec::new();
    for row in records.iter() {
        let title = row.get(String::from("title")).unwrap_or(String::new());
        let date_status = row.get(String::from("date_status")).unwrap_or(String::from("ok"));
        let dept = row.get(String::from("dept")).unwrap_or(String::new());
        let category = row.get(String::from("category")).unwrap_or(String::from("other"));

        let mut ok = true;
        let mut reason = String::new();

        if title.len() == 0 {
            ok = false;
            reason.push_str("title empty;");
        }
        if dept.len() == 0 {
            ok = false;
            reason.push_str("dept empty;");
        }
        if category != String::from("announcement") && category != String::from("notice")
            && category != String::from("other") {
            ok = false;
            reason.push_str("category unknown;");
        }
        if date_status == String::from("ok") {
            let date = row.get(String::from("date")).unwrap_or(String::new());
            if date.len() != 10 {
                ok = false;
                reason.push_str("date not ISO-8601;");
            }
        } else {
            if unparsed_ok == false {
                ok = false;
                reason.push_str("date_status=unparsed excluded;");
            }
        }
        if seen_titles.contains(title.clone()) {
            ok = false;
            reason.push_str("duplicate title;");
        }

        if ok {
            valid += 1;
            seen_titles.push(title);
        } else {
            issues.push(Issue { title: title, reason: reason });
        }
    }

    // ---- 覆盖率与工件（输出契约） ----
    let total = records.len();
    let coverage = valid as f64 / total as f64;
    let mut summary = format!("valid {}/{} records (coverage {:.2})", valid, total, coverage);
    if unparsed_ok {
        summary.push_str(" [feedback: unparsed tolerated]");
    }
    for i in issues.iter() {
        summary.push_str(format!("; issue[{}]: {}", i.title, i.reason).as_str());
    }
    let payload_note = if issues.len() > 0 {
        String::from("remedy: count date_status=unparsed as valid (flagged, not excluded)")
    } else {
        String::from("all rules pass")
    };

    let coverage_str = format!("{:.2}", coverage);
    let body = format!(
        "{{\"coverage\":{},\"valid\":{},\"total\":{},\"summary\":\"{}\",\"note\":\"{}\"}}",
        coverage_str, valid, total, summary, payload_note
    );
    let _ = native typescript {
        $host.artifacts.write("acceptance.json", body);
        return true;
    };
    println!("[record-validator] {}", summary);
    println!("[record-validator] {}", payload_note);
    Ok(())
}
