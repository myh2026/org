// ============================================================================
// org/config/resources.hsl — 静态资源层：工厂提示词 / 审查判据 / 运行配置
// ============================================================================
// block/static 资源块（原始文本 + {{}} 编译期插值）。知识补丁的改动对象
// 即此类静态资源（提示词 / 参考资料）—— 闸门为 check + smoke。
// ============================================================================

import { MAX_ITERATIONS, RECURRENCE_PATCH_THRESHOLD } from "../types/state.hsl";

/// 工厂第 1 步：规格提取提示词（任务 → 专家规格 JSON）。
export block MINT_SPEC_PROMPT {
You are the spec extractor of an expert factory.
Given a task goal, produce ONE JSON object:
{"name": "kebab-case-id", "description": "one-line duty", "capabilities": ["tag1","tag2"], "acceptance": "measurable acceptance rule"}
Rules:
- name is a stable identifier for the registry.
- capabilities must use known tags (fetch/parse/validate/summarize/...).
- acceptance must be mechanically checkable (coverage threshold, field rules).
Output EXACTLY ONE JSON object. No prose. No markdown fences.
}

/// 工厂第 2 步：HSL 源码生成提示词（规格 → 信封契约专家）。
/// v0.4.12 实测修复（deepseek 真实模式）：基座模型不认识 HSL —— 无语法
/// 骨架时首生成物是 Rust 风格（`use std::...` / serde_json / $host.http），
/// dhv check 正确拒绝后整个 run 直接 Err。补齐：语法铁律清单 + 经 check/run
/// 实测验证的最小完整示例（见 /tmp 探针：0 error 0 warning + acceptance.json
/// 产出正确）+ 不存在的 API 负面清单。配合 pipeline 的有界再生成（诊断
/// 反馈重试），真实模型车道首次可通过闸门。
export block MINT_SOURCE_PROMPT {
You are the HSL source generator of an expert factory.
Write ONE complete HSL file implementing this expert.

HSL is a Rust-like language. SYNTAX RULES (violations fail the dhv check gate):
- Vec / HashMap / String / Option / Result are BUILT-IN (prelude) — use them directly,
  NEVER import them. There is NO "./std/collections.hsl" file. Do not import anything
  unless you genuinely need a std module.
- Import user modules (rarely needed) like: import { Foo } from "./dir/file.hsl";
  Import std modules (rarely needed) like: import { now } from "std/time";
  (std modules: core/collections/text/math/io/json/time/random/env/iter)
- Functions: fn name(x: String) -> Result<(), String> { ... }
- The entry point MUST be: export fn main() -> Result<(), String> { ... }
- Call host APIs ONLY inside `native typescript { ... }` blocks (they are JS/TS).
- Error handling: `?` propagates Result; constructors Ok(x) / Err(String::from("...")).
- match on Option/Result must be exhaustive: match opt { Option::Some(v) => ..., Option::None => ... }
- Types are String/Vec<T>/HashMap<K,V>/Option<T>/Result<T,E>/u32/i64/f64/bool.
- NOT available anywhere: `use`, serde_json, reqwest, std::fs, $host.http — none exist.
- Inside native typescript blocks ONLY these exist:
  $host.fs.read/write/edit/list, $host.json.parse/stringify/fields,
  $host.artifacts.write, $host.events.emit, $host.config, $host.log.
- Safe String/Vec/HashMap methods: len trim split split_once lines contains
  starts_with ends_with strip_prefix find char_at replace to_string push_str;
  Vec: push len iter iter_mut map filter contains join first last;
  HashMap: insert get contains_key.

Envelope contract:
- main() reads the task spec from "factory/current-spec.json", executes, returns Result<(), String>.
- NO network access: never call fetch/HTTP/axios — all input material arrives inside the
  spec's payload field. Process the payload content only.
- Mechanical validation/transform logic stays in pure HSL (no LLM calls unless the
  spec demands judgment; if so use $host.fixture tracks named "<node>").
- Write your verdict artifact with $host.artifacts.write("acceptance.json", ...) —
  JSON string with fields: coverage (0..1 number), summary, note, and optionally
  deliverable (the output artifact JSON string).
- Print a one-line summary with println!.

COMPLETE MINIMAL EXAMPLE (verified to pass dhv check and run):
fn run(goal: String, payload: String) -> Result<String, String> {
    let items: Vec<String> = payload.split("\n").map(|l| l.trim().to_string()).filter(|l| l.len() > 0);
    let total: u32 = items.len() as u32;
    let mut valid: u32 = 0;
    for item in items.iter() {
        if item.contains(":") { valid = valid + 1; }
    }
    let coverage: f64 = if total > 0 { (valid as f64) / (total as f64) } else { 0.0 };
    let summary = format!("validated {} of {}", valid, total);
    let _ = native typescript {
        $host.artifacts.write("acceptance.json", JSON.stringify({ coverage: coverage, summary: summary, note: "", deliverable: "[]" }));
        return true;
    };
    println!("[expert] {}", summary);
    Ok(summary)
}

export fn main() -> Result<(), String> {
    let payload: String = native typescript {
        const raw = await $host.fs.read("factory/current-spec.json");
        const spec = JSON.parse(raw);
        return String(spec.payload ?? "");
    };
    match run(String::from("validate"), payload) {
        Ok(_) => Ok(()),
        Err(e) => Err(e),
    }
}

Adapt the example's validation logic to this expert's goal and acceptance rule.
Output ONLY the HSL source code. No markdown fences. No commentary.
}

/// 工厂第 4 步：验收样本反推提示词（规格 → 样本工单 JSON）。
export block MINT_SAMPLE_PROMPT {
You are the acceptance fixture generator of an expert factory.
Given the expert acceptance rule, produce ONE JSON object:
{"goal": "sample goal", "acceptance": "<the rule>", "payload": <sample input JSON>, "feedback": []}
The sample must be representative and pass the acceptance rule.
- "payload" MUST be valid JSON (double quotes only, no single-quoted pseudo-JSON).
- If a payload format example is provided in the input, mirror its EXACT structure
  (field names, nesting, types) — the expert is built to parse that format.
Output EXACTLY ONE JSON object. No prose. No markdown fences.
}

/// 监督审查判据（四态裁决的提示词面）。
export block REVIEW_RUBRIC {
You are the supervision gate of an organization harness.
Compare the worker StatusReport against the contract acceptance rule.
Verdict vocabulary (EXACTLY ONE JSON object, no prose):
{"verdict": "accept"}
{"verdict": "revise", "note": "<precise, minimal instruction>"}
{"verdict": "reject", "reason": "<fatal contract mismatch>"}
{"verdict": "escalate", "question": "<what only the user can decide>"}
Rules:
- accept only if coverage meets the bar and no blocking notes.
- revise notes must be actionable and minimal (they recur -> patch proposal).
}

/// 任务分解提示词（监督回路第 ① 阶段）。
export block DECOMPOSE_PROMPT {
You are the task decomposer of an organization harness.
Given a mission, produce ONE JSON array of subtasks:
[{"id":1,"goal":"...","role":"fetch|parse|validate|summarize|...","skills":["tag"],"depends_on":[],"priority":1,"input":"mission"}]
Rules:
- 2-4 subtasks; ids unique; depends_on forms a DAG (no cycles).
- skills use known capability tags (fetch/parse/validate/summarize).
- skills are for REUSABLE process value only. A subtask that merely reads
  workspace-local material (input files already on disk) has NO reusable
  process — give it skills: [] so it runs inline. Do NOT create subtasks
  that require live network fetching; input material is already local.
- "input" routes the subtask's input material (v0.4.13): "mission" when the
  data to process is INLINE in the mission text itself (the user typed/pasted
  the actual content, e.g. feedback text to analyze); "workspace" when the
  mission asks to process files/material that exist in the workspace (e.g.
  "解析工作区公告文件" — the material is on disk, NOT in the mission text).
  Choose by where the actual data lives, not by convenience.
Output EXACTLY ONE JSON array. No prose. No markdown fences.
}

/// 澄清提示词（批量打包，只问阻塞关键路径的问题）。
export block CLARIFY_PROMPT {
You are the clarification gate of an organization harness.
Given a mission, list only questions that BLOCK the critical path
(output format, field preferences, scope boundaries).
Output ONE JSON array of short questions. No prose. No markdown fences.
}

/// 补丁提案提示词（内核提议权：审查意见复发两次 → 修改专家本体）。
export block PATCH_PROPOSAL_PROMPT {
You are the patch proposer of an organization harness (proposal only —
the merge key belongs to the acceptance pipeline, not you).
Given a recurring review note about an expert, propose a minimal knowledge patch:
{"old_text": "<exact existing source line>", "new_text": "<replacement line>"}
Rules:
- old_text must appear EXACTLY ONCE in the expert source.
- new_text must preserve envelope conformance.
Output EXACTLY ONE JSON object. No prose. No markdown fences.
}

/// 用户仲裁提示词（Escalate 通道：只有用户能决定的问题，回填裁决）。
export block ARBITRATE_PROMPT {
You are the user-arbitration relay of an organization harness.
The supervisor escalated a question that only the user can decide.
Given the question, produce the user's arbitration as ONE JSON object:
{"verdict": "accept"}
{"verdict": "revise", "note": "<what to change>"}
{"verdict": "reject", "reason": "<why>"}
Output EXACTLY ONE JSON object. No prose. No markdown fences.
}

/// 运行配置（YAML 投射目标；{{}} 编译期插值）。
export block ORG_CONFIG {
org:
  name: org
  version: 0.3.0
  scale: microkernel
  kernel: org.hsl            # 主控：唯一手写、唯一不经工厂管线的组件
supervision:
  max_iterations: {{MAX_ITERATIONS}}
  recurrence_patch_threshold: {{RECURRENCE_PATCH_THRESHOLD}}
  coverage_bar: 0.95
factory:
  gates: [dhv-check, fixture-exam, smoke]
  patch_gates: {knowledge: "check+smoke", flow: "full-fixture+no-regress", capability: "audit-user-only"}
pool:
  concurrency_cap: 4
  tier: light                # 轻档：manifest + 任务历史索引（候选态支持影子晋升）
promotion:
  shadow_compare: true       # 补丁版本合入后：新旧源同输入双跑，产出只计分不交付
  canary: confirm-or-rollback
  redundancy: 1              # ORG_REDUNDANCY 环境变量可调（>=2 启用 N 版本冗余）
scorecard:
  drift_threshold: 0.25      # 静默更新检测：格级劣化告警阈值
  baseline: registry/scorecards/baseline-<model>.json
crystallize:
  freeze_after: 2
  auto_degrade: {min_observations: 4, hit_rate_bar: 0.4}
}

/// 事件总线 schema（JSON 投射目标）。
export static EVENTS_SCHEMA {
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "org events",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["seq", "ts", "name"],
    "properties": {
      "seq": { "type": "integer" },
      "ts": { "type": "string" },
      "name": { "type": "string", "enum": [
        "run_start", "run_end", "journal", "capability_granted", "capability_denied",
        "crystallize_hit", "crystallize_frozen", "crystallize_degrade",
        "score_evidence", "registry_commit_skipped", "fault_injected", "run_panic",
        "shadow_compare", "canary_confirmed", "canary_rollback",
        "redundancy_compare", "score_drift_alert", "fixtures_mined",
        "audit", "patch_rollback_failed"
      ] },
      "data": { "type": "object" }
    }
  }
}
}
