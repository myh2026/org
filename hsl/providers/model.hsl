// ============================================================================
// org/providers/model.hsl — 模型网关：scripted（剧本）/ 真实 LLM（任意车道）
// ============================================================================
// ORG 的所有判定调用（分解 / 澄清 / 生成 / 审查 / 直连）经同一网关：
//   - scripted 模式：确定性剧本轨道（fixture.next(track)），CI 可复现零外联
//   - 真实 LLM 车道：deepseek / openai / anthropic / gemini / openrouter /
//     groq / mistral / xai / zhipu / qwen / moonshot / siliconflow / ollama …
//     （v0.5.1：车道名不再硬编码 —— 任意非 scripted 值都走 $host.llm 网关，
//     服务商/端点/key 由宿主配置面 org config 统一解析；实测车道归因在
//     model_id 维度上保留）
// 轨道名即观测面：transcript 里每个判定调用可追溯到一个轨道 / 一次真实调用。
// N1 纪律：prompt 组装在 HSL 侧；native 只做调用与平凡类型捕获。
// ============================================================================

import { ExpertError } from "../types/errors.hsl";

/// 判定调用：轨道名 + 系统提示 + 用户输入 → 模型原始输出。
///
/// 轨道名约定（剧本 JSON 的 tracks 键）：
///   decompose / clarify / answers / mint_spec / mint_hsl / mint_fixture
///   review:<role> / direct:<expert> / <expert>:<node>
export async fn ask(track: String, system: String, user: String) -> Result<String, ExpertError> {
    // 单轮 = 恰好一条用户消息的多轮（v0.5.3 统一实现，语义零变化）。
    let turns = format!("[{{\"role\":\"user\",\"content\":\"{}\"}}]", json_str(user));
    ask_conv(track, system, turns).await
}

/// 多轮判定调用（v0.5.3 agent 工具环）：turns_json = JSON 数组
/// [{"role":"user"|"assistant","content":"..."}]，与 system 组装成完整
/// messages —— 工具环把工具结果作为后续 user 消息回灌，模型带完整上文。
/// 轨道消耗与 ask 同规（scripted 逐条消费同轨道剧本）。
export async fn ask_conv(track: String, system: String, turns_json: String) -> Result<String, ExpertError> {
    // v0.5.1：真实车道由宿主信号 ORG_LANE_KIND 决定（org 宿主侧
    // lib/providers.ts 解析车道名/模型 id/配置后显式声明）。信号缺席时的
    // 兼容语义：不经 org 宿主直接 `dhv run --model deepseek`（网关三件套
    // 老形态）仍走真实车道 —— 未知模型名则按剧本执行（web 回落链测试锁定
    // 的行为）。这让 org config 的全部 20+ 服务商预设（openai / anthropic /
    // gemini / groq / zhipu / qwen / …）零改动接入真实车道。
    let lane_kind: String = native typescript {
        const kind = String($host.env.get("ORG_LANE_KIND") || "").trim();
        if (kind === "real" || kind === "scripted") return kind;
        return $host.config.model === "deepseek" ? "real" : "scripted";
    };
    if lane_kind == String::from("real") {
        let raw: String = native typescript {
            // v0.4.12：429/网络瞬断的有界退避重试（1s → 3s，共 3 次）—— 限流是
            // 真实模型车道的常态（实测 z-ai 网关 429），裸错误此前直接炸穿整次
            // run。重试仍失败则抛出（错误信息原样保留可诊断）。
            // v0.4.13：maxTokens 2048 → 8192 —— 推理型模型（deepseek-flash 等）
            // 的 reasoning 计入同一 max_tokens 预算；实测工厂 mint 调用 reasoning
            // 吃满 2048（finish_reason=length、content 空），三连「empty
            // completion」炸穿 run。8192 给 reasoning + 正文留足余量（DeepSeek
            // 实测接受；仍截断时工具层错误带 finish_reason 可诊断）。
            // 退避升级：finish_reason=length（推理失控吃满预算）时，下一次重试
            // 关思考（thinking off）直接产出 —— 与工厂 check 闸门「诊断反馈
            // 重试」同构的有界自适应，而非无限加预算（实测 reasoning 可膨胀到
            // 32k 字符仍零正文，加预算是烧钱不是修复）。
            // mint 轨道默认关思考（v0.4.13）：推理型模型在代码生成上推理失控
            // 是常态（每次 ~45s 烧预算税），而 check + Exam 双闸门保证 mint
            // 质量 —— 闸门优先于信任，思考的边际收益低于失控成本（实测
            // thinking-off 的 mint 生成物 4-5k 字符稳定过 check）。显式
            // DHV_LLM_THINKING 配置优先（用户要思考就给思考）。
            const envThinking = String(process.env.DHV_LLM_THINKING || "").trim();
            const mintTrack = String(track).indexOf("mint_") === 0;
            const thinkOff = envThinking === "" && mintTrack;
            let turns = [];
            try { turns = JSON.parse(turns_json); } catch (e) { turns = []; }
            if (!Array.isArray(turns) || turns.length === 0) {
                turns = [{ role: "user", content: "" }];
            }
            const call = (escalated) => $host.llm.complete({
                messages: [
                    { role: "system", content: system },
                    ...turns,
                ],
                temperature: 0.1,
                maxTokens: 8192,
                // v0.4.15：流式 + 轨道归因（仅网关车道生效）—— 增量落盘
                // llm-stream.jsonl，观测面（chat REPL / Web SSE / TUI）逐
                // token 渲染；返回值仍为完整正文，HSL 语义零变化。
                stream: true,
                track: String(track),
                ...((thinkOff || escalated) ? { thinking: "off" } : {}),
            });
            let lastErr = null;
            let budgetBurned = false;
            for (let i = 0; i < 3; i++) {
                try {
                    const r = await call(budgetBurned);
                    if (r !== undefined && r !== null && String(r).length > 0) return String(r);
                    lastErr = new Error("empty completion");
                } catch (e) {
                    lastErr = e;
                    if (String((e && e.message) || e).indexOf("finish_reason=length") >= 0) budgetBurned = true;
                }
                if (i < 2) await new Promise((res) => setTimeout(res, 1000 * (i + 1)));
            }
            throw lastErr;
        };
        if raw.len() == 0 {
            Err(ExpertError::new(
                String::from("model-gateway"),
                String::from("provider"),
                String::from("empty completion"),
            ))
        } else {
            Ok(raw)
        }
    } else {
        let raw: String = native typescript {
            try {
                return await $host.fixture.next(track);
            } catch (e) {
                return "FIXTURE_EXHAUSTED::" + track + "::" + String(e && e.message || e);
            }
        };
        if raw.len() == 0 {
            Err(ExpertError::new(
                String::from("model-gateway"),
                String::from("fixture"),
                format!("剧本轨道 {} 耗尽（scripted 模式需要与调用次数匹配的剧本）", track),
            ))
        } else {
            if raw.contains("FIXTURE_EXHAUSTED::") {
                Err(ExpertError::new(
                    String::from("model-gateway"),
                    String::from("fixture"),
                    raw,
                ))
            } else {
                Ok(raw)
            }
        }
    }
}

/// JSON 字符串转义（双引号/反斜杠/控制符 —— turns 组装用；与
/// registry/manifest.hsl json_escape 同构，本地实现避免循环 import）。
fn json_str(s: String) -> String {
    let out: String = native typescript {
        return JSON.stringify(String(s));
    };
    out
}

/// 轨道余量（判定节点的可观测预算面）。
export fn track_left(track: String) -> u32 {
    let left: u32 = native typescript {
        return $host.fixture ? $host.fixture.left(track) : 0;
    };
    left
}

/// 当前模式名（报告与评分卡的 model_id 维度）。
export fn model_id() -> String {
    let name: String = native typescript {
        return $host.config.model || "scripted";
    };
    name
}
